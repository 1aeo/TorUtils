+/** Worker thread main loop for servicing MetricsPort connections. */
+static void
+metrics_worker_threadfn(void *arg)
+{
+  (void) arg;
+  tor_socket_t sock = 0;
+  tor_mutex_acquire(metrics_mutex);
+  for (;;) {
+    struct pollfd lpfd = { .fd = the_listener_sock, .events = POLLIN };
+    nfds_t nfds = SOCKET_OK(lpfd.fd) && SOCKET_OK(sock) ? 1 : 0;
+    sock = 0;
+    tor_mutex_release(metrics_mutex);
+    int ready = poll(&lpfd, nfds, 100);
+    tor_mutex_acquire(metrics_mutex);
+    if (ready <= 0 || !(lpfd.revents & POLLIN) ||
+        lpfd.fd != the_listener_sock ||
+        tor_event_loop_shutdown_is_pending()) {
+      continue;
+    }
+    struct sockaddr_storage sa = {0};
+    socklen_t salen = sizeof(sa);
+    tor_release_socket_ownership(the_listener_sock);
+    sock = tor_accept_socket_nonblocking(
+        the_listener_sock, (struct sockaddr *)&sa, &salen);
+    tor_take_socket_ownership(the_listener_sock);
+    if (!SOCKET_OK(sock))
+      continue;
+
+    connection_t conn = {
+      .magic = BASE_CONNECTION_MAGIC,
+      .type = CONN_TYPE_METRICS,
+      .inbuf = buf_new(),
+      .outbuf = buf_new(),
+    };
+    bool ok = !tor_addr_from_sockaddr(&conn.addr, (struct sockaddr *)&sa,
+                                      NULL) &&
+              metrics_request_allowed(&conn.addr);
+    struct pollfd pfd = { .fd = sock, .events = POLLIN };
+    for (int tries = 0; ok && tries < 32; ++tries) {
+      tor_mutex_release(metrics_mutex);
+      int pr = poll(&pfd, 1, 100);
+      tor_mutex_acquire(metrics_mutex);
+      int eof = 0, err = 0;
+      if (!SOCKET_OK(the_listener_sock) ||
+          tor_event_loop_shutdown_is_pending()) {
+        break;
+      } else if (pr == 0 || (pr < 0 && errno == EINTR)) {
+        continue;
+      } else if (pr < 0 || !(pfd.revents & pfd.events)) {
+        break;
+      } else if (pfd.events == POLLIN &&
+                 (buf_read_from_socket(conn.inbuf, sock, 2048,
+                                       &eof, &err) < 0 ||
+                  metrics_connection_process_inbuf(&conn) < 0 ||
+                  buf_datalen(conn.outbuf) > 0 || eof)) {
+        pfd.events = POLLOUT;
+      }
+      if (pfd.events == POLLOUT) {
+        int r = buf_datalen(conn.outbuf) ?
+          buf_flush_to_socket(conn.outbuf, sock, buf_datalen(conn.outbuf)) : 0;
+        if (r < 0 || !buf_datalen(conn.outbuf))
+          break;
+        if (r >= 1024)
+          --tries;
+      }
+    }
+    buf_free(conn.inbuf);
+    buf_free(conn.outbuf);
+    tor_close_socket(sock);
+  }
+}
+
+/** Configure <b>conn</b> to be handled by the MetricsPort worker thread. */
+void
+metrics_configure_listener(connection_t *conn)
+{
+  tor_assert(conn);
+  bool start = !metrics_mutex;
+  if (start)
+    metrics_mutex = tor_mutex_new_nonrecursive();
+  tor_mutex_acquire(metrics_mutex);
+  the_listener_sock = conn->s;
+  tor_mutex_release(metrics_mutex);
+  if (start && spawn_func(metrics_worker_threadfn, NULL) < 0) {
+    tor_mutex_free(metrics_mutex);
+    connection_start_reading(conn);
+  }
+}
+
+/** Stop servicing <b>conn</b> on the MetricsPort worker thread. */
+void
+metrics_close_listener(const connection_t *conn)
+{
+  if (!metrics_mutex || (conn && conn->type != CONN_TYPE_METRICS_LISTENER))
+    return;
+  tor_mutex_acquire(metrics_mutex);
+  if (!conn || the_listener_sock == conn->s)
+    the_listener_sock = TOR_INVALID_SOCKET;
+  tor_mutex_release(metrics_mutex);
+}
+
 /** Parse metrics ports from options. On success, add the port to the ports
  * list and return 0. On failure, set err_msg_out to a newly allocated string
  * describing the problem and return -1. */
@@ -277,4 +391,5 @@ metrics_init(void)
 void
 metrics_cleanup(void)
 {
+  metrics_close_listener(NULL);
 }
