From 75be17e5ca5f09119fbd6e4bf29d6e878e9a853b Mon Sep 17 00:00:00 2001
From: 1aeo <github@1aeo.com>
Date: Tue, 20 Oct 2026 22:40:27 -0700
Subject: [PATCH 1/3] metrics: Reject MetricsPort connections when
 metrics_policy is NULL

compare_tor_addr_to_addr_policy() returns ADDR_POLICY_ACCEPTED (1) when
the policy smartlist is NULL. Because MetricsPortPolicy is default-deny
(reject *:*), metrics_policy_permits_address() must return 0 when
metrics_policy has not yet been initialized by policies_parse_from_options()
or after policies_free_all().
---
 changes/bug_metrics_policy_null | 4 ++++
 src/core/or/policies.c          | 3 ++-
 src/test/test_metrics.c         | 4 ++++
 3 files changed, 10 insertions(+), 1 deletion(-)
 create mode 100644 changes/bug_metrics_policy_null

diff --git a/changes/bug_metrics_policy_null b/changes/bug_metrics_policy_null
new file mode 100644
index 0000000..5cbb06b
--- /dev/null
+++ b/changes/bug_metrics_policy_null
@@ -0,0 +1,4 @@
+  o Minor bugfixes (metrics, security):
+    - Reject MetricsPort connections when MetricsPortPolicy has not yet been
+      parsed or has been freed, instead of defaulting to accepting all
+      addresses. Fixes bug 40063; bugfix on 0.4.5.1-alpha.
diff --git a/src/core/or/policies.c b/src/core/or/policies.c
index 375568d..244119d 100644
--- a/src/core/or/policies.c
+++ b/src/core/or/policies.c
@@ -1071,7 +1071,8 @@ socks_policy_permits_address(const tor_addr_t *addr)
 int
 metrics_policy_permits_address(const tor_addr_t *addr)
 {
-  return addr_policy_permits_tor_addr(addr, 1, metrics_policy);
+  return metrics_policy ? addr_policy_permits_tor_addr(addr, 1, metrics_policy)
+                        : 0;
 }
 
 /** Return true iff the address <b>addr</b> is in a country listed in the
diff --git a/src/test/test_metrics.c b/src/test/test_metrics.c
index 0bf072d..deabd65 100644
--- a/src/test/test_metrics.c
+++ b/src/test/test_metrics.c
@@ -61,6 +61,10 @@ test_config(void *arg)
 
   (void) arg;
 
+  /* Default-deny when no MetricsPortPolicy has been parsed yet. */
+  tor_addr_from_ipv4h(&addr, 0x01020304); /* 1.2.3.4 */
+  tt_int_op(metrics_policy_permits_address(&addr), OP_EQ, false);
+
   set_metrics_port(options);
 
   int ret = metrics_parse_ports(options, ports, &err_msg);
-- 
