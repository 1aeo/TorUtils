From e0dbe1f994116da4a64977709d1a25be9f5fac8f Mon Sep 17 00:00:00 2001
From: 1aeo <github@1aeo.com>
Date: Wed, 21 Oct 2026 06:12:15 +0000
Subject: [PATCH 1/4] policies: Make metrics_policy_permits_address()
 thread-safe

A following commit checks MetricsPortPolicy from a MetricsPort worker
thread, while the main thread may rebuild metrics_policy on SIGHUP or
SETCONF. load_policy_from_option() frees the old list and sets it to
NULL before parsing the new one, so an unlocked reader could walk freed
memory, or see a NULL policy, which compare_tor_addr_to_addr_policy()
treats as "accept".

Guard metrics_policy with a mutex that is created on first use, like
socket_accounting_lock() in lib/net/socket.c, and return 0 when no
policy has been parsed. Always append the trailing "reject *:*", even
when parsing fails, so that the policy fails closed.

policies_free_all() is left unlocked: it runs from the "or" subsystem
shutdown, after the metrics subsystem has stopped the worker from
accepting connections.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_018ZfqW8PgStnaE5cg75wM9u
---
 src/core/or/policies.c  | 28 ++++++++++++++++++++++------
 src/test/test_metrics.c |  4 ++++
 2 files changed, 26 insertions(+), 6 deletions(-)

diff --git a/src/core/or/policies.c b/src/core/or/policies.c
index 375568d..950235d 100644
--- a/src/core/or/policies.c
+++ b/src/core/or/policies.c
@@ -50,6 +50,9 @@ static smartlist_t *socks_policy = NULL;
 static smartlist_t *dir_policy = NULL;
 /** Policy for incoming MetricsPort connections that must match. */
 static smartlist_t *metrics_policy = NULL;
+/** Mutex protecting metrics_policy, which the MetricsPort worker thread also
+ * reads. Created on first use, which is on the main thread. */
+static tor_mutex_t *metrics_policy_mutex = NULL;
 /** Policy that addresses for incoming router descriptors must match in order
  * to be published by us. */
 static smartlist_t *authdir_reject_policy = NULL;
@@ -1065,13 +1068,26 @@ socks_policy_permits_address(const tor_addr_t *addr)
   return addr_policy_permits_tor_addr(addr, 1, socks_policy);
 }
 
+/** Helper: acquire the metrics_policy lock. */
+static void
+metrics_policy_lock(void)
+{
+  if (PREDICT_UNLIKELY(!metrics_policy_mutex))
+    metrics_policy_mutex = tor_mutex_new_nonrecursive();
+  tor_mutex_acquire(metrics_policy_mutex);
+}
+
 /** Return 1 if <b>addr</b> is permitted to connect to our metrics port,
  * based on <b>metrics_policy</b>. Else return 0.
  */
 int
 metrics_policy_permits_address(const tor_addr_t *addr)
 {
-  return addr_policy_permits_tor_addr(addr, 1, metrics_policy);
+  metrics_policy_lock();
+  int r = metrics_policy &&
+          addr_policy_permits_tor_addr(addr, 1, metrics_policy);
+  tor_mutex_release(metrics_policy_mutex);
+  return r;
 }
 
 /** Return true iff the address <b>addr</b> is in a country listed in the
@@ -1253,13 +1269,13 @@ load_policy_from_option(config_line_t *config, const char *option_name,
 static int
 parse_metrics_port_policy(const or_options_t *options)
 {
-  if (load_policy_from_option(options->MetricsPortPolicy, "MetricsPortPolicy",
-                              &metrics_policy, -1) < 0) {
-    return -1;
-  }
+  metrics_policy_lock();
+  int r = load_policy_from_option(options->MetricsPortPolicy,
+                                  "MetricsPortPolicy", &metrics_policy, -1);
   /* It is a reject all by default. */
   append_exit_policy_string(&metrics_policy, "reject *:*");
-  return 0;
+  tor_mutex_release(metrics_policy_mutex);
+  return r;
 }
 
 /** Set all policies based on <b>options</b>, which should have been validated
diff --git a/src/test/test_metrics.c b/src/test/test_metrics.c
index 0bf072d..0e79e32 100644
--- a/src/test/test_metrics.c
+++ b/src/test/test_metrics.c
@@ -61,6 +61,10 @@ test_config(void *arg)
 
   (void) arg;
 
+  /* Without a parsed MetricsPortPolicy, nothing is permitted. */
+  tor_addr_from_ipv4h(&addr, 0x01020304); /* 1.2.3.4 */
+  tt_int_op(metrics_policy_permits_address(&addr), OP_EQ, false);
+
   set_metrics_port(options);
 
   int ret = metrics_parse_ports(options, ports, &err_msg);
