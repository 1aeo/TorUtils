+
 /** Metrics format driver set by the MetricsPort option. */
 static metrics_format_t the_format = METRICS_FORMAT_PROMETHEUS;
 
@@ -173,6 +181,199 @@ metrics_connection_process_inbuf(connection_t *conn)
   return ret;
 }
 
+#ifndef _WIN32
+/** Seconds that a client of the worker thread has to send its request and
+ * read the response. */
+#define METRICS_WORKER_TIMEOUT 10
+
+/** Protects the worker_* variables, which the main thread and the MetricsPort
+ * worker thread share. Created with the first listener and never freed. */
+static tor_mutex_t *worker_mutex = NULL;
+/** Listener that the worker thread serves, or TOR_INVALID_SOCKET. */
+static tor_socket_t worker_listener = TOR_INVALID_SOCKET;
+/** Latest metrics_get_http_response() output for the worker thread, and its
+ * length. */
+static char *worker_response = NULL;
+static size_t worker_response_len = 0;
+/** True while the worker thread runs. */
+static bool worker_running = false;
+/** Main thread timer refreshing worker_response while we have a listener. */
+static periodic_timer_t *worker_timer = NULL;
+
+/** Worker thread helper: wait up to a second for <b>events</b> on <b>s</b>
+ * with worker_mutex released, and return what poll() returned. */
+static int
+worker_wait(tor_socket_t s, short events)
+{
+  struct pollfd pfd = { .fd = s, .events = events };
+  tor_mutex_release(worker_mutex);
+  const int r = poll(&pfd, 1, 1000);
+  tor_mutex_acquire(worker_mutex);
+  return r;
+}
+
+/** Worker thread helper: accept a client on <b>listener</b> and answer it
+ * from worker_response. Called with worker_mutex held. */
+static void
+metrics_worker_serve(tor_socket_t listener)
+{
+  struct sockaddr_storage ss;
+  socklen_t ss_len = sizeof(ss);
+  tor_addr_t addr;
+  char req[1024], *out = NULL;
+  size_t len = 0, out_len = 0;
+  ssize_t n;
+  const time_t deadline = time(NULL) + METRICS_WORKER_TIMEOUT;
+
+  /* Ignore max_sockets: we hold one client at a time, and running out of
+   * sockets is one of the things operators scrape us to see. */
+  const tor_socket_t s = tor_accept_socket_nonblocking_unlimited(listener,
+                                         (struct sockaddr *) &ss, &ss_len);
+  if (!SOCKET_OK(s)) {
+    /* Don't spin while the listener stays readable, as when out of fds:
+     * poll() ignores a negative fd, so this just sleeps. */
+    worker_wait(TOR_INVALID_SOCKET, 0);
+    return;
+  }
+  if (tor_addr_from_sockaddr(&addr, (struct sockaddr *) &ss, NULL) < 0 ||
+      !metrics_request_allowed(&addr)) {
+    goto done;
+  }
+
+  /* Read the headers, up to 1024 bytes as on the main thread. */
+  while (!tor_memstr(req, len, "\r\n\r\n")) {
+    if (len == sizeof(req) - 1 || time(NULL) >= deadline) {
+      goto done;
+    }
+    if (worker_wait(s, POLLIN) <= 0) {
+      continue;
+    }
+    if ((n = tor_socket_recv(s, req + len, sizeof(req) - 1 - len, 0)) <= 0) {
+      goto done;
+    }
+    len += n;
+  }
+  req[len] = '\0';
+
+  const char *errmsg = metrics_check_http_request(req);
+  if (!errmsg && !worker_response) {
+    goto done;
+  }
+  out_len = errmsg ? strlen(errmsg) : worker_response_len;
+  out = tor_memdup(errmsg ? errmsg : worker_response, out_len);
+  for (len = 0; len < out_len && time(NULL) < deadline; ) {
+    if (worker_wait(s, POLLOUT) <= 0) {
+      continue;
+    }
+    if ((n = tor_socket_send(s, out + len, out_len - len, 0)) < 0) {
+      break;
+    }
+    len += n;
+  }
+
+ done:
+  tor_free(out);
+  tor_close_socket(s);
+}
+
+/** Worker thread: serve clients one at a time while we have a listener. */
+static void
+metrics_worker_main(void *arg)
+{
+  (void) arg;
+  tor_mutex_acquire(worker_mutex);
+  while (SOCKET_OK(worker_listener)) {
+    const tor_socket_t listener = worker_listener;
+    if (worker_wait(listener, POLLIN) > 0 && listener == worker_listener) {
+      metrics_worker_serve(listener);
+    }
+  }
+  worker_running = false;
+  tor_mutex_release(worker_mutex);
+}
+
+/** Main thread timer callback: refresh worker_response, and start the worker
+ * thread if needed. Starting it here, in the main loop, rather than when the
+ * listener is opened in tor_init(), puts it under the Sandbox filter. */
+STATIC void
+metrics_worker_refresh(periodic_timer_t *timer, void *arg)
+{
+  buf_t *buf = metrics_get_http_response();
+  size_t len;
+  char *response = buf_extract(buf, &len);
+
+  (void) timer;
+  (void) arg;
+  buf_free(buf);
+  tor_mutex_acquire(worker_mutex);
+  tor_free(worker_response);
+  worker_response = response;
+  worker_response_len = len;
+  if (!worker_running) {
+    worker_running = spawn_func(metrics_worker_main, NULL) == 0;
+    if (!worker_running) {
+      log_warn(LD_BUG, "Unable to start the MetricsPort worker thread.");
+    }
+  }
+  tor_mutex_release(worker_mutex);
+}
+#endif /* !defined(_WIN32) */
+
+/** Serve the MetricsPort listener <b>conn</b> from a worker thread, so that
+ * scrapes are answered even when the main loop is too busy to. */
+void
+metrics_configure_listener(connection_t *conn)
+{
+#ifdef _WIN32
+  /* No poll(): keep serving it from the main loop. */
+  connection_start_reading(conn);
+#else
+  static const struct timeval one_second = { 1, 0 };
+
+  if (!worker_mutex) {
+    worker_mutex = tor_mutex_new_nonrecursive();
+  }
+  tor_mutex_acquire(worker_mutex);
+  worker_listener = conn->s;
+  tor_mutex_release(worker_mutex);
+  if (!worker_timer) {
+    worker_timer = periodic_timer_new(tor_libevent_get_base(), &one_second,
+                                      metrics_worker_refresh, NULL);
+  }
+#endif /* defined(_WIN32) */
+}
+
+/** Called before closing the socket of <b>conn</b>: if the worker thread
+ * serves it, stop. If <b>conn</b> is NULL, stop serving any listener, and
+ * free worker_response. */
+void
+metrics_close_listener(const connection_t *conn)
+{
+#ifndef _WIN32
+  if (!worker_mutex || (conn && conn->type != CONN_TYPE_METRICS_LISTENER)) {
+    return;
+  }
+  tor_mutex_acquire(worker_mutex);
+  const tor_socket_t s = conn ? conn->s : worker_listener;
+  /* On Linux, a listener stays bound after we close it while the worker is
+   * still polling it, even if it was just replaced, and then rebinding its
+   * port fails: shutdown() unbinds it and wakes the worker up. */
+  if (SOCKET_OK(s)) {
+    shutdown(s, SHUT_RD);
+  }
+  if (s == worker_listener) {
+    worker_listener = TOR_INVALID_SOCKET;
+    periodic_timer_free(worker_timer);
+  }
+  if (!conn) {
+    tor_free(worker_response);
+  }
+  tor_mutex_release(worker_mutex);
+#else
+  (void) conn;
+#endif /* !defined(_WIN32) */
+}
+
 /** Parse metrics ports from options. On success, add the port to the ports
  * list and return 0. On failure, set err_msg_out to a newly allocated string
  * describing the problem and return -1. */
@@ -282,4 +483,6 @@ metrics_init(void)
 void
 metrics_cleanup(void)
 {
+  /* The worker thread, if any, exits within a second. */
+  metrics_close_listener(NULL);
 }
