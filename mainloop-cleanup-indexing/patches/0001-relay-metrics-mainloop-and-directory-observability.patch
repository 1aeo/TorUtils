From 1fb935ec13f35733d7670e74d1b1391113db079c Mon Sep 17 00:00:00 2001
From: joey <joey@Mac-Studio.local>
Date: Wed, 28 Oct 2026 22:11:41 -0700
Subject: [PATCH] relay_metrics: Add mainloop cleanup, tick stall, and
 BEGIN_DIR metrics

Expose nine fixed-cardinality MetricsPort series (112 series total) with
O(1) hot-path updates and no high-cardinality identifiers:

  - tor_relay_mainloop_connection_list_size
  - tor_relay_mainloop_connection_list_ops_total
  - tor_relay_mainloop_close_pass_total
  - tor_relay_mainloop_ticks_total
  - tor_relay_mainloop_tick_max_duration_usec
  - tor_relay_dir_streams_total
  - tor_relay_dir_streams_active
  - tor_relay_dir_http_requests_total
  - tor_relay_dir_bytes_total

Include --disable-module-relay stubs in relay_stub.c, changes/ entry, and
unit tests covering multi-stream circuit reuse, tor-0.4.9.15 per-circuit
HSDir request rejection and closing-circuit suppression, dying-peer flush
guards, slow-client hold_open_until_flushed completion, and stream phase
conservation.
---
 changes/mainloop_and_dir_metrics          |   5 +
 src/core/mainloop/connection.c            |   4 +-
 src/core/mainloop/mainloop.c              |  45 ++-
 src/core/mainloop/mainloop.h              |  18 ++
 src/core/or/connection_edge.c             |   5 +
 src/core/or/or_circuit_st.h               |   3 +
 src/feature/dircache/dircache.c           |  52 +++-
 src/feature/dircommon/dir_connection_st.h |   7 +
 src/feature/dircommon/directory.c         |  22 ++
 src/feature/dircommon/directory.h         |  33 +++
 src/feature/relay/relay_metrics.c         | 339 +++++++++++++++++++++-
 src/feature/relay/relay_metrics.h         |  18 ++
 src/feature/relay/relay_stub.c            |  29 ++
 src/test/test_mainloop.c                  | 234 +++++++++++++++
 14 files changed, 797 insertions(+), 17 deletions(-)
 create mode 100644 changes/mainloop_and_dir_metrics

diff --git a/changes/mainloop_and_dir_metrics b/changes/mainloop_and_dir_metrics
new file mode 100644
index 0000000000..80a51954f8
--- /dev/null
+++ b/changes/mainloop_and_dir_metrics
@@ -0,0 +1,5 @@
+  o Minor feature (relay, metrics):
+    - Expose mainloop connection-list sizes, cleanup pass work and duration,
+      event-loop tick stall counts and high-water-mark duration, and
+      server-side BEGIN_DIR stream lifecycle, circuit reuse, HTTP request
+      class, HTTP status, and byte counters on the MetricsPort.
diff --git a/src/core/mainloop/connection.c b/src/core/mainloop/connection.c
index 502cbb5941..6b763982b6 100644
--- a/src/core/mainloop/connection.c
+++ b/src/core/mainloop/connection.c
@@ -3662,8 +3662,10 @@ record_num_bytes_transferred_impl(connection_t *conn,
   if (conn->type == CONN_TYPE_DIR && conn->purpose == DIR_PURPOSE_SERVER) {
     if (num_read > 0)
       bwhist_note_dir_bytes_read(num_read, now);
-    if (num_written > 0)
+    if (num_written > 0) {
       bwhist_note_dir_bytes_written(num_written, now);
+      relay_metrics_note_dir_bytes(TO_DIR_CONN(conn), true, num_written);
+    }
   }
 
   /* Linked connections and internal IPs aren't counted for statistics or
diff --git a/src/core/mainloop/mainloop.c b/src/core/mainloop/mainloop.c
index 4ebfd1341f..c07a830a5e 100644
--- a/src/core/mainloop/mainloop.c
+++ b/src/core/mainloop/mainloop.c
@@ -149,6 +149,8 @@ static uint64_t stats_n_main_loop_successes = 0;
 static uint64_t stats_n_main_loop_errors = 0;
 /** How many times have we returned from the main loop with no events. */
 static uint64_t stats_n_main_loop_idle = 0;
+/** Mainloop connection-list, cleanup, and tick duration metrics. */
+static mainloop_metrics_t mainloop_metrics;
 
 /** How often will we honor SIGNEWNYM requests? */
 #define MAX_SIGNEWNYM_RATE 10
@@ -461,6 +463,7 @@ add_connection_to_closeable_list(connection_t *conn)
   }
   conn->closeable_list_index = smartlist_len(closeable_connection_lst);
   smartlist_add(closeable_connection_lst, conn);
+  ++mainloop_metrics.closeable_added;
   mainloop_schedule_postloop_cleanup();
 }
 
@@ -556,6 +559,21 @@ reset_main_loop_counters(void)
   stats_n_main_loop_successes = 0;
   stats_n_main_loop_errors = 0;
   stats_n_main_loop_idle = 0;
+  memset(&mainloop_metrics, 0, sizeof(mainloop_metrics));
+}
+
+/** Update current connection list lengths and return mainloop metrics. */
+const mainloop_metrics_t *
+mainloop_get_metrics(void)
+{
+  mainloop_metrics.conn_array_len =
+    connection_array ? smartlist_len(connection_array) : 0;
+  mainloop_metrics.closeable_len =
+    closeable_connection_lst ? smartlist_len(closeable_connection_lst) : 0;
+  mainloop_metrics.active_linked_len =
+    active_linked_connection_lst ?
+      smartlist_len(active_linked_connection_lst) : 0;
+  return &mainloop_metrics;
 }
 
 /** Increment the main loop success counter. */
@@ -876,6 +894,7 @@ connection_start_reading_from_linked_conn(connection_t *conn)
     conn->active_linked_list_index =
       smartlist_len(active_linked_connection_lst);
     smartlist_add(active_linked_connection_lst, conn);
+    ++mainloop_metrics.active_linked_added;
   }
   if (!conn->active_on_link || idx < 0)
     mainloop_event_activate(schedule_active_linked_connections_event);
@@ -911,15 +930,24 @@ STATIC void
 close_closeable_connections(void)
 {
   int i;
+  const uint64_t t_start = monotime_coarse_absolute_usec();
+  ++mainloop_metrics.close_pass_runs;
   for (i = 0; i < smartlist_len(closeable_connection_lst); ) {
     connection_t *conn = smartlist_get(closeable_connection_lst, i);
+    ++mainloop_metrics.close_pass_visited;
     if (!connection_in_array(conn)) {
       connection_unlink(conn); /* blow it away right now */
+      ++mainloop_metrics.close_pass_closed;
+    } else if (!conn_close_if_marked(conn->conn_array_index)) {
+      ++mainloop_metrics.close_pass_deferred;
+      ++i;
     } else {
-      if (!conn_close_if_marked(conn->conn_array_index))
-        ++i;
+      ++mainloop_metrics.close_pass_closed;
     }
   }
+  const uint64_t t_end = monotime_coarse_absolute_usec();
+  if (t_end > t_start)
+    mainloop_metrics.close_pass_duration_usec += (t_end - t_start);
 }
 
 /** Count moribund connections for the OOS handler */
@@ -1081,6 +1109,10 @@ conn_close_if_marked(int i)
     } else {
       retval = buf_flush_to_socket(conn->outbuf, conn->s, sz);
     }
+    if (retval > 0 && conn->type == CONN_TYPE_DIR &&
+        conn->purpose == DIR_PURPOSE_SERVER && !conn->linked_conn_is_closed &&
+        (!conn->linked_conn || !conn->linked_conn->marked_for_close))
+      relay_metrics_note_dir_bytes(TO_DIR_CONN(conn), true, (size_t)retval);
     if (retval >= 0 && /* Technically, we could survive things like
                           TLS_WANT_WRITE here. But don't bother for now. */
         conn->hold_open_until_flushed && connection_wants_to_flush(conn)) {
@@ -2543,8 +2575,16 @@ run_main_loop_once(void)
    * an event, or the second ends, or until we have some active linked
    * connections to trigger events for.  Libevent will wait till one
    * of these happens, then run all the appropriate callbacks. */
+  const uint64_t tick_start = monotime_coarse_absolute_usec();
   loop_result = tor_libevent_run_event_loop(tor_libevent_get_base(),
                                             called_loop_once);
+  const uint64_t tick_end = monotime_coarse_absolute_usec();
+  const uint64_t tick_usec = tick_end > tick_start ? tick_end - tick_start : 0;
+  if (tick_usec > mainloop_metrics.tick_max_duration_usec)
+    mainloop_metrics.tick_max_duration_usec = tick_usec;
+  mainloop_metrics.tick_over_10ms += (tick_usec >= 10000);
+  mainloop_metrics.tick_over_100ms += (tick_usec >= 100000);
+  mainloop_metrics.tick_over_1000ms += (tick_usec >= 1000000);
 
   if (mainloop_must_free_memory) {
     /* Note that calling event_base_loopbreak() can set the return value
@@ -2661,6 +2701,7 @@ tor_mainloop_free_all(void)
 #endif
 
   stats_n_bytes_read = stats_n_bytes_written = 0;
+  memset(&mainloop_metrics, 0, sizeof(mainloop_metrics));
 
   memset(&global_bucket, 0, sizeof(global_bucket));
   memset(&global_relayed_bucket, 0, sizeof(global_relayed_bucket));
diff --git a/src/core/mainloop/mainloop.h b/src/core/mainloop/mainloop.h
index 2110cc523e..10c5bd515a 100644
--- a/src/core/mainloop/mainloop.h
+++ b/src/core/mainloop/mainloop.h
@@ -79,6 +79,24 @@ uint64_t get_main_loop_success_count(void);
 uint64_t get_main_loop_error_count(void);
 uint64_t get_main_loop_idle_count(void);
 
+typedef struct mainloop_metrics_t {
+  int conn_array_len;
+  int closeable_len;
+  int active_linked_len;
+  uint64_t closeable_added;
+  uint64_t active_linked_added;
+  uint64_t close_pass_runs;
+  uint64_t close_pass_visited;
+  uint64_t close_pass_closed;
+  uint64_t close_pass_deferred;
+  uint64_t close_pass_duration_usec;
+  uint64_t tick_over_10ms;
+  uint64_t tick_over_100ms;
+  uint64_t tick_over_1000ms;
+  uint64_t tick_max_duration_usec;
+} mainloop_metrics_t;
+const mainloop_metrics_t *mainloop_get_metrics(void);
+
 void periodic_events_on_new_options(const or_options_t *options);
 
 void do_signewnym(time_t);
diff --git a/src/core/or/connection_edge.c b/src/core/or/connection_edge.c
index 20590336d1..693a5c237e 100644
--- a/src/core/or/connection_edge.c
+++ b/src/core/or/connection_edge.c
@@ -4761,6 +4761,11 @@ connection_exit_connect_dir(edge_connection_t *exitconn)
     return 0;
   }
 
+  if (circ->begindir_stream_count < UINT16_MAX)
+    ++circ->begindir_stream_count;
+  relay_metrics_note_dir_stream_phase(dirconn, DIR_STREAM_PHASE_OPENED,
+                                      circ->begindir_stream_count);
+
   connection_start_reading(TO_CONN(dirconn));
   connection_start_reading(TO_CONN(exitconn));
 
diff --git a/src/core/or/or_circuit_st.h b/src/core/or/or_circuit_st.h
index 69eba16c0a..66ad98e05b 100644
--- a/src/core/or/or_circuit_st.h
+++ b/src/core/or/or_circuit_st.h
@@ -130,6 +130,9 @@ struct or_circuit_t {
   /** Format to use when exchanging relay cells with the client
