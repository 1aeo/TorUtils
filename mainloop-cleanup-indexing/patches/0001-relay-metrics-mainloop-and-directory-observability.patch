@@ -65,6 +65,13 @@ struct dir_connection_t {
    * geoip until we've served the final bytes. */
   bool should_count_geoip_when_finished;
 
+  /** Request class (dir_req_class_t) for server-side directory metrics. */
+  uint8_t dir_req_class;
+  /** Lifecycle phase (dir_stream_phase_t) for server-side BEGIN_DIR stream. */
+  uint8_t dir_stream_phase;
+  /** 1 if HTTP response status has been recorded for this connection. */
+  unsigned int dir_status_recorded:1;
+
 #ifdef MEASUREMENTS_21206
   /** Number of RELAY_DATA cells received. */
   uint32_t data_cells_received;
diff --git a/src/feature/dircommon/directory.c b/src/feature/dircommon/directory.c
index 86693a38ac..f279687a6a 100644
--- a/src/feature/dircommon/directory.c
+++ b/src/feature/dircommon/directory.c
@@ -519,6 +519,26 @@ connection_dir_about_to_close(dir_connection_t *dir_conn)
 {
   connection_t *conn = TO_CONN(dir_conn);
 
+  if (conn->purpose == DIR_PURPOSE_SERVER) {
+    if (conn->inbuf && buf_datalen(conn->inbuf) > 0)
+      relay_metrics_note_dir_bytes(dir_conn, false, buf_datalen(conn->inbuf));
+    if (dir_conn->dir_stream_phase == DIR_STREAM_PHASE_WRITING) {
+      const bool peer_ok = conn->linked ?
+        (!conn->linked_conn_is_closed && conn->linked_conn &&
+         !conn->linked_conn->marked_for_close) : SOCKET_OK(conn->s);
+      relay_metrics_note_dir_stream_phase(dir_conn,
+        (!connection_wants_to_flush(conn) && !dir_conn->spool && peer_ok) ?
+          DIR_STREAM_PHASE_COMPLETED : DIR_STREAM_PHASE_ABORTED_WRITING, 0);
+    } else if (dir_conn->dir_stream_phase == DIR_STREAM_PHASE_OPENED) {
+      relay_metrics_note_dir_stream_phase(dir_conn,
+        (dir_conn->dir_status_recorded ||
+         dir_conn->dir_req_class != DIR_REQ_CLASS_UNCLASSIFIED ||
+         (conn->inbuf && buf_datalen(conn->inbuf) > 0)) ?
+          DIR_STREAM_PHASE_ABORTED_MID_HTTP :
+          DIR_STREAM_PHASE_ABORTED_PRE_HTTP, 0);
+    }
+  }
+
   if (conn->state < DIR_CONN_STATE_CLIENT_FINISHED) {
     /* It's a directory connection and connecting or fetching
      * failed: forget about this router, and maybe try again. */
@@ -574,6 +594,8 @@ connection_dir_finished_flushing(dir_connection_t *conn)
         connection_mark_for_close(TO_CONN(conn));
       } else {
         log_debug(LD_DIRSERV, "Finished writing server response. Closing.");
+        relay_metrics_note_dir_stream_phase(conn,
+                                            DIR_STREAM_PHASE_COMPLETED, 0);
         connection_mark_for_close(TO_CONN(conn));
       }
       return 0;
diff --git a/src/feature/dircommon/directory.h b/src/feature/dircommon/directory.h
index ffb2a87257..b996cfe88c 100644
--- a/src/feature/dircommon/directory.h
+++ b/src/feature/dircommon/directory.h
@@ -122,4 +122,37 @@ char *authdir_type_to_string(dirinfo_type_t auth);
 #define X_ADDRESS_HEADER "X-Your-Address-Is: "
 #define X_OR_DIFF_FROM_CONSENSUS_HEADER "X-Or-Diff-From-Consensus: "
 
+typedef enum {
+  DIR_REQ_CLASS_UNCLASSIFIED = 0,
+  DIR_REQ_CLASS_CONSENSUS,
+  DIR_REQ_CLASS_MICRODESC,
+  DIR_REQ_CLASS_SERVER_DESC,
+  DIR_REQ_CLASS_EXTRA_INFO,
+  DIR_REQ_CLASS_AUTHORITY_CERTS,
+  DIR_REQ_CLASS_HS_V3_FETCH,
+  DIR_REQ_CLASS_HS_V3_PUBLISH,
+  DIR_REQ_CLASS_OTHER_VALID,
+  DIR_REQ_CLASS_INVALID,
+  DIR_REQ_CLASS_COUNT
+} dir_req_class_t;
+
+typedef enum {
+  DIR_STREAM_PHASE_NONE = 0,
+  DIR_STREAM_PHASE_OPENED,
+  DIR_STREAM_PHASE_WRITING,
+  DIR_STREAM_PHASE_COMPLETED,
+  DIR_STREAM_PHASE_ABORTED_PRE_HTTP,
+  DIR_STREAM_PHASE_ABORTED_MID_HTTP,
+  DIR_STREAM_PHASE_ABORTED_WRITING,
+  DIR_STREAM_PHASE_COUNT
+} dir_stream_phase_t;
+
+void relay_metrics_note_dir_stream_phase(dir_connection_t *dir_conn,
+                                         dir_stream_phase_t phase,
+                                         uint16_t circ_begindir_index);
+void relay_metrics_note_dir_http_request(dir_connection_t *dir_conn,
