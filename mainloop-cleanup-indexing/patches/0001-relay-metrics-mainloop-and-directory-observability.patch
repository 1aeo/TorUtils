+static void
+add_labeled_metric(relay_metrics_key_t key, const char *k1, const char *v1,
+                   const char *k2, const char *v2, int64_t value)
+{
+  const relay_metrics_entry_t *rentry = &base_metrics[key];
+  tor_assert(rentry->key == key);
+  metrics_store_entry_t *sentry =
+    metrics_store_add(the_store, rentry->type, rentry->name,
+                      rentry->help, 0, NULL);
+  if (k1)
+    metrics_store_entry_add_label(sentry, metrics_format_label(k1, v1));
+  if (k2)
+    metrics_store_entry_add_label(sentry, metrics_format_label(k2, v2));
+  metrics_store_entry_update(sentry, value);
+}
+
+static void
+fill_mainloop_conn_lists(void)
+{
+  const mainloop_metrics_t *m = mainloop_get_metrics();
+  add_labeled_metric(RELAY_METRICS_MAINLOOP_CONN_LISTS, "list",
+                     "connection_array", NULL, NULL, m->conn_array_len);
+  add_labeled_metric(RELAY_METRICS_MAINLOOP_CONN_LISTS, "list",
+                     "closeable", NULL, NULL, m->closeable_len);
+  add_labeled_metric(RELAY_METRICS_MAINLOOP_CONN_LISTS, "list",
+                     "active_linked", NULL, NULL, m->active_linked_len);
+}
+
+static void
+fill_mainloop_conn_list_ops(void)
+{
