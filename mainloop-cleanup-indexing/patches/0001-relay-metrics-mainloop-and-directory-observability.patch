@@ -117,6 +117,7 @@ write_short_http_response(dir_connection_t *conn, int status,
                status, reason_phrase, datestring?datestring:"");
 
   log_debug(LD_DIRSERV,"Wrote status 'HTTP/1.0 %d %s'", status, reason_phrase);
+  relay_metrics_note_dir_http_request(conn, status);
   connection_buf_add(buf, strlen(buf), TO_CONN(conn));
 
   tor_free(datestring);
@@ -176,6 +177,7 @@ write_http_response_header_impl(dir_connection_t *conn, ssize_t length,
   }
   buf_add_string(buf, "\r\n");
 
+  relay_metrics_note_dir_http_request(conn, 200);
   connection_buf_add_buf(TO_CONN(conn), buf);
   buf_free(buf);
 }
@@ -348,6 +350,7 @@ typedef struct url_table_ent_t {
   const char *string;
   int is_prefix;
   int (*handler)(dir_connection_t *conn, const get_handler_args_t *args);
+  dir_req_class_t req_class;
 } url_table_ent_t;
 
 static int handle_get_frontpage(dir_connection_t *conn,
@@ -371,19 +374,24 @@ static int handle_get_next_bandwidth(dir_connection_t *conn,
 
 /** Table for handling GET requests. */
 static const url_table_ent_t url_table[] = {
-  { "/tor/", 0, handle_get_frontpage },
-  { "/tor/status-vote/current/consensus", 1, handle_get_current_consensus },
-  { "/tor/status-vote/current/", 1, handle_get_status_vote },
-  { "/tor/status-vote/next/bandwidth", 0, handle_get_next_bandwidth },
-  { "/tor/status-vote/next/", 1, handle_get_status_vote },
-  { "/tor/micro/d/", 1, handle_get_microdesc },
-  { "/tor/server/", 1, handle_get_descriptor },
-  { "/tor/extra/", 1, handle_get_descriptor },
-  { "/tor/keys/", 1, handle_get_keys },
-  { "/tor/hs/3/", 1, handle_get_hs_descriptor_v3 },
-  { "/tor/robots.txt", 0, handle_get_robots },
-  { "/tor/networkstatus-bridges", 0, handle_get_networkstatus_bridges },
-  { NULL, 0, NULL },
+  { "/tor/", 0, handle_get_frontpage, DIR_REQ_CLASS_OTHER_VALID },
+  { "/tor/status-vote/current/consensus", 1, handle_get_current_consensus,
+    DIR_REQ_CLASS_CONSENSUS },
+  { "/tor/status-vote/current/", 1, handle_get_status_vote,
+    DIR_REQ_CLASS_OTHER_VALID },
+  { "/tor/status-vote/next/bandwidth", 0, handle_get_next_bandwidth,
+    DIR_REQ_CLASS_OTHER_VALID },
+  { "/tor/status-vote/next/", 1, handle_get_status_vote,
+    DIR_REQ_CLASS_OTHER_VALID },
+  { "/tor/micro/d/", 1, handle_get_microdesc, DIR_REQ_CLASS_MICRODESC },
+  { "/tor/server/", 1, handle_get_descriptor, DIR_REQ_CLASS_SERVER_DESC },
+  { "/tor/extra/", 1, handle_get_descriptor, DIR_REQ_CLASS_EXTRA_INFO },
+  { "/tor/keys/", 1, handle_get_keys, DIR_REQ_CLASS_AUTHORITY_CERTS },
+  { "/tor/hs/3/", 1, handle_get_hs_descriptor_v3, DIR_REQ_CLASS_HS_V3_FETCH },
+  { "/tor/robots.txt", 0, handle_get_robots, DIR_REQ_CLASS_OTHER_VALID },
+  { "/tor/networkstatus-bridges", 0, handle_get_networkstatus_bridges,
+    DIR_REQ_CLASS_OTHER_VALID },
+  { NULL, 0, NULL, DIR_REQ_CLASS_UNCLASSIFIED },
 };
 
 /** Helper function: called when a dirserver gets a complete HTTP GET
@@ -408,6 +416,7 @@ directory_handle_command_get,(dir_connection_t *conn, const char *headers,
   log_debug(LD_DIRSERV,"Received GET command.");
 
   conn->base_.state = DIR_CONN_STATE_SERVER_WRITING;
+  conn->dir_req_class = DIR_REQ_CLASS_INVALID;
 
   if (parse_http_url(headers, &url) < 0) {
     write_short_http_response(conn, 400, "Bad request");
@@ -466,6 +475,7 @@ directory_handle_command_get,(dir_connection_t *conn, const char *headers,
       match = !strcmp(url, url_table[i].string);
     }
     if (match) {
+      conn->dir_req_class = url_table[i].req_class;
       result = url_table[i].handler(conn, &args);
       goto done;
     }
@@ -1251,6 +1261,7 @@ handle_get_descriptor(dir_connection_t *conn, const get_handler_args_t *args)
     }
     goto done;
   }
+  relay_metrics_note_dir_http_request(conn, 0);
  done:
   if (clear_spool)
     dir_conn_clear_spool(conn);
@@ -1413,6 +1424,7 @@ hsdir_request_allowed_on_circuit(dir_connection_t *conn)
 
   if (circ->already_received_hsdir_request) {
     dos_note_begindir_hsdir_rejected();
+    relay_metrics_note_dir_http_request(conn, 0);
     circuit_mark_for_close(TO_CIRCUIT(circ), END_CIRC_REASON_TORPROTOCOL);
     return false;
   }
@@ -1514,6 +1526,7 @@ handle_get_networkstatus_bridges(dir_connection_t *conn,
     tor_free(status);
     goto done;
   }
+  relay_metrics_note_dir_http_request(conn, 0);
  done:
   return 0;
 }
@@ -1675,6 +1688,7 @@ directory_handle_command_post,(dir_connection_t *conn, const char *headers,
     goto done;
   }
 
+  conn->dir_req_class = DIR_REQ_CLASS_INVALID;
   if (parse_http_url(headers, &url) < 0) {
     write_short_http_response(conn, 400, "Bad request");
     return 0;
@@ -1688,6 +1702,7 @@ directory_handle_command_post,(dir_connection_t *conn, const char *headers,
     if (dir_conn_is_closing(conn)) {
       goto done;
     }
+    conn->dir_req_class = DIR_REQ_CLASS_HS_V3_PUBLISH;
     if (!connection_dir_is_anonymous(conn)) {
       write_short_http_response(conn, 503,
                                 "Rejecting single hop HS descriptor post");
@@ -1707,6 +1722,9 @@ directory_handle_command_post,(dir_connection_t *conn, const char *headers,
     goto done;
   }
 
+  if (!strcmp(url, "/tor/") || !strcmp(url, "/tor/post/vote") ||
+      !strcmp(url, "/tor/post/consensus-signature"))
+    conn->dir_req_class = DIR_REQ_CLASS_OTHER_VALID;
   if (!authdir_mode(options)) {
     /* we just provide cached directories; we don't want to
      * receive anything. */
@@ -1840,6 +1858,7 @@ directory_handle_command(dir_connection_t *conn)
     return -1;
   }
 
+  const size_t inbuf_before = buf_datalen(TO_CONN(conn)->inbuf);
   switch (connection_fetch_from_buf_http(TO_CONN(conn),
                               &headers, MAX_HEADERS_SIZE,
                               &body, &body_len, MAX_DIR_UL_SIZE, 0)) {
@@ -1847,6 +1866,7 @@ directory_handle_command(dir_connection_t *conn)
       log_warn(LD_DIRSERV,
                "Request too large from %s to DirPort. Closing.",
                connection_describe_peer(TO_CONN(conn)));
+      relay_metrics_note_dir_http_request(conn, 0);
       return -1;
     case 0:
       log_debug(LD_DIRSERV,"command not all here yet.");
@@ -1867,9 +1887,15 @@ directory_handle_command(dir_connection_t *conn)
     log_fn(LOG_PROTOCOL_WARN, LD_PROTOCOL,
            "Got headers %s with unknown command. Closing.",
            escaped(headers));
+    conn->dir_req_class = DIR_REQ_CLASS_INVALID;
     r = -1;
   }
 
+  relay_metrics_note_dir_bytes(conn, false,
+                               inbuf_before -
+                                 buf_datalen(TO_CONN(conn)->inbuf));
+  if (r < 0)
+    relay_metrics_note_dir_http_request(conn, 0);
   tor_free(headers); tor_free(body);
   return r;
 }
diff --git a/src/feature/dircommon/dir_connection_st.h b/src/feature/dircommon/dir_connection_st.h
index ee26fd3627..2d85966b19 100644
--- a/src/feature/dircommon/dir_connection_st.h
