+  add_labeled_metric(RELAY_METRICS_MAINLOOP_CONN_LIST_OPS, "list",
+                     "closeable", "op", "add", (int64_t)m->closeable_added);
+  add_labeled_metric(RELAY_METRICS_MAINLOOP_CONN_LIST_OPS, "list",
+                     "active_linked", "op", "add",
+                     (int64_t)m->active_linked_added);
+}
+
+static void
+fill_mainloop_close_pass(void)
+{
+  const mainloop_metrics_t *m = mainloop_get_metrics();
+  const struct {
+    const char *k;
+    uint64_t v;
+  } fields[] = {
+    { "runs", m->close_pass_runs },
+    { "visited", m->close_pass_visited },
+    { "closed", m->close_pass_closed },
+    { "deferred", m->close_pass_deferred },
+    { "duration_usec", m->close_pass_duration_usec },
+  };
+  for (size_t i = 0; i < ARRAY_LENGTH(fields); ++i)
+    add_labeled_metric(RELAY_METRICS_MAINLOOP_CLOSE_PASS, "field", fields[i].k,
+                       NULL, NULL, (int64_t)fields[i].v);
+}
+
+static void
+fill_mainloop_ticks(void)
+{
