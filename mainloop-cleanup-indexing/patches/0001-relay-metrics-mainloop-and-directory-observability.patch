+  const struct {
+    const char *k;
+    uint64_t v;
+  } ticks[] = {
+    { "over_10ms", m->tick_over_10ms },
+    { "over_100ms", m->tick_over_100ms },
+    { "over_1000ms", m->tick_over_1000ms },
+  };
+  for (size_t i = 0; i < ARRAY_LENGTH(ticks); ++i)
+    add_labeled_metric(RELAY_METRICS_MAINLOOP_TICKS, "threshold", ticks[i].k,
+                       NULL, NULL, (int64_t)ticks[i].v);
+}
