@@ -242,6 +253,71 @@ static const relay_metrics_entry_t base_metrics[] =
     .help = "Total number of DROP cell we received",
     .fill_fn = fill_relay_drop_cell,
   },
+  {
+    .key = RELAY_METRICS_MAINLOOP_CONN_LISTS,
