 #include "feature/stats/connstats.h"
@@ -3659,8 +3660,10 @@ record_num_bytes_transferred_impl(connection_t *conn,
   if (conn->type == CONN_TYPE_DIR && conn->purpose == DIR_PURPOSE_SERVER) {
     if (num_read > 0)
       bwhist_note_dir_bytes_read(num_read, now);
