 src/core/mainloop/mainloop.c              |  56 +++-
 src/core/mainloop/mainloop.h              |  18 ++
 src/core/or/connection_edge.c             |   6 +
 src/core/or/or_circuit_st.h               |   3 +
 src/feature/dircache/dircache.c           |  49 ++-
 src/feature/dircommon/dir_connection_st.h |   7 +
 src/feature/dircommon/directory.c         |  29 ++
 src/feature/relay/relay_metrics.c         | 356 ++++++++++++++++++++++
 src/feature/relay/relay_metrics.h         |  53 ++++
 src/test/test_mainloop.c                  | 146 +++++++++
 11 files changed, 713 insertions(+), 15 deletions(-)

