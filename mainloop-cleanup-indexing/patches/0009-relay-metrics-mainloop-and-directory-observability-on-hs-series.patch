+typedef enum {
+  DIR_HTTP_STATUS_200 = 0,
+  DIR_HTTP_STATUS_304,
+  DIR_HTTP_STATUS_400,
+  DIR_HTTP_STATUS_404,
+  DIR_HTTP_STATUS_503,
+  DIR_HTTP_STATUS_OTHER,
+  DIR_HTTP_STATUS_REJECTED_EARLY,
+  DIR_HTTP_STATUS_COUNT
+} dir_http_status_idx_t;
+
+static struct {
+  uint64_t streams_total[DIR_STREAM_PHASE_COUNT];
+  uint64_t streams_reused_circuit_total;
+  int64_t active_opened_wait;
+  int64_t active_writing;
+  uint64_t http_requests_total[DIR_REQ_CLASS_COUNT][DIR_HTTP_STATUS_COUNT];
+  uint64_t bytes_total[DIR_REQ_CLASS_COUNT][2];
+} dir_metrics;
+
+static const char *const dir_req_class_names[DIR_REQ_CLASS_COUNT] = {
+  [DIR_REQ_CLASS_UNCLASSIFIED] = "unclassified",
+  [DIR_REQ_CLASS_CONSENSUS] = "consensus",
+  [DIR_REQ_CLASS_MICRODESC] = "microdesc",
+  [DIR_REQ_CLASS_SERVER_DESC] = "server_desc",
+  [DIR_REQ_CLASS_EXTRA_INFO] = "extra_info",
+  [DIR_REQ_CLASS_AUTHORITY_CERTS] = "authority_certs",
+  [DIR_REQ_CLASS_HS_V3_FETCH] = "hs_v3_fetch",
+  [DIR_REQ_CLASS_HS_V3_PUBLISH] = "hs_v3_publish",
+  [DIR_REQ_CLASS_OTHER_VALID] = "other_valid",
+  [DIR_REQ_CLASS_INVALID] = "invalid",
+};
+
+static const char *const dir_http_status_names[DIR_HTTP_STATUS_COUNT] = {
+  [DIR_HTTP_STATUS_200] = "200",
+  [DIR_HTTP_STATUS_304] = "304",
+  [DIR_HTTP_STATUS_400] = "400",
+  [DIR_HTTP_STATUS_404] = "404",
+  [DIR_HTTP_STATUS_503] = "503",
+  [DIR_HTTP_STATUS_OTHER] = "other",
+  [DIR_HTTP_STATUS_REJECTED_EARLY] = "rejected_early",
+};
+
+static const char *const dir_stream_phase_names[] = {
+  "opened",
+  "writing",
+  "completed",
+  "aborted_pre_http",
+  "aborted_mid_http",
+  "aborted_writing",
+};
+
+void
+relay_metrics_note_dir_stream_phase(dir_connection_t *dir_conn,
+                                    dir_stream_phase_t phase,
+                                    uint16_t circ_begindir_index)
+{
+  if (!dir_conn || TO_CONN(dir_conn)->purpose != DIR_PURPOSE_SERVER)
+    return;
+
+  dir_stream_phase_t prev = dir_conn->dir_stream_phase;
+  if (phase == DIR_STREAM_PHASE_OPENED) {
+    if (prev != DIR_STREAM_PHASE_NONE)
+      return;
+    ++dir_metrics.active_opened_wait;
+    if (circ_begindir_index >= 2)
+      ++dir_metrics.streams_reused_circuit_total;
+  } else if (prev == DIR_STREAM_PHASE_OPENED &&
+             (phase == DIR_STREAM_PHASE_WRITING ||
+              phase == DIR_STREAM_PHASE_ABORTED_PRE_HTTP ||
+              phase == DIR_STREAM_PHASE_ABORTED_MID_HTTP)) {
+    if (dir_metrics.active_opened_wait > 0)
+      --dir_metrics.active_opened_wait;
+    if (phase == DIR_STREAM_PHASE_WRITING)
+      ++dir_metrics.active_writing;
+  } else if (prev == DIR_STREAM_PHASE_WRITING &&
+             (phase == DIR_STREAM_PHASE_COMPLETED ||
+              phase == DIR_STREAM_PHASE_ABORTED_WRITING)) {
+    if (dir_metrics.active_writing > 0)
+      --dir_metrics.active_writing;
+  } else {
+    return;
+  }
+
+  dir_conn->dir_stream_phase = (uint8_t)phase;
+  ++dir_metrics.streams_total[phase];
+}
+
+void
+relay_metrics_note_dir_http_request(dir_connection_t *dir_conn,
+                                    int status_code)
+{
+  if (!dir_conn || dir_conn->dir_status_recorded)
+    return;
+  uint8_t purpose = TO_CONN(dir_conn)->purpose;
+  if (purpose != 0 && purpose != DIR_PURPOSE_SERVER)
+    return;
+
+  dir_conn->dir_status_recorded = 1;
+  uint8_t cls = dir_conn->dir_req_class;
+  if (cls >= DIR_REQ_CLASS_COUNT)
+    cls = DIR_REQ_CLASS_UNCLASSIFIED;
+
+  dir_http_status_idx_t sidx;
+  switch (status_code) {
+    case 0:   sidx = DIR_HTTP_STATUS_REJECTED_EARLY; break;
+    case 200: sidx = DIR_HTTP_STATUS_200; break;
+    case 304: sidx = DIR_HTTP_STATUS_304; break;
+    case 400: sidx = DIR_HTTP_STATUS_400; break;
+    case 404: sidx = DIR_HTTP_STATUS_404; break;
+    case 503: sidx = DIR_HTTP_STATUS_503; break;
+    default:  sidx = DIR_HTTP_STATUS_OTHER; break;
+  }
+  ++dir_metrics.http_requests_total[cls][sidx];
+
+  if (status_code > 0 &&
+      dir_conn->dir_stream_phase == DIR_STREAM_PHASE_OPENED) {
+    relay_metrics_note_dir_stream_phase(dir_conn, DIR_STREAM_PHASE_WRITING, 0);
+  }
+}
+
+void
+relay_metrics_note_dir_bytes(dir_connection_t *dir_conn,
+                             bool is_written, size_t num_bytes)
+{
+  if (!dir_conn || num_bytes == 0)
+    return;
+  uint8_t purpose = TO_CONN(dir_conn)->purpose;
+  if (purpose != 0 && purpose != DIR_PURPOSE_SERVER)
+    return;
+
+  uint8_t cls = dir_conn->dir_req_class;
+  if (cls >= DIR_REQ_CLASS_COUNT)
+    cls = DIR_REQ_CLASS_UNCLASSIFIED;
+
+  dir_metrics.bytes_total[cls][is_written ? 1 : 0] += num_bytes;
+}
+
+static void
+fill_dir_streams(void)
+{
+  for (size_t i = 0; i < ARRAY_LENGTH(dir_stream_phase_names); ++i) {
+    add_labeled_metric(RELAY_METRICS_DIR_STREAMS,
+                       "phase", dir_stream_phase_names[i], NULL, NULL,
+                       (int64_t)dir_metrics.streams_total[i + 1]);
+  }
+  add_labeled_metric(RELAY_METRICS_DIR_STREAMS,
+                     "phase", "reused_circuit", NULL, NULL,
+                     (int64_t)dir_metrics.streams_reused_circuit_total);
+}
+
+static void
+fill_dir_streams_active(void)
+{
+  add_labeled_metric(RELAY_METRICS_DIR_STREAMS_ACTIVE,
+                     "state", "opened_wait", NULL, NULL,
+                     dir_metrics.active_opened_wait);
+  add_labeled_metric(RELAY_METRICS_DIR_STREAMS_ACTIVE,
+                     "state", "writing", NULL, NULL,
+                     dir_metrics.active_writing);
+}
+
+static void
+fill_dir_http_requests(void)
+{
+  for (size_t c = 0; c < DIR_REQ_CLASS_COUNT; ++c) {
+    for (size_t s = 0; s < DIR_HTTP_STATUS_COUNT; ++s) {
+      add_labeled_metric(RELAY_METRICS_DIR_HTTP_REQUESTS,
+                         "class", dir_req_class_names[c],
+                         "status", dir_http_status_names[s],
+                         (int64_t)dir_metrics.http_requests_total[c][s]);
+    }
+  }
+}
+
+static void
+fill_dir_bytes(void)
+{
+  for (size_t c = 0; c < DIR_REQ_CLASS_COUNT; ++c) {
+    add_labeled_metric(RELAY_METRICS_DIR_BYTES,
+                       "class", dir_req_class_names[c],
+                       "dir", "read",
+                       (int64_t)dir_metrics.bytes_total[c][0]);
+    add_labeled_metric(RELAY_METRICS_DIR_BYTES,
+                       "class", dir_req_class_names[c],
+                       "dir", "written",
+                       (int64_t)dir_metrics.bytes_total[c][1]);
+  }
+}
