@@ -65,6 +65,13 @@ struct dir_connection_t {
    * geoip until we've served the final bytes. */
   bool should_count_geoip_when_finished;
 
+  /** Request class (dir_req_class_t) for server-side directory metrics. */
+  uint8_t dir_req_class;
+  /** Lifecycle phase (dir_stream_phase_t) for server-side BEGIN_DIR stream. */
+  uint8_t dir_stream_phase;
+  /** 1 if HTTP response status has been recorded for this connection. */
+  unsigned int dir_status_recorded:1;
+
 #ifdef MEASUREMENTS_21206
   /** Number of RELAY_DATA cells received. */
   uint32_t data_cells_received;
diff --git a/src/feature/dircommon/directory.c b/src/feature/dircommon/directory.c
index 1266cbc..29c2681 100644
--- a/src/feature/dircommon/directory.c
+++ b/src/feature/dircommon/directory.c
@@ -16,6 +16,7 @@
 #include "feature/dircache/dirserv.h"
 #include "feature/dirclient/dirclient.h"
 #include "feature/dircommon/directory.h"
+#include "feature/relay/relay_metrics.h"
 #include "feature/dircommon/fp_pair.h"
 #include "feature/hs/hs_cache.h"
 #include "feature/stats/geoip_stats.h"
@@ -607,6 +608,30 @@ connection_dir_about_to_close(dir_connection_t *dir_conn)
 {
   connection_t *conn = TO_CONN(dir_conn);
 
+  if (conn->purpose == DIR_PURPOSE_SERVER) {
+    if (conn->inbuf && buf_datalen(conn->inbuf) > 0) {
+      relay_metrics_note_dir_bytes(dir_conn, false, buf_datalen(conn->inbuf));
+    }
+    if (!dir_conn->dir_status_recorded &&
+        (dir_conn->dir_req_class != DIR_REQ_CLASS_UNCLASSIFIED ||
+         (conn->inbuf && buf_datalen(conn->inbuf) > 0 &&
+          !conn->inbuf_reached_eof && !conn->linked_conn_is_closed))) {
+      relay_metrics_note_dir_http_request(dir_conn, 0);
+    }
+    if (dir_conn->dir_stream_phase == DIR_STREAM_PHASE_WRITING) {
+      relay_metrics_note_dir_stream_phase(
+          dir_conn, DIR_STREAM_PHASE_ABORTED_WRITING, 0);
+    } else if (dir_conn->dir_stream_phase == DIR_STREAM_PHASE_OPENED) {
+      relay_metrics_note_dir_stream_phase(
+          dir_conn,
+          (dir_conn->dir_req_class != DIR_REQ_CLASS_UNCLASSIFIED ||
+           (conn->inbuf && buf_datalen(conn->inbuf) > 0)) ?
+            DIR_STREAM_PHASE_ABORTED_MID_HTTP :
+            DIR_STREAM_PHASE_ABORTED_PRE_HTTP,
+          0);
+    }
+  }
+
   if (conn->state < DIR_CONN_STATE_CLIENT_FINISHED) {
     /* It's a directory connection and connecting or fetching
      * failed: forget about this router, and maybe try again. */
@@ -646,6 +671,10 @@ connection_dir_finished_flushing(dir_connection_t *conn)
       conn->base_.state = DIR_CONN_STATE_CLIENT_READING;
       return 0;
     case DIR_CONN_STATE_SERVER_WRITING:
+      if (!conn->spool) {
+        relay_metrics_note_dir_stream_phase(
+            conn, DIR_STREAM_PHASE_COMPLETED, 0);
+      }
       if (conn->spool) {
         log_warn(LD_BUG, "Emptied a dirserv buffer, but it's still spooling!");
         connection_mark_for_close(TO_CONN(conn));
