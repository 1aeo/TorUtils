+  uint64_t tick_over_1000ms;
+  uint64_t tick_max_duration_usec;
+} mainloop_metrics_t;
+const mainloop_metrics_t *mainloop_get_metrics(void);
+
 void periodic_events_on_new_options(const or_options_t *options);
 
 void do_signewnym(time_t);
