@@ -343,6 +346,7 @@ typedef struct url_table_ent_t {
   const char *string;
   int is_prefix;
   int (*handler)(dir_connection_t *conn, const get_handler_args_t *args);
+  dir_req_class_t req_class;
 } url_table_ent_t;
 
 static int handle_get_frontpage(dir_connection_t *conn,
@@ -366,19 +370,24 @@ static int handle_get_next_bandwidth(dir_connection_t *conn,
 
 /** Table for handling GET requests. */
 static const url_table_ent_t url_table[] = {
-  { "/tor/", 0, handle_get_frontpage },
-  { "/tor/status-vote/current/consensus", 1, handle_get_current_consensus },
-  { "/tor/status-vote/current/", 1, handle_get_status_vote },
-  { "/tor/status-vote/next/bandwidth", 0, handle_get_next_bandwidth },
-  { "/tor/status-vote/next/", 1, handle_get_status_vote },
-  { "/tor/micro/d/", 1, handle_get_microdesc },
-  { "/tor/server/", 1, handle_get_descriptor },
-  { "/tor/extra/", 1, handle_get_descriptor },
-  { "/tor/keys/", 1, handle_get_keys },
-  { "/tor/hs/3/", 1, handle_get_hs_descriptor_v3 },
-  { "/tor/robots.txt", 0, handle_get_robots },
-  { "/tor/networkstatus-bridges", 0, handle_get_networkstatus_bridges },
-  { NULL, 0, NULL },
+  { "/tor/", 0, handle_get_frontpage, DIR_REQ_CLASS_OTHER_VALID },
+  { "/tor/status-vote/current/consensus", 1, handle_get_current_consensus,
+    DIR_REQ_CLASS_CONSENSUS },
+  { "/tor/status-vote/current/", 1, handle_get_status_vote,
+    DIR_REQ_CLASS_OTHER_VALID },
+  { "/tor/status-vote/next/bandwidth", 0, handle_get_next_bandwidth,
+    DIR_REQ_CLASS_OTHER_VALID },
+  { "/tor/status-vote/next/", 1, handle_get_status_vote,
+    DIR_REQ_CLASS_OTHER_VALID },
+  { "/tor/micro/d/", 1, handle_get_microdesc, DIR_REQ_CLASS_MICRODESC },
+  { "/tor/server/", 1, handle_get_descriptor, DIR_REQ_CLASS_SERVER_DESC },
+  { "/tor/extra/", 1, handle_get_descriptor, DIR_REQ_CLASS_EXTRA_INFO },
+  { "/tor/keys/", 1, handle_get_keys, DIR_REQ_CLASS_AUTHORITY_CERTS },
+  { "/tor/hs/3/", 1, handle_get_hs_descriptor_v3, DIR_REQ_CLASS_HS_V3_FETCH },
+  { "/tor/robots.txt", 0, handle_get_robots, DIR_REQ_CLASS_OTHER_VALID },
+  { "/tor/networkstatus-bridges", 0, handle_get_networkstatus_bridges,
+    DIR_REQ_CLASS_OTHER_VALID },
+  { NULL, 0, NULL, DIR_REQ_CLASS_UNCLASSIFIED },
 };
 
 /** Helper function: called when a dirserver gets a complete HTTP GET
@@ -405,6 +414,7 @@ directory_handle_command_get,(dir_connection_t *conn, const char *headers,
   conn->base_.state = DIR_CONN_STATE_SERVER_WRITING;
 
   if (parse_http_url(headers, &url) < 0) {
+    conn->dir_req_class = DIR_REQ_CLASS_INVALID;
     write_short_http_response(conn, 400, "Bad request");
     return 0;
   }
@@ -461,12 +471,14 @@ directory_handle_command_get,(dir_connection_t *conn, const char *headers,
       match = !strcmp(url, url_table[i].string);
     }
     if (match) {
+      conn->dir_req_class = url_table[i].req_class;
       result = url_table[i].handler(conn, &args);
       goto done;
     }
   }
 
   /* we didn't recognize the url */
+  conn->dir_req_class = DIR_REQ_CLASS_INVALID;
   write_short_http_response(conn, 404, "Not found");
   result = 0;
 
@@ -1589,6 +1601,7 @@ directory_handle_command_post,(dir_connection_t *conn, const char *headers,
   log_debug(LD_DIRSERV,"Received POST command.");
 
   conn->base_.state = DIR_CONN_STATE_SERVER_WRITING;
+  conn->dir_req_class = DIR_REQ_CLASS_OTHER_VALID;
 
   if (!public_server_mode(options)) {
     log_info(LD_DIR, "Rejected dir post request from %s "
@@ -1599,9 +1612,15 @@ directory_handle_command_post,(dir_connection_t *conn, const char *headers,
   }
 
   if (parse_http_url(headers, &url) < 0) {
+    conn->dir_req_class = DIR_REQ_CLASS_INVALID;
     write_short_http_response(conn, 400, "Bad request");
     return 0;
   }
+  conn->dir_req_class = !strcmpstart(url, "/tor/hs/") ?
+    DIR_REQ_CLASS_HS_V3_PUBLISH :
+    (!strcmp(url, "/tor/") || !strcmp(url, "/tor/post/vote") ||
+     !strcmp(url, "/tor/post/consensus-signature")) ?
+      DIR_REQ_CLASS_OTHER_VALID : DIR_REQ_CLASS_INVALID;
   log_debug(LD_DIRSERV,"rewritten url as '%s'.", escaped(url));
 
   /* Handle HS descriptor publish request. We force an anonymous connection
@@ -1779,12 +1798,16 @@ directory_handle_command(dir_connection_t *conn)
   else if (!strncasecmp(headers,"POST",4))
     r = directory_handle_command_post(conn, headers, body, body_len);
   else {
+    conn->dir_req_class = DIR_REQ_CLASS_INVALID;
     log_fn(LOG_PROTOCOL_WARN, LD_PROTOCOL,
            "Got headers %s with unknown command. Closing.",
            escaped(headers));
     r = -1;
   }
 
+  relay_metrics_note_dir_bytes(conn, false, strlen(headers) + body_len);
+  if (r < 0)
+    relay_metrics_note_dir_http_request(conn, 0);
   tor_free(headers); tor_free(body);
   return r;
 }
