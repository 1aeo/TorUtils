+/** Return 1 if <b>conn</b> is at index <b>idx</b> in <b>sl</b>, or 0 if
+ * <b>idx</b> is -1. Assert that <b>idx</b> is either -1 or a valid index of
+ * <b>conn</b> in <b>sl</b>. */
+static int
+connection_in_idx_list(const smartlist_t *sl, const connection_t *conn,
+                       int idx)
+{
+  if (idx < 0) {
+    tor_assert(idx == -1);
+    return 0;
+  }
+  tor_assert(sl);
+  tor_assert(idx < smartlist_len(sl));
+  tor_assert(smartlist_get(sl, idx) == conn);
+  return 1;
+}
+
 /** Return 1 if conn is on the closeable list, else return 0. */
 int
 connection_is_on_closeable_list(connection_t *conn)
 {
-  return smartlist_contains(closeable_connection_lst, conn);
+  tor_assert(conn);
+  return connection_in_idx_list(closeable_connection_lst, conn,
+                                conn->closeable_conn_idx);
 }
 
 /** Return true iff conn is in the current poll array. */
 int
 connection_in_array(connection_t *conn)
 {
-  return smartlist_contains(connection_array, conn);
+  tor_assert(conn);
+  return connection_in_idx_list(connection_array, conn,
+                                conn->conn_array_index);
+}
+
+/** Return true iff <b>conn</b> is on active_linked_connection_lst. */
+int
+connection_in_active_linked_list(const connection_t *conn)
+{
+  tor_assert(conn);
+  int in_list = connection_in_idx_list(active_linked_connection_lst, conn,
+                                       conn->active_linked_conn_idx);
+  tor_assert(in_list == (int)conn->active_on_link);
+  tor_assert(!in_list || conn->linked);
+  return in_list;
 }
 
