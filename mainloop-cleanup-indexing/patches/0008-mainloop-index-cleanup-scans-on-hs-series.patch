+#ifndef _WIN32
+#define ASSERT_CHILD_ABORTS(stmt) STMT_BEGIN {                    \
+  pid_t pid = fork();                                             \
+  tt_int_op(pid, OP_GE, 0);                                       \
+  if (pid == 0) {                                                 \
+    close(STDERR_FILENO);                                         \
+    close(STDOUT_FILENO);                                         \
+    stmt;                                                         \
+    _exit(0);                                                     \
+  }                                                               \
+  int status = 0;                                                 \
+  pid_t w;                                                        \
+  do {                                                            \
+    w = waitpid(pid, &status, 0);                                 \
+  } while (w < 0 && errno == EINTR);                              \
+  tt_int_op(w, OP_EQ, pid);                                       \
+  tt_assert(WIFSIGNALED(status) ||                                \
+            (WIFEXITED(status) && WEXITSTATUS(status) != 0));     \
+} STMT_END
