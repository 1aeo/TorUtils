+/** Append <b>conn</b> to the indexed smartlist <b>sl</b>, recording its index
+ * in <b>conn</b>-\><b>field</b>. */
+#define CONN_IDX_LIST_ADD(sl, conn, field) STMT_BEGIN {                 \
+  if (PREDICT_UNLIKELY(!(sl)))                                          \
+    (sl) = smartlist_new();                                             \
+  (conn)->field = smartlist_len(sl);                                    \
+  smartlist_add((sl), (conn));                                          \
+} STMT_END
+
+/** Remove <b>conn</b> from the indexed smartlist <b>sl</b> using its index
+ * field <b>field</b>, updating any swapped tail element's <b>field</b> in
+ * O(1) time and resetting <b>conn</b>-\><b>field</b> to -1. */
+#define CONN_IDX_LIST_DEL(sl, conn, field) STMT_BEGIN {                 \
+  int idx_ = (conn)->field;                                             \
+  (conn)->field = -1;                                                   \
+  smartlist_del((sl), idx_);                                            \
+  if (idx_ < smartlist_len(sl)) {                                       \
+    connection_t *swapped_ = smartlist_get((sl), idx_);                 \
+    tor_assert(swapped_->field == smartlist_len(sl));                   \
+    swapped_->field = idx_;                                             \
+  }                                                                     \
+} STMT_END
+
