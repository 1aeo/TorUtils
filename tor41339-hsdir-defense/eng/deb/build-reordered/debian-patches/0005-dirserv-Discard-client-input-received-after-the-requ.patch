From 2e4da2d9d9bd458b5e92c6344cc64463f0031997 Mon Sep 17 00:00:00 2001
From: 1aeo <github@1aeo.com>
Date: Wed, 14 Oct 2026 01:49:22 +0000
Subject: [PATCH 5/7] dirserv: Discard client input received after the request

A directory server handles one request per connection, but it keeps
reading while it writes its answer. connection_dir_process_inbuf() then
buffered whatever else the client sent, up to MAX_DIRECTORY_OBJECT_SIZE
(10 MB), before closing the connection with an unthrottled "Too much
data received" warning. So a client that stops reading its answer but
keeps sending could make a relay hold about 10 MB per stream.

Discard that input instead, and do it immediately: the old code only
cleared the buffer on a later read, so bytes that arrived in the same
read as the request lingered until then. Once directory_handle_command()
has consumed the request and moved the connection to SERVER_WRITING, we
clear the input in that same pass; a still-incomplete request is left in
SERVER_COMMAND_WAIT and kept.

We don't close the connection, so a client that sends a stray CRLF after
its request still gets its answer, and we don't stop reading, since
linked connections only notice EOF while reading. Memory stays bounded
because each read is discarded at once, so we add no byte cap; a client
that streams forever without reading its answer is still closed by the
TestingDirConnectionMaxStall timeout, and the OOM handler still covers
these connections.

As with the previous commit, this limits memory per stream, not in
total. Hardening related to bug 41339; it does not affect the HSDir
fetch flood in that ticket.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 changes/dirserv_extra_input       |   7 ++
 src/feature/dircommon/directory.c |  21 ++++++
 src/test/test_dir_handle_get.c    | 116 ++++++++++++++++++++++++++++++
 3 files changed, 144 insertions(+)
 create mode 100644 changes/dirserv_extra_input

diff --git a/changes/dirserv_extra_input b/changes/dirserv_extra_input
new file mode 100644
index 0000000000..fdde98d2fe
--- /dev/null
+++ b/changes/dirserv_extra_input
@@ -0,0 +1,7 @@
+  o Minor features (directory server, denial of service):
+    - Directory servers now discard anything a client sends after its
+      request, as soon as the request is read, instead of buffering up to
+      10 MB of it per connection while they send their answer. Memory stays
+      bounded because each read is discarded at once; a client that keeps
+      sending without reading its answer is closed by the directory
+      connection stall timeout. Part of ticket 41339.
diff --git a/src/feature/dircommon/directory.c b/src/feature/dircommon/directory.c
index 5b0a6490f0..3f410fc67c 100644
--- a/src/feature/dircommon/directory.c
+++ b/src/feature/dircommon/directory.c
@@ -19,6 +19,7 @@
 #include "feature/dircommon/fp_pair.h"
 #include "feature/hs/hs_cache.h"
 #include "feature/stats/geoip_stats.h"
+#include "lib/buf/buffers.h"
 #include "lib/compress/compress.h"
 
 #include "core/or/circuit_st.h"
@@ -584,6 +585,26 @@ connection_dir_process_inbuf(dir_connection_t *conn)
       connection_mark_for_close(TO_CONN(conn));
       return -1;
     }
+    /* If the request was fully read -- we are now writing the response --
+     * discard anything the client sent after it in this same read, since a
+     * dirserver handles one request per connection. A still-incomplete
+     * request stays in COMMAND_WAIT, so leave it for the next read. */
+    if (conn->base_.state == DIR_CONN_STATE_SERVER_WRITING)
+      buf_clear(TO_CONN(conn)->inbuf);
+    return 0;
+  }
+
+  /* On the server side we are now only writing the response, so discard
+   * anything else the client sends (e.g. in a later read) instead of
+   * buffering it. We don't close the connection, so a client that sends a
+   * stray CRLF after its request still gets its answer, and we don't stop
+   * reading, since linked connections only notice EOF while reading. Memory
+   * stays bounded because each read is discarded at once; a client that keeps
+   * sending without reading its answer is closed by the
+   * TestingDirConnectionMaxStall timeout, and the OOM handler still covers
+   * these connections. */
+  if (DIR_CONN_IS_SERVER(TO_CONN(conn))) {
+    buf_clear(TO_CONN(conn)->inbuf);
     return 0;
   }
 
diff --git a/src/test/test_dir_handle_get.c b/src/test/test_dir_handle_get.c
index a2d6cd4619..edea626d49 100644
--- a/src/test/test_dir_handle_get.c
+++ b/src/test/test_dir_handle_get.c
@@ -2792,6 +2792,117 @@ test_dir_handle_get_hs_post_size_limit(void *data)
   UNMOCK(connection_write_to_buf_impl_);
 }
 
+/* A dirserver handles one request per connection: trailing bytes that arrive
+ * in the same read as a complete request are discarded immediately, and the
+ * connection still gets its answer (not marked for close). */
+static void
+test_dir_handle_get_server_discards_extra_input(void *data)
+{
+  dir_connection_t *conn = new_dir_conn();
+  (void) data;
+
+  MOCK(connection_write_to_buf_impl_, connection_write_to_buf_mock);
+  TO_CONN(conn)->purpose = DIR_PURPOSE_SERVER;
+  TO_CONN(conn)->state = DIR_CONN_STATE_SERVER_COMMAND_WAIT;
+  /* Content-Length bounds the request body, so the trailing bytes survive the
+   * HTTP parser and are what the immediate discard must clear. */
+  buf_add_string(TO_CONN(conn)->inbuf,
+                 "GET / HTTP/1.0\r\nContent-Length: 0\r\n\r\nTRAILING");
+  tt_int_op(connection_dir_process_inbuf(conn), OP_EQ, 0);
+  tt_int_op(TO_CONN(conn)->state, OP_EQ, DIR_CONN_STATE_SERVER_WRITING);
+  tt_size_op(connection_get_inbuf_len(TO_CONN(conn)), OP_EQ, 0);
+  tt_assert(!TO_CONN(conn)->marked_for_close);
+
+ done:
+  UNMOCK(connection_write_to_buf_impl_);
+  connection_free_minimal(TO_CONN(conn));
+}
+
+/* The subsequent-read path: a dirserver already writing its response discards
+ * input that arrives later, and stays open. */
+static void
+test_dir_handle_get_server_discards_later_input(void *data)
+{
+  dir_connection_t *conn = new_dir_conn();
+  (void) data;
+
+  TO_CONN(conn)->purpose = DIR_PURPOSE_SERVER;
+  TO_CONN(conn)->state = DIR_CONN_STATE_SERVER_WRITING;
+  buf_add_string(TO_CONN(conn)->inbuf, "GET / HTTP/1.0\r\n\r\n");
+  tt_int_op(connection_dir_process_inbuf(conn), OP_EQ, 0);
+  tt_size_op(connection_get_inbuf_len(TO_CONN(conn)), OP_EQ, 0);
+  tt_assert(!TO_CONN(conn)->marked_for_close);
+
+ done:
+  connection_free_minimal(TO_CONN(conn));
+}
+
+/* Only servers discard; a directory client keeps what it reads (its response
+ * body), so the discard must be guarded by DIR_CONN_IS_SERVER. */
+static void
+test_dir_handle_get_client_keeps_input(void *data)
+{
+  const char *resp = "HTTP/1.0 200 OK\r\n\r\nbody";
+  dir_connection_t *conn = new_dir_conn();
+  (void) data;
+
+  TO_CONN(conn)->purpose = DIR_PURPOSE_FETCH_CONSENSUS;
+  TO_CONN(conn)->state = DIR_CONN_STATE_CLIENT_READING;
+  buf_add_string(TO_CONN(conn)->inbuf, resp);
+  tt_int_op(connection_dir_process_inbuf(conn), OP_EQ, 0);
+  tt_size_op(connection_get_inbuf_len(TO_CONN(conn)), OP_EQ, strlen(resp));
+
+ done:
+  connection_free_minimal(TO_CONN(conn));
+}
+
+/* A dirserver still waiting for the rest of its command keeps the partial
+ * request: the discard must run after the COMMAND_WAIT handler and only once
+ * the state has moved to SERVER_WRITING. */
+static void
+test_dir_handle_get_server_keeps_partial_command(void *data)
+{
+  const char *partial = "GET / HTTP/1.0\r\n";
+  dir_connection_t *conn = new_dir_conn();
+  (void) data;
+
+  TO_CONN(conn)->purpose = DIR_PURPOSE_SERVER;
+  TO_CONN(conn)->state = DIR_CONN_STATE_SERVER_COMMAND_WAIT;
+  buf_add_string(TO_CONN(conn)->inbuf, partial);
+  tt_int_op(connection_dir_process_inbuf(conn), OP_EQ, 0);
+  tt_int_op(TO_CONN(conn)->state, OP_EQ, DIR_CONN_STATE_SERVER_COMMAND_WAIT);
+  tt_size_op(connection_get_inbuf_len(TO_CONN(conn)), OP_EQ, strlen(partial));
+
+ done:
+  connection_free_minimal(TO_CONN(conn));
+}
+
+/* Policy: the discard is unbounded in how much trailing input it tolerates,
+ * but memory stays bounded because each read is cleared at once, so even more
+ * than the old 10 MB "Too much data" cap is discarded and the connection is
+ * left open. Liveness against a client that streams forever is left to the
+ * dir-connection stall timeout, which we judge sufficient, so we add no byte
+ * cap. */
+static void
+test_dir_handle_get_server_discards_large_input(void *data)
+{
+  const size_t big = 11 * 1024 * 1024; /* over the old 10 MB cap */
+  dir_connection_t *conn = new_dir_conn();
+  char *junk = tor_malloc_zero(big);
+  (void) data;
+
+  TO_CONN(conn)->purpose = DIR_PURPOSE_SERVER;
+  TO_CONN(conn)->state = DIR_CONN_STATE_SERVER_WRITING;
+  buf_add(TO_CONN(conn)->inbuf, junk, big);
+  tt_int_op(connection_dir_process_inbuf(conn), OP_EQ, 0);
+  tt_size_op(connection_get_inbuf_len(TO_CONN(conn)), OP_EQ, 0);
+  tt_assert(!TO_CONN(conn)->marked_for_close);
+
+ done:
+  tor_free(junk);
+  connection_free_minimal(TO_CONN(conn));
+}
+
 #define DIR_HANDLE_CMD(name,flags) \
   { #name, test_dir_handle_get_##name, (flags), NULL, NULL }
 
@@ -2864,5 +2975,10 @@ struct testcase_t dir_handle_get_tests[] = {
   DIR_HANDLE_CMD(parse_accept_encoding, 0),
   DIR_HANDLE_CMD(malformed_warn_ratelim, TT_FORK),
   DIR_HANDLE_CMD(hs_post_size_limit, TT_FORK),
+  DIR_HANDLE_CMD(server_discards_extra_input, TT_FORK),
+  DIR_HANDLE_CMD(server_discards_later_input, 0),
+  DIR_HANDLE_CMD(client_keeps_input, 0),
+  DIR_HANDLE_CMD(server_keeps_partial_command, 0),
+  DIR_HANDLE_CMD(server_discards_large_input, 0),
   END_OF_TESTCASES
 };
