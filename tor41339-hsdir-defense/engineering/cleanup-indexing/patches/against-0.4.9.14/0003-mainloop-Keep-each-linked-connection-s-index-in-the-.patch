diff --git a/changes/mainloop_active_linked_index b/changes/mainloop_active_linked_index
new file mode 100644
index 0000000..f85ce1c
--- /dev/null
+++ b/changes/mainloop_active_linked_index
@@ -0,0 +1,7 @@
+  o Minor features (performance, relay):
+    - Remember where each linked connection is in the list of linked
+      connections with data to move, so that activating or deactivating
+      one, or tearing it down, no longer scans that list. A linked
+      connection is activated and deactivated on every read or write
+      toggle, and a profile of a relay under a flood of BEGIN_DIR streams
+      put half of its main thread's user-space CPU in one such scan.
diff --git a/src/core/mainloop/connection.c b/src/core/mainloop/connection.c
index f5e0929..49cf8e3 100644
--- a/src/core/mainloop/connection.c
+++ b/src/core/mainloop/connection.c
@@ -694,8 +694,9 @@ connection_new(int type, int socket_family)
  *
  * Set conn-\>magic to the correct value.
  *
- * Set conn-\>type to <b>type</b>. Set conn-\>s, conn-\>conn_array_index and
- * conn-\>closeable_conn_index to -1 to signify they are not yet assigned.
+ * Set conn-\>type to <b>type</b>. Set conn-\>s, conn-\>conn_array_index,
+ * conn-\>active_linked_conn_index and conn-\>closeable_conn_index to -1 to
+ * signify they are not yet assigned.
  *
  * Initialize conn's timestamps to now.
  */
@@ -731,6 +732,7 @@ connection_init(time_t now, connection_t *conn, int type, int socket_family)
 
   conn->s = TOR_INVALID_SOCKET; /* give it a default of 'not used' */
   conn->conn_array_index = -1; /* also default to 'not used' */
+  conn->active_linked_conn_index = -1; /* not on the active linked list */
   conn->closeable_conn_index = -1; /* not marked for close */
   conn->global_identifier = n_connections_allocated++;
 
@@ -968,6 +970,7 @@ connection_free_,(connection_t *conn))
   if (!conn)
     return;
   tor_assert(!connection_is_on_closeable_list(conn));
+  tor_assert(!connection_in_active_linked_list(conn));
   /* connection_add() and connection_remove() keep conn_array_index up to
    * date, so this confirms in O(1) that conn has left the array. */
   tor_assert(conn->conn_array_index < 0);
diff --git a/src/core/mainloop/mainloop.c b/src/core/mainloop/mainloop.c
index efc6a37..a6c53b8 100644
--- a/src/core/mainloop/mainloop.c
+++ b/src/core/mainloop/mainloop.c
@@ -168,8 +168,9 @@ STATIC smartlist_t *connection_array = NULL;
  * here in its closeable_conn_index. */
 STATIC smartlist_t *closeable_connection_lst = NULL;
 /** List of linked connections that are currently reading data into their
- * inbuf from their partner's outbuf. */
-static smartlist_t *active_linked_connection_lst = NULL;
+ * inbuf from their partner's outbuf. Each connection on it holds its index
+ * here in its active_linked_conn_index, and has active_on_link set. */
+STATIC smartlist_t *active_linked_connection_lst = NULL;
 /** Flag: Set to true iff we entered the current libevent main loop via
  * <b>loop_once</b>. If so, there's no need to trigger a loopexit in order
  * to handle linked connections. */
@@ -200,7 +201,7 @@ static int can_complete_circuits = 0;
 
 static int conn_close_if_marked(int i);
 static void remove_from_closeable_list(connection_t *conn);
-static void connection_start_reading_from_linked_conn(connection_t *conn);
+static void remove_from_active_linked_list(connection_t *conn);
 static int connection_should_read_from_linked_conn(connection_t *conn);
 static void conn_read_callback(evutil_socket_t fd, short event, void *_conn);
 static void conn_write_callback(evutil_socket_t fd, short event, void *_conn);
@@ -351,7 +352,7 @@ connection_unlink(connection_t *conn)
     conn->linked_conn = NULL;
   }
   remove_from_closeable_list(conn);
-  smartlist_remove(active_linked_connection_lst, conn);
+  remove_from_active_linked_list(conn);
   if (conn->type == CONN_TYPE_EXIT) {
     assert_connection_edge_not_dns_pending(TO_EDGE_CONN(conn));
   }
@@ -473,6 +474,47 @@ connection_in_array(connection_t *conn)
   return smartlist_contains(connection_array, conn);
 }
 
+/** Return 1 if conn is on the active linked connection list, else 0. Checks
+ * the stored index in O(1); asserts it agrees with active_on_link. */
+int
+connection_in_active_linked_list(const connection_t *conn)
+{
+  const int idx = conn->active_linked_conn_index;
+  int on_list;
+
+  if (idx < 0) {
+    tor_assert(idx == -1);
+    on_list = 0;
+  } else {
+    tor_assert(idx < smartlist_len(active_linked_connection_lst));
+    tor_assert(smartlist_get(active_linked_connection_lst, idx) == conn);
+    on_list = 1;
+  }
+  tor_assert(on_list == (int) conn->active_on_link);
+  return on_list;
+}
+
+/** If <b>conn</b> is on the active linked connection list, remove it in
+ * O(1), moving the last connection on the list into its slot as
+ * smartlist_remove() would, and clear active_on_link. */
+static void
+remove_from_active_linked_list(connection_t *conn)
+{
+  const int idx = conn->active_linked_conn_index;
+
+  if (!connection_in_active_linked_list(conn))
+    return;
+  smartlist_del(active_linked_connection_lst, idx);
+  conn->active_linked_conn_index = -1;
+  conn->active_on_link = 0;
+  if (idx < smartlist_len(active_linked_connection_lst)) {
+    connection_t *moved = smartlist_get(active_linked_connection_lst, idx);
+    tor_assert(moved->active_linked_conn_index ==
+               smartlist_len(active_linked_connection_lst));
+    moved->active_linked_conn_index = idx;
+  }
+}
+
 /** Set <b>*array</b> to an array of all connections. <b>*array</b> must not
  * be modified.
  */
@@ -855,7 +897,7 @@ tor_event_loop_shutdown_is_pending(void)
 /** Helper: Tell the main loop to begin reading bytes into <b>conn</b> from
  * its linked connection, if it is not doing so already.  Called by
  * connection_start_reading and connection_start_writing as appropriate. */
-static void
+STATIC void
 connection_start_reading_from_linked_conn(connection_t *conn)
 {
   tor_assert(conn);
@@ -863,10 +905,12 @@ connection_start_reading_from_linked_conn(connection_t *conn)
 
   if (!conn->active_on_link) {
     conn->active_on_link = 1;
+    conn->active_linked_conn_index =
+      smartlist_len(active_linked_connection_lst);
     smartlist_add(active_linked_connection_lst, conn);
     mainloop_event_activate(schedule_active_linked_connections_event);
   } else {
-    tor_assert(smartlist_contains(active_linked_connection_lst, conn));
+    tor_assert(connection_in_active_linked_list(conn));
   }
 }
 
@@ -880,13 +924,9 @@ connection_stop_reading_from_linked_conn(connection_t *conn)
   tor_assert(conn->linked == 1);
 
   if (conn->active_on_link) {
-    conn->active_on_link = 0;
-    /* FFFF We could keep an index here so we can smartlist_del
-     * cleanly.  On the other hand, this doesn't show up on profiles,
-     * so let's leave it alone for now. */
-    smartlist_remove(active_linked_connection_lst, conn);
+    remove_from_active_linked_list(conn);
   } else {
-    tor_assert(!smartlist_contains(active_linked_connection_lst, conn));
+    tor_assert(!connection_in_active_linked_list(conn));
   }
 }
 
