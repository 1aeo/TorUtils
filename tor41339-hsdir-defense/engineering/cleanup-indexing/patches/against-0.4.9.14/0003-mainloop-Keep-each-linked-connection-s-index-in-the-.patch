+   * is not on that list. Mirrors active_on_link. */
+  int active_linked_conn_index;
 
   struct event *read_event; /**< Libevent event structure. */
   struct event *write_event; /**< Libevent event structure. */
diff --git a/src/test/test_mainloop.c b/src/test/test_mainloop.c
index ab3c4aa..c98eed7 100644
--- a/src/test/test_mainloop.c
+++ b/src/test/test_mainloop.c
@@ -414,6 +414,10 @@ check_conn_lists(void)
     tt_int_op(conn->closeable_conn_index, OP_EQ, conn_sl_idx);
     tt_assert(conn->marked_for_close);
   } SMARTLIST_FOREACH_END(conn);
+  SMARTLIST_FOREACH_BEGIN(active_linked_connection_lst, connection_t *, conn) {
+    tt_int_op(conn->active_linked_conn_index, OP_EQ, conn_sl_idx);
+    tt_assert(conn->active_on_link);
+  } SMARTLIST_FOREACH_END(conn);
  done:
   ;
 }
@@ -628,6 +632,98 @@ test_mainloop_closeable_index(void *arg)
   if (SOCKET_OK(fds[1])) tor_close_socket(fds[1]);
 }
 
+/** Test that the active linked connection list keeps every
+ * active_linked_conn_index through additions, removals in any position,
+ * toggling, and linked-peer teardown. */
+static void
+test_mainloop_active_linked_index(void *arg)
+{
+  connection_t *a[4] = { NULL }, *b[4] = { NULL };
+  int i;
+  (void) arg;
+
+  tor_init_connection_lists();
+  initialize_mainloop_events();
+
+  for (i = 0; i < 4; ++i) {
+    make_linked_pair(&a[i], &b[i]);
+    tt_int_op(connection_add(a[i]), OP_EQ, 0);
+    tt_int_op(connection_add(b[i]), OP_EQ, 0);
+    a[i]->writing_to_linked_conn = 1;
+    b[i]->reading_from_linked_conn = 1;
+    buf_add(a[i]->outbuf, "x", 1);
+  }
+
+  /* Activate the four dir sides; indices follow insertion order. */
+  for (i = 0; i < 4; ++i) {
+    connection_start_reading_from_linked_conn(b[i]);
+    tt_int_op(b[i]->active_linked_conn_index, OP_EQ, i);
+    tt_int_op(b[i]->active_on_link, OP_EQ, 1);
+  }
+  tt_int_op(smartlist_len(active_linked_connection_lst), OP_EQ, 4);
+  check_conn_lists();
+
+  /* Starting again is idempotent. */
+  connection_start_reading_from_linked_conn(b[1]);
+  tt_int_op(smartlist_len(active_linked_connection_lst), OP_EQ, 4);
+  tt_int_op(b[1]->active_linked_conn_index, OP_EQ, 1);
+
+  /* Remove the head: the last connection (b[3]) moves into its slot. */
+  connection_stop_reading_from_linked_conn(b[0]);
+  tt_int_op(b[0]->active_linked_conn_index, OP_EQ, -1);
+  tt_int_op(b[0]->active_on_link, OP_EQ, 0);
+  tt_int_op(b[3]->active_linked_conn_index, OP_EQ, 0);
+  check_conn_lists();
+  /* Remove the tail: nothing moves. */
+  connection_stop_reading_from_linked_conn(b[2]);
+  tt_int_op(b[2]->active_linked_conn_index, OP_EQ, -1);
+  tt_int_op(smartlist_len(active_linked_connection_lst), OP_EQ, 2);
+  check_conn_lists();
+  /* Stopping an inactive connection is a no-op. */
+  connection_stop_reading_from_linked_conn(b[2]);
+  tt_int_op(smartlist_len(active_linked_connection_lst), OP_EQ, 2);
+
+  /* Toggle b[0] back on: it appends to the end. */
+  connection_start_reading_from_linked_conn(b[0]);
+  tt_int_op(b[0]->active_linked_conn_index, OP_EQ, 2);
+  tt_int_op(b[0]->active_on_link, OP_EQ, 1);
+  check_conn_lists();
+
+  /* Tearing down the exit side of a pair wakes its still-reading dir side
+   * (so it notices EOF) and takes the exit side off the active list. */
+  connection_start_reading_from_linked_conn(a[1]);
+  tt_assert(connection_in_active_linked_list(a[1]));
+  connection_mark_for_close(a[1]);
+  close_closeable_connections();
+  a[1] = NULL;
+  tt_ptr_op(b[1]->linked_conn, OP_EQ, NULL);
+  tt_int_op(b[1]->active_on_link, OP_EQ, 1);
+  tt_assert(connection_in_active_linked_list(b[1]));
+  check_conn_lists();
+
+  for (i = 0; i < 4; ++i) {
+    if (a[i]) {
+      if (a[i]->active_on_link)
+        connection_stop_reading_from_linked_conn(a[i]);
+      if (a[i]->linked_conn) a[i]->linked_conn->linked_conn = NULL;
+      a[i]->linked_conn = NULL;
+      connection_remove(a[i]); connection_free(a[i]);
+    }
+    if (b[i]) {
+      if (b[i]->active_on_link)
+        connection_stop_reading_from_linked_conn(b[i]);
+      if (b[i]->linked_conn) b[i]->linked_conn->linked_conn = NULL;
+      b[i]->linked_conn = NULL;
+      connection_remove(b[i]); connection_free(b[i]);
+    }
+  }
+  tt_int_op(smartlist_len(active_linked_connection_lst), OP_EQ, 0);
+  tt_int_op(smartlist_len(get_connection_array()), OP_EQ, 0);
+
+ done:
+  ;
+}
+
 #define MAINLOOP_TEST(name) \
   { #name, test_mainloop_## name , TT_FORK, NULL, NULL }
 
@@ -640,5 +736,6 @@ struct testcase_t mainloop_tests[] = {
   MAINLOOP_TEST(dormant_save_state),
   MAINLOOP_TEST(conn_array_index),
