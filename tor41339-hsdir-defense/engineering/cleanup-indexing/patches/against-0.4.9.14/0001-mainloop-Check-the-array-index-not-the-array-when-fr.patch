+/** Make a linked exit and directory connection pair like the one that
+ * connection_exit_connect_dir() makes for a BEGIN_DIR stream, without adding
+ * it to the connection array. */
+static void
+make_linked_pair(connection_t **exit_out, connection_t **dir_out)
+{
+  connection_t *exit_conn = connection_new(CONN_TYPE_EXIT, AF_INET);
+  connection_t *dir_conn = connection_new(CONN_TYPE_DIR, AF_INET);
+
+  exit_conn->state = EXIT_CONN_STATE_OPEN;
+  exit_conn->purpose = EXIT_PURPOSE_CONNECT;
+  exit_conn->address = tor_strdup("127.0.0.1");
+  /* We close it without a circuit: don't warn that it sent no END cell. */
+  TO_EDGE_CONN(exit_conn)->edge_has_sent_end = 1;
+  dir_conn->state = DIR_CONN_STATE_SERVER_COMMAND_WAIT;
+  dir_conn->purpose = DIR_PURPOSE_SERVER;
+  dir_conn->address = tor_strdup("127.0.0.1");
+  connection_link_connections(dir_conn, exit_conn);
+  *exit_out = exit_conn;
+  *dir_out = dir_conn;
+}
+
+/** Independent cross-check of the per-connection list indexes: scan each
+ * global list and confirm every connection's stored index points back to
+ * it. This is the O(len) check the indexes replace in production. */
+static void
+check_conn_lists(void)
+{
+  SMARTLIST_FOREACH_BEGIN(get_connection_array(), connection_t *, conn) {
+    tt_int_op(conn->conn_array_index, OP_EQ, conn_sl_idx);
+  } SMARTLIST_FOREACH_END(conn);
+ done:
+  ;
+}
+
+/** Test that connection_add() and connection_remove() keep every
+ * connection's conn_array_index, through an OOM re-sort of the array, so
+ * that connection_free_() can rely on it. */
+static void
+test_mainloop_conn_array_index(void *arg)
+{
+  connection_t *conns[6] = { NULL };
+  smartlist_t *array;
+  int i;
+  (void) arg;
+
+  tor_init_connection_lists();
+  array = get_connection_array();
+  monotime_enable_test_mocking();
+  monotime_coarse_set_mock_time_nsec(UINT64_C(1000000000));
+
+  for (i = 0; i < 6; i += 2) {
+    make_linked_pair(&conns[i], &conns[i + 1]);
+    tt_int_op(conns[i]->conn_array_index, OP_EQ, -1);
+    tt_int_op(connection_add(conns[i]), OP_EQ, 0);
+    tt_int_op(connection_add(conns[i + 1]), OP_EQ, 0);
+    check_conn_lists();
+  }
+  tt_int_op(smartlist_len(array), OP_EQ, 6);
+
+  /* Removing the last connection moves none. */
+  connection_remove(conns[5]);
+  tt_int_op(conns[5]->conn_array_index, OP_EQ, -1);
+  tt_int_op(connection_is_moribund(conns[5]), OP_EQ, 1);
+  check_conn_lists();
+  /* Removing the head moves the last connection into its place. */
+  connection_remove(conns[0]);
+  tt_int_op(conns[0]->conn_array_index, OP_EQ, -1);
+  tt_ptr_op(smartlist_get(array, 0), OP_EQ, conns[4]);
+  check_conn_lists();
+  /* So does removing one in the middle. */
+  connection_remove(conns[2]);
+  tt_int_op(conns[2]->conn_array_index, OP_EQ, -1);
+  tt_ptr_op(smartlist_get(array, 2), OP_EQ, conns[3]);
+  check_conn_lists();
+  tt_int_op(smartlist_len(array), OP_EQ, 3);
+
+  /* A removed connection can be freed (its index says it is out). */
+  connection_free(conns[5]);
+  connection_free(conns[0]);
+  connection_free(conns[2]);
+
+  /* The OOM handler sorts the array by buffer age, oldest first, and
+   * rewrites every index. Stage buffer ages so the sort reverses the
+   * current order, and check the indexes still match afterwards. */
+  for (i = 0; i < smartlist_len(array); ++i) {
+    connection_t *conn = smartlist_get(array, i);
+    monotime_coarse_set_mock_time_nsec(UINT64_C(1000000000) * (10 - i));
+    buf_add(conn->outbuf, "x", 1);
+  }
+  monotime_coarse_set_mock_time_nsec(UINT64_C(20000000000));
+  get_options_mutable()->MaxMemInQueues = 1000;
+  circuits_handle_oom(2000);
+  tt_ptr_op(smartlist_get(array, 0), OP_EQ, conns[3]);
+  tt_ptr_op(smartlist_get(array, 2), OP_EQ, conns[4]);
+  check_conn_lists();
+
+  while (smartlist_len(array)) {
+    connection_t *conn = smartlist_get(array, 0);
+    connection_remove(conn);
+    check_conn_lists();
+    tt_int_op(conn->conn_array_index, OP_EQ, -1);
+    for (i = 0; i < 6; ++i)
+      if (conns[i] == conn) conns[i] = NULL;
+    connection_free(conn);
+  }
+
+ done:
+  for (i = 0; i < 6; ++i)
+    if (conns[i] && conns[i]->conn_array_index >= 0)
+      connection_remove(conns[i]);
+  monotime_disable_test_mocking();
+}
+
 #define MAINLOOP_TEST(name) \
   { #name, test_mainloop_## name , TT_FORK, NULL, NULL }
 
@@ -379,5 +503,6 @@ struct testcase_t mainloop_tests[] = {
   MAINLOOP_TEST(check_participation),
   MAINLOOP_TEST(dormant_load_state),
   MAINLOOP_TEST(dormant_save_state),
+  MAINLOOP_TEST(conn_array_index),
