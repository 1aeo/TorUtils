From e32850302a23c32fa5f253b1e9fcb705fbc8739b Mon Sep 17 00:00:00 2001
From: 1aeo <github@1aeo.com>
Date: Thu, 22 Oct 2026 22:39:56 -0700
Subject: [PATCH 1/3] mainloop: Check the array index, not the array, when
 freeing a connection

connection_free_() asserted !connection_in_array(conn), which scans the
whole connection array. The connection has always been removed from the
array by then, so every free paid for a full scan of every open
connection. Each BEGIN_DIR stream adds and frees two connections, so
under a flood of them this scan becomes a large part of the main
thread's work: a profile of a relay under such a flood put about 40% of
its main thread's user-space CPU in this one loop.

connection_add() and connection_remove() already keep conn_array_index
up to date for the connections in the array, and connection_remove()
fixes the index of the connection it moves into the freed slot. But it
left the removed connection's own index unchanged. Set it to -1, which
is what connection_is_moribund() and connection_unlink() already take to
mean "not in the array", and check that in connection_free_(). Also
check in O(1) that a connection being removed is where its index says,
since connection_free_() now trusts that index. A unit test cross-checks
the indexes against a full scan of the array, including over an
out-of-memory re-sort.

Co-Authored-By: Claude Opus 4.8 <noreply@anthropic.com>
---
 changes/mainloop_array_index   |   6 ++
 src/core/mainloop/connection.c |   4 +-
 src/core/mainloop/mainloop.c   |   9 ++-
 src/test/test_mainloop.c       | 125 +++++++++++++++++++++++++++++++++
 4 files changed, 141 insertions(+), 3 deletions(-)
 create mode 100644 changes/mainloop_array_index

diff --git a/changes/mainloop_array_index b/changes/mainloop_array_index
new file mode 100644
index 0000000..987bd7e
--- /dev/null
+++ b/changes/mainloop_array_index
@@ -0,0 +1,6 @@
+  o Minor features (performance, relay):
+    - Stop scanning the whole connection array each time we free a
+      connection, to check that it is no longer in the array. Instead,
+      reset a connection's array index when we remove it, and check that.
+      Under a flood of short-lived BEGIN_DIR streams, this scan took a
+      large share of a relay's main-thread CPU.
diff --git a/src/core/mainloop/connection.c b/src/core/mainloop/connection.c
index cd71bb8..cca6631 100644
--- a/src/core/mainloop/connection.c
+++ b/src/core/mainloop/connection.c
@@ -967,7 +967,9 @@ connection_free_,(connection_t *conn))
   if (!conn)
     return;
   tor_assert(!connection_is_on_closeable_list(conn));
-  tor_assert(!connection_in_array(conn));
+  /* connection_add() and connection_remove() keep conn_array_index up to
+   * date, so this confirms in O(1) that conn has left the array. */
+  tor_assert(conn->conn_array_index < 0);
   /* Direct free can bypass normal closure. This releases the channel's guard
    * attribution handle before cleanup callbacks can report another error.
    * Destruction itself is not evidence of establishment failure; any eligible
diff --git a/src/core/mainloop/mainloop.c b/src/core/mainloop/mainloop.c
index 72bfc31..f930642 100644
--- a/src/core/mainloop/mainloop.c
+++ b/src/core/mainloop/mainloop.c
@@ -250,7 +250,7 @@ connection_add_impl(connection_t *conn, int is_connecting)
              (conn->type == CONN_TYPE_AP &&
               TO_EDGE_CONN(conn)->is_dns_request));
 
-  tor_assert(conn->conn_array_index == -1); /* can only connection_add once */
+  tor_assert(conn->conn_array_index == -1); /* can only be in the array once */
   conn->conn_array_index = smartlist_len(connection_array);
   smartlist_add(connection_array, conn);
 
@@ -284,7 +284,8 @@ connection_unregister_events(connection_t *conn)
 
 /** Remove the connection from the global list, and remove the
  * corresponding poll entry.  Calling this function will shift the last
- * connection (if any) into the position occupied by conn.
+ * connection (if any) into the position occupied by conn, and set
+ * conn-\>conn_array_index to -1.
  */
 int
 connection_remove(connection_t *conn)
@@ -306,7 +307,11 @@ connection_remove(connection_t *conn)
 
   tor_assert(conn->conn_array_index >= 0);
   current_index = conn->conn_array_index;
+  tor_assert(current_index < smartlist_len(connection_array));
+  tor_assert(smartlist_get(connection_array, current_index) == conn);
   connection_unregister_events(conn); /* This is redundant, but cheap. */
+  /* connection_free_() checks this to confirm conn has left the array. */
+  conn->conn_array_index = -1;
   if (current_index == smartlist_len(connection_array)-1) { /* at the end */
     smartlist_del(connection_array, current_index);
     return 0;
