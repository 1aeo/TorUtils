+  get_metric(METRICS_NAME(relay_begindir_response_bytes_total), "type", \
+             (type))
+
+/* Response bytes are counted by the type of their request, once it has one,
+ * and only on tunneled connections. */
+static void
+test_dir_response_bytes_metric(void *arg)
+{
+  dir_connection_t *conn = new_waiting_dir_conn(CHANNEL_PREV_HOP_CLIENT,
+                                                NULL);
+  dir_connection_t *dirport = dir_connection_new(AF_INET);
+  const char *types[] = { "hs_get", "hs_post", "consensus", "microdesc",
+                          "descriptor", "other_get", "other_post",
+                          "unparsed", "no_request", "circuit_dead" };
+  int64_t total0 = 0, total = 0, consensus0, hs0;
+  (void) arg;
+
+  for (size_t i = 0; i < ARRAY_LENGTH(types); i++)
+    total0 += RESPONSE_BYTES_METRIC(types[i]);
+  consensus0 = RESPONSE_BYTES_METRIC("consensus");
+  hs0 = RESPONSE_BYTES_METRIC("hs_get");
+
+  /* Not typed yet: not counted. */
+  relay_note_dir_response_bytes(conn, 100);
+  for (size_t i = 0; i < ARRAY_LENGTH(types); i++)
+    total += RESPONSE_BYTES_METRIC(types[i]);
+  tt_i64_op(total, OP_EQ, total0);
+
+  relay_note_dir_request(conn, DIR_REQUEST_CONSENSUS);
+  relay_note_dir_response_bytes(conn, 1000);
+  relay_note_dir_response_bytes(conn, 24);
+  tt_i64_op(RESPONSE_BYTES_METRIC("consensus"), OP_EQ, consensus0 + 1024);
+  tt_i64_op(RESPONSE_BYTES_METRIC("hs_get"), OP_EQ, hs0);
+
+  /* A DirPort connection isn't counted, typed or not. */
+  TO_CONN(dirport)->purpose = DIR_PURPOSE_SERVER;
+  relay_note_dir_request(dirport, DIR_REQUEST_HS_GET);
+  dirport->request_type = DIR_REQUEST_HS_GET + 1;
+  relay_note_dir_response_bytes(dirport, 500);
+  tt_i64_op(RESPONSE_BYTES_METRIC("hs_get"), OP_EQ, hs0);
+
+ done:
+  connection_free_minimal(TO_CONN(conn));
+  connection_free_minimal(TO_CONN(dirport));
+}
