@@ -1394,12 +1405,41 @@ static const char *const dir_request_names[] = {
 void
 relay_note_dir_request(dir_connection_t *conn, dir_request_type_t type)
 {
-  if (!TO_CONN(conn)->linked || conn->request_counted)
+  if (!TO_CONN(conn)->linked || conn->request_type)
     return;
-  conn->request_counted = 1;
+  conn->request_type = type + 1;
   dir_requests[type][conn->prev_hop]++;
 }
 
+/** Tunneled directory response bytes their stream read, by the type of their
+ * request. Bytes still queued when the directory connection closes, which
+ * conn_close_if_marked() moves to the stream unread, aren't counted. */
+static uint64_t dir_response_bytes[DIR_REQUEST_TYPE_COUNT];
+/* A directory connection keeps one more than its request type in four
+ * bits. */
+CTASSERT(DIR_REQUEST_TYPE_COUNT < 16);
+
+/** Count <b>n</b> bytes of the response on the tunneled directory server
+ * connection <b>conn</b> that its stream has just taken, by the type of its
+ * request. DirPort connections aren't counted. */
+void
+relay_note_dir_response_bytes(const dir_connection_t *conn, size_t n)
+{
+  if (!conn->base_.linked || !conn->request_type)
+    return;
+  dir_response_bytes[conn->request_type - 1] += n;
+}
+
+/** Fill function for the RELAY_METRICS_NUM_BEGINDIR_RESPONSE_BYTES metric. */
+static void
+fill_begindir_response_bytes_values(void)
+{
+  fill_labeled_values(
+               &base_metrics[RELAY_METRICS_NUM_BEGINDIR_RESPONSE_BYTES],
+               NULL, NULL, "type", dir_request_names, dir_response_bytes,
+               DIR_REQUEST_TYPE_COUNT);
+}
+
 /** Fill function for the RELAY_METRICS_NUM_BEGINDIR_REQUESTS metric. */
 static void
 fill_begindir_request_values(void)
