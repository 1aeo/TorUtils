 }
 
+/** Return false if we refuse the onion service directory request on
+ * <b>conn</b>, which note_hs_dir_request() has counted: if
+ * HSDirOneRequestPerCircuit applies, we close a circuit on its second
+ * request; else if HSDirRefuseUnknownPrevHop applies, we answer a request
+ * whose previous hop is not a known relay with a 503. Relays fetching other
+ * documents over one-hop circuits legitimately reuse them, so neither rule
+ * covers those. */
+static bool
+allow_hs_dir_request(dir_connection_t *conn)
+{
+  or_circuit_t *circ =
+    TO_OR_CIRCUIT(TO_EDGE_CONN(TO_CONN(conn)->linked_conn)->on_circuit);
+
+  if (circ->n_hsdir_requests > 1 && dos_should_close_reused_hsdir_circ()) {
+    static ratelim_t reuse_lim = RATELIM_INIT(600);
+    log_fn_ratelim(&reuse_lim, LOG_PROTOCOL_WARN, LD_REND,
+                   "Closing a circuit that made more than one onion service "
+                   "directory request.");
+    circuit_mark_for_close(TO_CIRCUIT(circ), END_CIRC_REASON_RESOURCELIMIT);
+    return false;
+  }
+  if (dos_should_refuse_unknown_hsdir_prev_hop() &&
+      !connection_or_digest_is_known_relay(circ->p_chan->identity_digest)) {
+    static ratelim_t prev_hop_lim = RATELIM_INIT(600);
+    log_fn_ratelim(&prev_hop_lim, LOG_PROTOCOL_WARN, LD_REND,
+                   "Refusing an onion service directory request from unknown "
+                   "relay %s.", safe_str(channel_describe_peer(circ->p_chan)));
+    write_short_http_response(conn, 503, "Rejecting HS request: previous hop "
+                              "is not a known relay");
+    return false;
+  }
+  return true;
+}
+
 /** Helper function for GET `/tor/hs/3/...`. Only for version 3.
  */
 STATIC int
@@ -1404,6 +1438,10 @@ handle_get_hs_descriptor_v3(dir_connection_t *conn,
     goto done;
   }
   note_hs_dir_request(conn);
+  if (!allow_hs_dir_request(conn)) {
+    relay_increment_hsdir_get_action(HSDIR_GET_REFUSED);
+    goto done;
+  }
 
   /* After the path prefix follows the base64 encoded blinded pubkey which we
    * use to get the descriptor from the cache. Skip the prefix and get the
@@ -1666,6 +1704,10 @@ directory_handle_command_post,(dir_connection_t *conn, const char *headers,
       goto done;
     }
     note_hs_dir_request(conn);
+    if (!allow_hs_dir_request(conn)) {
+      relay_increment_hsdir_post_action(HSDIR_POST_REFUSED);
+      goto done;
+    }
     const char *msg = "HS descriptor stored successfully.";
 
     /* We most probably have a publish request for an HS descriptor. */
