+  MOCK(connection_write_to_buf_impl_, connection_write_to_buf_mock);
+  MOCK(circuit_mark_for_close_, mock_circuit_mark_for_close);
+  MOCK(channel_describe_peer, mock_channel_describe_peer);
+  mock_hsdir_ns = tor_malloc_zero(sizeof(networkstatus_t));
+  mock_hsdir_ns->net_params = smartlist_new();
+  mock_hsdir_ns->routerstatus_list = smartlist_new();
+  MOCK(networkstatus_get_latest_consensus, mock_hsdir_get_latest_consensus);
+  get_options_mutable()->ORPort_set = 1;
+  dos_opts = get_dos_options(get_options_mutable());
+  memset(&known_rs, 0, sizeof(known_rs)); /* Matches the zeroed identity. */
+  get_refused = GET_METRIC("refused");
+  post_refused = POST_METRIC("refused");
+  requests = dos_get_dir_stat(DOS_DIR_HSDIR_REQUEST);
+
+  /* By default, a repeat request from an unknown relay is served. */
+  circ = or_circuit_new(0, NULL);
+  circ->p_chan = chan;
+  hsdir_request_on_circ(circ, get, NULL);
+  hsdir_request_on_circ(circ, get, NULL);
+  tt_assert(!strcmpstart(hsdir_reply, "HTTP/1.0 404 "));
+  tt_int_op(TO_CIRCUIT(circ)->marked_for_close, OP_EQ, 0);
+
+  /* The consensus can refuse unknown previous hops, but not known ones. */
+  smartlist_add_strdup(mock_hsdir_ns->net_params,
+                       "HSDirRefuseUnknownPrevHop=1");
+  circ = or_circuit_new(0, NULL);
+  circ->p_chan = chan;
+  hsdir_request_on_circ(circ, get, NULL);
+  expect_refused(circ, false);
+  circ = or_circuit_new(0, NULL);
+  circ->p_chan = chan;
+  hsdir_request_on_circ(circ, post, "x");
+  expect_refused(circ, false);
+  smartlist_add(mock_hsdir_ns->routerstatus_list, &known_rs);
+  hsdir_request_on_new_circ(chan, get, NULL);
+  tt_assert(!strcmpstart(hsdir_reply, "HTTP/1.0 404 "));
+  smartlist_clear(mock_hsdir_ns->routerstatus_list);
+  /* The torrc overrides the consensus, either way. */
+  dos_opts->HSDirRefuseUnknownPrevHop = 0;
+  hsdir_request_on_new_circ(chan, get, NULL);
+  tt_assert(!strcmpstart(hsdir_reply, "HTTP/1.0 404 "));
+  SMARTLIST_FOREACH(mock_hsdir_ns->net_params, char *, cp, tor_free(cp));
+  smartlist_clear(mock_hsdir_ns->net_params);
+  dos_opts->HSDirRefuseUnknownPrevHop = 1;
+  circ = or_circuit_new(0, NULL);
+  circ->p_chan = chan;
+  hsdir_request_on_circ(circ, get, NULL);
+  expect_refused(circ, false);
+  dos_opts->HSDirRefuseUnknownPrevHop = 0;
+
+  /* Closing reused circuits, from the consensus or the torrc: the second
+   * request gets no answer. */
+  smartlist_add_strdup(mock_hsdir_ns->net_params,
+                       "HSDirOneRequestPerCircuit=1");
+  circ = or_circuit_new(0, NULL);
+  circ->p_chan = chan;
+  hsdir_request_on_circ(circ, get, NULL);
+  tt_int_op(TO_CIRCUIT(circ)->marked_for_close, OP_EQ, 0);
+  hsdir_request_on_circ(circ, get, NULL);
+  expect_refused(circ, true);
+  SMARTLIST_FOREACH(mock_hsdir_ns->net_params, char *, cp, tor_free(cp));
+  smartlist_clear(mock_hsdir_ns->net_params);
+  dos_opts->HSDirOneRequestPerCircuit = 1;
+  circ = or_circuit_new(0, NULL);
+  circ->p_chan = chan;
+  hsdir_request_on_circ(circ, get, NULL);
+  hsdir_request_on_circ(circ, post, "x");
+  expect_refused(circ, true);
+  /* With both enabled, a reused circuit is closed rather than answered. */
+  dos_opts->HSDirRefuseUnknownPrevHop = 1;
+  circ = or_circuit_new(0, NULL);
+  circ->p_chan = chan;
+  hsdir_request_on_circ(circ, get, NULL);
+  expect_refused(circ, false);
+  hsdir_request_on_circ(circ, get, NULL);
+  expect_refused(circ, true);
+
+  /* Every request was counted, and the 7 refused ones as refused. */
+  tt_u64_op(dos_get_dir_stat(DOS_DIR_HSDIR_REQUEST), OP_EQ, requests + 13);
+  tt_i64_op(GET_METRIC("refused"), OP_EQ, get_refused + 5);
+  tt_i64_op(POST_METRIC("refused"), OP_EQ, post_refused + 2);
+
+  /* Relays that aren't public never refuse. */
+  get_options_mutable()->ORPort_set = 0;
+  tt_int_op(dos_should_close_reused_hsdir_circ(), OP_EQ, 0);
+  tt_int_op(dos_should_refuse_unknown_hsdir_prev_hop(), OP_EQ, 0);
+
+ done:
+  UNMOCK(connection_write_to_buf_impl_);
+  UNMOCK(circuit_mark_for_close_);
+  UNMOCK(channel_describe_peer);
+  UNMOCK(networkstatus_get_latest_consensus);
+  SMARTLIST_FOREACH(mock_hsdir_ns->net_params, char *, cp, tor_free(cp));
+  smartlist_free(mock_hsdir_ns->net_params);
+  smartlist_free(mock_hsdir_ns->routerstatus_list);
+  tor_free(mock_hsdir_ns);
+  SMARTLIST_FOREACH(circuit_get_global_list(), circuit_t *, c,
+                    TO_OR_CIRCUIT(c)->p_chan = NULL);
+  circuit_free_all();
+  tor_free(hsdir_reply);
+  tor_free(chan);
+}
