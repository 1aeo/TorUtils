+/* Make a tunneled directory server connection waiting for a request on a
+ * circuit whose previous hop is of kind <b>prev_hop</b>, with <b>input</b>
+ * (if any) on its inbuf. */
+static dir_connection_t *
+new_waiting_dir_conn(channel_prev_hop_t prev_hop, const char *input)
+{
+  dir_connection_t *conn = dir_connection_new(AF_INET);
