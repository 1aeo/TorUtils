+/* An onion service request refused as not anonymous is counted as the GET or
+ * POST it was: single_hop if its previous hop is a client, else
+ * circuit_dead. Each request is checked alone, so that swapped outcomes
+ * can't cancel out. */
+static void
+test_hsdir_not_anonymous_actions(void *arg)
+{
+  const struct {
+    channel_prev_hop_t hop;
+    bool is_post;
+    const char *action;
+  } reqs[] = {
+    { CHANNEL_PREV_HOP_CLIENT, false, "single_hop" },
+    { CHANNEL_PREV_HOP_KNOWN_RELAY, false, "circuit_dead" },
+    { CHANNEL_PREV_HOP_CLIENT, true, "single_hop" },
+    { CHANNEL_PREV_HOP_UNKNOWN_RELAY, true, "circuit_dead" },
+  };
+  const char *actions[] = { "single_hop", "circuit_dead" };
+  dir_connection_t *conn = NULL;
+  (void) arg;
+
+  for (size_t i = 0; i < ARRAY_LENGTH(reqs); i++) {
+    int64_t get0[2], post0[2];
+    for (int a = 0; a < 2; a++) {
+      get0[a] = GET_METRIC(actions[a]);
+      post0[a] = POST_METRIC(actions[a]);
+    }
+    conn = new_waiting_dir_conn(reqs[i].hop, NULL);
+    relay_note_hsdir_not_anonymous(conn, reqs[i].is_post);
+    connection_free_minimal(TO_CONN(conn));
+    conn = NULL;
+    for (int a = 0; a < 2; a++) {
+      const int hit = !strcmp(actions[a], reqs[i].action);
+      tt_i64_op(GET_METRIC(actions[a]), OP_EQ,
+                get0[a] + (hit && !reqs[i].is_post));
+      tt_i64_op(POST_METRIC(actions[a]), OP_EQ,
+                post0[a] + (hit && reqs[i].is_post));
+    }
+  }
+
+ done:
+  if (conn)
+    connection_free_minimal(TO_CONN(conn));
+}
