--- a/src/core/or/dos.c
+++ b/src/core/or/dos.c
@@ -751,6 +751,29 @@ dos_should_refuse_unknown_hsdir_prev_hop(void)
                              "HSDirRefuseUnknownPrevHop");
 }
 
+/** Take a token from <b>bucket</b>, the fetch rate limiter of a cached onion
+ * service descriptor, and count the fetch if it was empty. */
+void
+dos_hsdir_note_desc_fetch(token_bucket_ctr_t *bucket)
+{
+  const dos_options_t *options = dos_get_options();
+  const uint32_t rate = MAX(options->HSDirDescriptorFetchRate, 1);
+  const uint32_t burst = MAX(options->HSDirDescriptorFetchBurst, 1);
+  const uint32_t now = (uint32_t) monotime_coarse_absolute_sec();
+
+  if (!bucket->cfg.rate) {
+    token_bucket_ctr_init(bucket, rate, burst, now);
+  } else if (bucket->cfg.rate != rate ||
+             (uint32_t) bucket->cfg.burst != burst) {
+    token_bucket_ctr_adjust(bucket, rate, burst);
+  }
+  token_bucket_ctr_refill(bucket, now);
+  if (token_bucket_ctr_get(bucket) > 0)
+    token_bucket_ctr_dec(bucket, 1);
+  else
+    dos_note_dir_stat(DOS_DIR_HSDIR_FETCH_OVER_RATE);
+}
