From 0ca736187af84ae276df38c3b35e93764d4d2b90 Mon Sep 17 00:00:00 2001
From: 1aeo <github@1aeo.com>
Date: Wed, 14 Oct 2026 01:49:22 +0000
Subject: [PATCH 02/20] dirserv: Don't buffer request bodies larger than an HS
 descriptor

A relay that is not a directory authority accepts only one kind of
upload: an onion service descriptor POSTed to /tor/hs/. Every other POST
gets a 400, and the GET handlers ignore the body. Yet
directory_handle_command() let any request buffer a body of up to
MAX_DIR_UL_SIZE (16 MB) on every relay.

On non-authorities, limit the body to hs_cache_get_max_descriptor_size()
(the HSV3MaxDescriptorSize consensus parameter), capped at
MAX_DIR_UL_SIZE. hs_desc_decode_plaintext() already rejects descriptors
of that size, so this refuses no descriptor it would accept, except one
with bytes after Content-Length or after a NUL; tor sends neither.
Authorities, including bridge authorities, keep the 16 MB limit.

An oversized upload to a non-authority is now closed without an HTTP
status instead of getting a 400, so a C tor onion service logs no
HS_DESC FAILED event for it.

This limits buffering per stream, not in total: DoSBeginDirRate limits
how fast each circuit opens BEGIN_DIR streams, not how many circuits
open them, so many streams can still hold memory until the OOM handler
or the directory connection stall timeout frees it.

Part of #41339.
---
 changes/ticket41339_hardening   |  6 +++++
 src/feature/dircache/dircache.c |  7 +++++-
 src/test/test_dir_handle_get.c  | 40 +++++++++++++++++++++++++++++++++
 3 files changed, 52 insertions(+), 1 deletion(-)
 create mode 100644 changes/ticket41339_hardening

diff --git a/changes/ticket41339_hardening b/changes/ticket41339_hardening
new file mode 100644
index 0000000000..4251350e5f
--- /dev/null
+++ b/changes/ticket41339_hardening
@@ -0,0 +1,6 @@
+  o Minor features (directory server, denial-of-service):
+    - Relays that are not directory authorities now close, without an answer,
+      a directory request whose body is too large to be an onion service
+      descriptor, the only upload they accept, instead of buffering up to 16 MB
+      of it. The limit is the HSV3MaxDescriptorSize consensus parameter. Part
+      of ticket 41339.
diff --git a/src/feature/dircache/dircache.c b/src/feature/dircache/dircache.c
index 61e47f018a..4c1bc169ba 100644
--- a/src/feature/dircache/dircache.c
+++ b/src/feature/dircache/dircache.c
@@ -1840,10 +1840,15 @@ directory_handle_command(dir_connection_t *conn)
   if (dir_conn_is_closing(conn)) {
     return -1;
   }
+  /* Non-authorities only accept HS descriptor posts, so don't buffer a body
+   * that is too large to be one. Authorities keep the 16 MB limit. */
+  size_t max_body_len = hs_cache_get_max_descriptor_size();
+  if (authdir_mode(get_options()) || max_body_len > MAX_DIR_UL_SIZE)
+    max_body_len = MAX_DIR_UL_SIZE;
 
   switch (connection_fetch_from_buf_http(TO_CONN(conn),
                               &headers, MAX_HEADERS_SIZE,
-                              &body, &body_len, MAX_DIR_UL_SIZE, 0)) {
+                              &body, &body_len, max_body_len, 0)) {
     case -1: /* overflow */
       log_fn_ratelim(&warning_limit, LOG_WARN, LD_DIRSERV,
                      "Oversized or malformed directory request from %s. "
diff --git a/src/test/test_dir_handle_get.c b/src/test/test_dir_handle_get.c
index a529ed7afb..7bd455e514 100644
--- a/src/test/test_dir_handle_get.c
+++ b/src/test/test_dir_handle_get.c
@@ -36,6 +36,7 @@
 #include "feature/dircache/dirserv.h"
 #include "feature/dirauth/dirvote.h"
 #include "test/log_test_helpers.h"
+#include "feature/hs/hs_cache.h"
 #include "feature/dirauth/voting_schedule.h"
 
 #include "feature/dircommon/dir_connection_st.h"
@@ -2747,6 +2748,44 @@ test_dir_handle_get_malformed_warn_ratelim(void *data)
     connection_free_minimal(TO_CONN(conn));
 }
 
+/* Return directory_handle_command()'s result for an HS descriptor POST that
+ * declares a Content-Length of <b>declared</b> and sends <b>len</b> body
+ * bytes. */
+static int
+handle_hs_post(size_t declared, size_t len)
+{
+  dir_connection_t *conn = new_dir_conn();
+  char *body = tor_malloc_zero(len);
+  buf_add_printf(TO_CONN(conn)->inbuf, "POST /tor/hs/3/publish HTTP/1.0\r\n"
+                 "Content-Length: %"TOR_PRIuSZ"\r\n\r\n", declared);
+  buf_add(TO_CONN(conn)->inbuf, body, len);
+  int r = directory_handle_command(conn);
+  tor_free(body);
+  connection_free_minimal(TO_CONN(conn));
+  return r;
+}
+
+/* Non-authorities refuse a request body too large to be an HS descriptor. */
+static void
+test_dir_handle_get_hs_post_size_limit(void *data)
+{
+  const size_t max_len = hs_cache_get_max_descriptor_size();
+  (void) data;
+
+  MOCK(connection_write_to_buf_impl_, connection_write_to_buf_mock);
+  /* A body just under the limit is read; one that reaches it is refused. */
+  tt_int_op(handle_hs_post(max_len - 1, max_len - 1), OP_EQ, 0);
+  tt_int_op(handle_hs_post(max_len, max_len), OP_EQ, -1);
+#ifdef HAVE_MODULE_DIRAUTH
+  /* Authorities keep the 16 MB limit. */
+  get_options_mutable()->AuthoritativeDir = 1;
+  tt_int_op(handle_hs_post(max_len, max_len), OP_EQ, 0);
+#endif
+
+ done:
+  UNMOCK(connection_write_to_buf_impl_);
+}
+
 #define DIR_HANDLE_CMD(name,flags) \
   { #name, test_dir_handle_get_##name, (flags), NULL, NULL }
 
@@ -2818,5 +2857,6 @@ struct testcase_t dir_handle_get_tests[] = {
   DIR_HANDLE_CMD(status_vote_next_consensus_signatures, 0),
   DIR_HANDLE_CMD(parse_accept_encoding, 0),
   DIR_HANDLE_CMD(malformed_warn_ratelim, TT_FORK),
+  DIR_HANDLE_CMD(hs_post_size_limit, TT_FORK),
   END_OF_TESTCASES
 };
