From 4b6090cf7dbbe9f0eff5fac20040fe9221af0d52 Mon Sep 17 00:00:00 2001
From: 1aeo <github@1aeo.com>
Date: Fri, 23 Oct 2026 16:33:58 +0000
Subject: [PATCH] config: Accept HSDirDescriptorFetchLimit as a deprecated
 HSDirFetchShedding

Debian packaging only, not for upstream. +tor41339.6 called the option
HSDirFetchShedding "HSDirDescriptorFetchLimit". Keep that name working,
with a warning that it is deprecated, so that a relay whose torrc still
sets it keeps starting after an upgrade to +tor41339.7. As with tor's
other deprecated names, the torrc, the command line, SETCONF and
RESETCONF accept it, GETCONF answers for it as if it were unset, and
SAVECONF writes the new name.
---
 src/app/config/config.c | 1 +
 1 file changed, 1 insertion(+)

diff --git a/src/app/config/config.c b/src/app/config/config.c
index aac79aa530..700a8b55c2 100644
--- a/src/app/config/config.c
+++ b/src/app/config/config.c
@@ -238,6 +238,7 @@ static const config_abbrev_t option_abbrevs_[] = {
   { "SocksSocketsGroupWritable", "UnixSocksGroupWritable", 0, 1},
   { "_HSLayer2Nodes", "HSLayer2Nodes", 0, 1 },
   { "_HSLayer3Nodes", "HSLayer3Nodes", 0, 1 },
+  { "HSDirDescriptorFetchLimit", "HSDirFetchShedding", 0, 1 },
 
   DOWNLOAD_SCHEDULE(ClientBootstrapConsensusAuthority),
   DOWNLOAD_SCHEDULE(ClientBootstrapConsensusAuthorityOnly),
-- 
2.43.0

