 src/core/or/dos.c                 | 24 ++++++++++++-
 src/core/or/dos.h                 |  5 ++-
 src/core/or/or_circuit_st.h       |  2 ++
 src/feature/relay/relay_metrics.c |  2 ++
 src/test/test_dos.c               | 56 +++++++++++++++++++++++++++++++
 6 files changed, 92 insertions(+), 2 deletions(-)

diff --git a/changes/ticket41339_metrics b/changes/ticket41339_metrics
index 1674c8d332..d31cc23c86 100644
--- a/changes/ticket41339_metrics
+++ b/changes/ticket41339_metrics
@@ -67,3 +67,8 @@
       HSDirRefuseUnknownPrevHop treats these as known: the count shows how much
       traffic comes from relays that recently left the consensus. Part of
       ticket 41339.
+    - Count the BEGIN_DIR cells that DoSStreamCreationRate and
+      DoSStreamCreationBurst would refuse on their circuit if they applied to
+      BEGIN_DIR cells as they do to BEGIN and RESOLVE cells, as
+      tor_relay_dos_total{type="begindir_over_stream_rate"}, while a
+      MetricsPort is configured. Nothing is refused. Part of ticket 41339.
diff --git a/src/core/or/dos.c b/src/core/or/dos.c
index 052f310911..a5323ae7c4 100644
--- a/src/core/or/dos.c
+++ b/src/core/or/dos.c
@@ -1101,17 +1101,36 @@ dos_stream_new_begin_or_resolve_cell(or_circuit_t *circ)
   return dos_stream_defense_type;
 }
 
+/** Count a BEGIN_DIR cell on <b>circ</b> that DoSStreamCreationRate and
+ * Burst would refuse if they limited BEGIN_DIR cells as they do RELAY_BEGIN
+ * and RELAY_RESOLVE cells, whether or not DoSStreamCreationEnabled is set.
+ * Only the MetricsPort shows this count, so we keep it only with one. */
+static void
+dos_note_begindir_stream_rate(or_circuit_t *circ)
+{
+  if (!get_options()->MetricsPort_set)
+    return;
+  token_bucket_ctr_refill(&circ->begindir_limiter,
+                          (uint32_t) monotime_coarse_absolute_sec());
+  if (token_bucket_ctr_get(&circ->begindir_limiter) > 0)
+    token_bucket_ctr_dec(&circ->begindir_limiter, 1);
+  else
+    dos_note_dir_stat(DOS_DIR_BEGINDIR_OVER_STREAM_RATE);
+}
+
 /** Return true iff we should refuse a BEGIN_DIR cell on <b>circ</b> because it
  * already has DoSBeginDirMaxStreams open directory streams. We count such
  * cells, and mark their <b>stream</b> if not NULL, even when
  * DoSBeginDirLimitEnabled is off. */
 bool
-dos_should_refuse_begindir(const or_circuit_t *circ, edge_connection_t *stream)
+dos_should_refuse_begindir(or_circuit_t *circ, edge_connection_t *stream)
 {
   const dos_options_t *options = dos_get_options();
   int max = options->DoSBeginDirMaxStreams;
   int n = 0;
 
+  dos_note_begindir_stream_rate(circ);
+
   if (!max) {
     max = networkstatus_get_param(NULL, "DoSBeginDirMaxStreams",
                                   DOS_BEGINDIR_MAX_STREAMS_DEFAULT,
@@ -1138,6 +1157,9 @@ dos_stream_init_circ_tbf(or_circuit_t *circ)
   token_bucket_ctr_init(&circ->stream_limiter, dos_stream_rate,
                         dos_stream_burst,
                         (uint32_t) monotime_coarse_absolute_sec());
+  token_bucket_ctr_init(&circ->begindir_limiter, dos_stream_rate,
+                        dos_stream_burst,
+                        (uint32_t) monotime_coarse_absolute_sec());
 }
 
 /* General API */
