diff --git a/src/test/test_dos.c b/src/test/test_dos.c
index 2926a84ff5..e9df8030f5 100644
--- a/src/test/test_dos.c
+++ b/src/test/test_dos.c
@@ -803,6 +803,60 @@ test_dos_begindir_max_streams(void *arg)
     connection_free_minimal(TO_CONN(stream));
 }
 
+/** Test that BEGIN_DIR cells over their circuit's stream creation rate are
+ * counted, but never refused, whether or not the stream limit is on, and
+ * only with a MetricsPort. */
+static void
+test_dos_begindir_over_stream_rate(void *arg)
+{
+  dos_options_t *dos_opts = get_dos_options(get_options_mutable());
+  or_circuit_t *circ = NULL;
+  uint64_t over0 = dos_get_dir_stat(DOS_DIR_BEGINDIR_OVER_STREAM_RATE);
+  uint64_t max0 = dos_get_dir_stat(DOS_DIR_BEGINDIR_OVER_MAX);
+  (void) arg;
+
+  monotime_enable_test_mocking();
+  monotime_coarse_set_mock_time_nsec(1000000000);
+  dos_opts->DoSStreamCreationRate = 1;
+  dos_opts->DoSStreamCreationBurst = 2;
+  dos_opts->DoSStreamCreationEnabled = 0;
+  dos_init();
+  circ = or_circuit_new(0, NULL);
+
+  /* Without a MetricsPort, the bucket is left alone. */
+  for (int i = 0; i < 3; i++)
+    tt_assert(!dos_should_refuse_begindir(circ, NULL));
+  tt_u64_op(dos_get_dir_stat(DOS_DIR_BEGINDIR_OVER_STREAM_RATE), OP_EQ,
+            over0);
+  get_options_mutable()->MetricsPort_set = 1;
+  for (int i = 0; i < 3; i++)
+    tt_assert(!dos_should_refuse_begindir(circ, NULL));
+  tt_u64_op(dos_get_dir_stat(DOS_DIR_BEGINDIR_OVER_STREAM_RATE), OP_EQ,
+            over0 + 1);
+  /* One more token a second later. */
+  monotime_coarse_set_mock_time_nsec(2000000000);
+  tt_assert(!dos_should_refuse_begindir(circ, NULL));
+  tt_u64_op(dos_get_dir_stat(DOS_DIR_BEGINDIR_OVER_STREAM_RATE), OP_EQ,
+            over0 + 1);
+  tt_assert(!dos_should_refuse_begindir(circ, NULL));
+  tt_u64_op(dos_get_dir_stat(DOS_DIR_BEGINDIR_OVER_STREAM_RATE), OP_EQ,
+            over0 + 2);
+  /* BEGIN_DIR cells leave the RELAY_BEGIN bucket alone. */
+  tt_int_op(token_bucket_ctr_get(&circ->stream_limiter), OP_EQ, 2);
+  /* They are counted apart from BEGIN_DIR cells over DoSBeginDirMaxStreams,
+   * and exported. */
+  tt_u64_op(dos_get_dir_stat(DOS_DIR_BEGINDIR_OVER_MAX), OP_EQ, max0);
+  tt_i64_op(get_dos_metric("begindir_over_stream_rate"), OP_EQ, over0 + 2);
+
+ done:
+  get_options_mutable()->MetricsPort_set = 0;
+  dos_opts->DoSStreamCreationRate = 0;
+  dos_opts->DoSStreamCreationBurst = 0;
+  dos_opts->DoSStreamCreationEnabled = -1;
+  circuit_free_all();
+  monotime_disable_test_mocking();
+}
+
 static int n_connected = 0, n_end = 0, end_reason = 0;
 static int
 mock_relay_send_command_from_edge(streamid_t stream_id, circuit_t *circ,
@@ -1449,6 +1503,8 @@ struct testcase_t dos_tests[] = {
   { "begindir_max_streams", test_dos_begindir_max_streams, TT_FORK,
     NULL, NULL },
   { "begindir_refused", test_dos_begindir_refused, TT_FORK, NULL, NULL },
+  { "begindir_over_stream_rate", test_dos_begindir_over_stream_rate, TT_FORK,
+    NULL, NULL },
   { "create_cell_prev_hop", test_dos_create_cell_prev_hop, TT_FORK,
     NULL, NULL },
   { "begindir_nth", test_dos_begindir_nth, TT_FORK, NULL, NULL },
