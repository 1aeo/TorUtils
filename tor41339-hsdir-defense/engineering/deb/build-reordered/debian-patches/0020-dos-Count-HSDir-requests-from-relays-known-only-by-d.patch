diff --git a/src/feature/dircache/dircache.c b/src/feature/dircache/dircache.c
index 4fc210e7a6..6813d2d47c 100644
--- a/src/feature/dircache/dircache.c
+++ b/src/feature/dircache/dircache.c
@@ -1435,16 +1435,21 @@ hsdir_request_allowed_on_circuit(dir_connection_t *conn)
 
 /** Count the onion service directory request on <b>conn</b>, which
  * connection_dir_is_anonymous() and hsdir_request_allowed_on_circuit()
- * accepted, if its previous hop is not a known relay. Stock tor and Arti
- * build those circuits through relays in the consensus. */
+ * accepted, if its previous hop is not a known relay, or is one we know only
+ * by its descriptor. Stock tor and Arti build those circuits through relays
+ * in the consensus. */
 static void
 note_hs_dir_request(dir_connection_t *conn)
 {
   const or_circuit_t *circ =
     TO_OR_CIRCUIT(TO_EDGE_CONN(TO_CONN(conn)->linked_conn)->on_circuit);
 
-  if (!connection_or_digest_is_known_relay(circ->p_chan->identity_digest))
-    dos_note_dir_stat(DOS_DIR_HSDIR_UNKNOWN_PREV_HOP);
+  /* connection_or_digest_is_known_relay(), with its two cases apart. */
+  if (!router_get_consensus_status_by_id(circ->p_chan->identity_digest)) {
+    dos_note_dir_stat(router_get_by_id_digest(circ->p_chan->identity_digest) ?
+                      DOS_DIR_HSDIR_DESCRIPTOR_ONLY_PREV_HOP :
+                      DOS_DIR_HSDIR_UNKNOWN_PREV_HOP);
+  }
 }
 
