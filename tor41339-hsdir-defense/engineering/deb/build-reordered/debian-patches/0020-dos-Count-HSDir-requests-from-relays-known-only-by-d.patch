 changes/ticket41339_metrics       |  6 ++++++
 doc/man/tor.1.txt                 |  9 ++++++---
 src/core/or/dos.h                 |  3 +++
 src/feature/dircache/dircache.c   |  9 +++++++--
 src/feature/relay/relay_metrics.c |  2 ++
 src/test/test_hs_cache.c          | 21 +++++++++++++++++++++
 6 files changed, 45 insertions(+), 5 deletions(-)

diff --git a/changes/ticket41339_metrics b/changes/ticket41339_metrics
index 4a75da1ac6..6f75d02749 100644
--- a/changes/ticket41339_metrics
+++ b/changes/ticket41339_metrics
@@ -54,3 +54,9 @@
       keyed hash of each key is kept, until a fetch is counted in a later
       minute. Bridges don't count these, and other relays count them only while
       a MetricsPort is configured. Part of ticket 41339.
+    - Count the onion service directory requests that tor accepts whose
+      previous hop is a relay we know only by its descriptor, not in our
+      consensus, as tor_relay_dos_total{type="hsdir_descriptor_only_prev_hop"}.
+      HSDirRefuseUnknownPrevHop treats these as known: the count shows how much
+      traffic comes from relays that recently left the consensus. Part of
+      ticket 41339.
diff --git a/doc/man/tor.1.txt b/doc/man/tor.1.txt
index 9bb26f429b..f72f20c290 100644
--- a/doc/man/tor.1.txt
+++ b/doc/man/tor.1.txt
@@ -3197,9 +3197,12 @@ MetricsPort.
     have a descriptor: the check RefuseUnknownExits applies to exit streams. A
     relay that is new in the client's consensus but not yet in ours is also
     refused, so clients then use another HSDir. Such requests are counted as
-    tor_relay_dos_total\{type="hsdir_unknown_prev_hop"}. "auto" means use
-    the consensus parameter. If not defined in the consensus, the value is
-    0. (Default: auto)
+    tor_relay_dos_total\{type="hsdir_unknown_prev_hop"}. A relay that has
+    left our consensus is still known while we have its descriptor, for up
+    to two days; requests from such relays are counted as
+    \{type="hsdir_descriptor_only_prev_hop"}. "auto" means use the consensus
+    parameter. If not defined in the consensus, the value is 0. (Default:
+    auto)
 
 [[HSDirDescriptorFetchRate]] **HSDirDescriptorFetchRate** __NUM__::
 
diff --git a/src/core/or/dos.h b/src/core/or/dos.h
index 2c939ecc4e..322123e584 100644
--- a/src/core/or/dos.h
+++ b/src/core/or/dos.h
@@ -92,6 +92,9 @@ typedef enum dos_dir_stat_t {
   /** Onion service directory requests over an anonymous circuit, and the
    * first on it, whose previous hop is not a known relay. */
   DOS_DIR_HSDIR_UNKNOWN_PREV_HOP,
+  /** Those whose previous hop is a relay we know only by its descriptor,
+   * not in our consensus, which aren't counted above. */
+  DOS_DIR_HSDIR_DESCRIPTOR_ONLY_PREV_HOP,
   /** Fetches of a cached onion service descriptor over
    * HSDirDescriptorFetchRate. */
   DOS_DIR_HSDIR_FETCH_OVER_RATE,
diff --git a/src/feature/dircache/dircache.c b/src/feature/dircache/dircache.c
index 7e6602733e..f6ef6341ac 100644
--- a/src/feature/dircache/dircache.c
+++ b/src/feature/dircache/dircache.c
@@ -18,7 +18,6 @@
 #include "core/or/channel.h"
 #include "core/or/circuitlist.h"
 #include "core/or/connection_edge.h"
-#include "core/or/connection_or.h"
 #include "core/or/dos.h"
 #include "core/or/relay.h"
 #include "feature/dirauth/dirvote.h"
@@ -1446,8 +1445,14 @@ allow_hs_dir_request(dir_connection_t *conn)
   or_circuit_t *circ =
     TO_OR_CIRCUIT(TO_EDGE_CONN(TO_CONN(conn)->linked_conn)->on_circuit);
 
-  if (connection_or_digest_is_known_relay(circ->p_chan->identity_digest))
+  /* connection_or_digest_is_known_relay(), with its two cases apart, to
+   * count the requests from relays we know only by their descriptor. */
+  if (router_get_consensus_status_by_id(circ->p_chan->identity_digest))
     return true;
+  if (router_get_by_id_digest(circ->p_chan->identity_digest)) {
+    dos_note_dir_stat(DOS_DIR_HSDIR_DESCRIPTOR_ONLY_PREV_HOP);
+    return true;
+  }
   dos_note_dir_stat(DOS_DIR_HSDIR_UNKNOWN_PREV_HOP);
   if (!dos_should_refuse_unknown_hsdir_prev_hop())
     return true;
