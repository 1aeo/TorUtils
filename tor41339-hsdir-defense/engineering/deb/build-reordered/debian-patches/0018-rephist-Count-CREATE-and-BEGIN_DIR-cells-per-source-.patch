+/** Test that every CREATE cell, even one we drop, is counted by its place
+ * among the CREATE cells its source sent in the same minute, and not among
+ * its BEGIN_DIR cells. */
+static void
+test_dos_create_cell_source(void *arg)
+{
+  channel_t *chan = new_fake_channel();
+  cell_t cell;
+  const channel_prev_hop_t hop = CHANNEL_PREV_HOP_UNKNOWN_RELAY;
+  uint64_t first0, later0, begindir0;
+  (void) arg;
+
+  get_options_mutable()->MetricsPort_set = 1;
+  update_approx_time(1800000000); /* The start of a minute. */
+  first0 = rep_hist_get_source_cells(false, hop)[NTH_BAND_1];
+  later0 = rep_hist_get_source_cells(false, hop)[NTH_BAND_2_10];
+  begindir0 = rep_hist_get_source_cells(true, hop)[NTH_BAND_1];
+  memset(&cell, 0, sizeof(cell));
+  cell.command = CELL_CREATE2;
+
+  /* Two cells from one relay's channel, dropped for their circuit ID 0. */
+  command_process_cell(chan, &cell);
+  command_process_cell(chan, &cell);
+  tt_u64_op(rep_hist_get_source_cells(false, hop)[NTH_BAND_1], OP_EQ,
+            first0 + 1);
+  tt_u64_op(rep_hist_get_source_cells(false, hop)[NTH_BAND_2_10], OP_EQ,
+            later0 + 1);
+  tt_u64_op(rep_hist_get_source_cells(true, hop)[NTH_BAND_1], OP_EQ,
+            begindir0);
+
+ done:
+  free_fake_channel(chan);
+}
