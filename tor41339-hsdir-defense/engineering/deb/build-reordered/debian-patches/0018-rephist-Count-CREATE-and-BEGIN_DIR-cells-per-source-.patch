+/**
+ * @file source_minute_st.h
+ * @brief The cells that one source of circuits sent in a minute.
+ **/
+
+#ifndef SOURCE_MINUTE_ST_H
+#define SOURCE_MINUTE_ST_H
+
+#include "lib/cc/torint.h"
+
+/** The cells one source of circuits sent in its latest minute: see
+ * rep_hist_note_source_cell(). */
+typedef struct source_minute_t {
+  /** approx_time() / 60 when these cells arrived. */
+  uint32_t minute;
+  /** CREATE and BEGIN_DIR cells in that minute, stopping at NTH_BAND_MAX. */
+  uint16_t n_create, n_begindir;
+} source_minute_t;
+
+#endif /* !defined(SOURCE_MINUTE_ST_H) */
