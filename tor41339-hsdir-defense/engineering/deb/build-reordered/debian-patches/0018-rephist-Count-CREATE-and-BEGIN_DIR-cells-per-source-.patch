+/* A source's BEGIN_DIR and CREATE cells are counted apart, each in its own
+ * family, and both start over when a new minute starts, not before. */
+static void
+test_source_cell_minutes(void *arg)
+{
+  channel_t *relay = new_fake_channel();
+  or_circuit_t *circ = or_circuit_new(0, NULL);
+  const time_t t0 = 1800000000; /* The start of a minute. */
+  int64_t create1, create2, begindir1, begindir2;
+  (void) arg;
+
+  get_options_mutable()->MetricsPort_set = 1;
+  create1 = CREATE_SOURCE("known_relay", "1");
+  create2 = CREATE_SOURCE("known_relay", "2_10");
+  begindir1 = BEGINDIR_SOURCE("known_relay", "1");
+  begindir2 = BEGINDIR_SOURCE("known_relay", "2_10");
+  update_approx_time(t0);
+  circ->p_chan = relay;
+  circ->prev_hop = CHANNEL_PREV_HOP_KNOWN_RELAY;
+
+  /* Two BEGIN_DIR cells, then the first CREATE cell. */
+  rep_hist_note_begindir_cell(circ);
+  rep_hist_note_begindir_cell(circ);
+  rep_hist_note_create_cell(relay, CHANNEL_PREV_HOP_KNOWN_RELAY);
+  tt_i64_op(BEGINDIR_SOURCE("known_relay", "1"), OP_EQ, begindir1 + 1);
+  tt_i64_op(BEGINDIR_SOURCE("known_relay", "2_10"), OP_EQ, begindir2 + 1);
+  tt_i64_op(CREATE_SOURCE("known_relay", "1"), OP_EQ, create1 + 1);
+  tt_i64_op(CREATE_SOURCE("known_relay", "2_10"), OP_EQ, create2);
+
+  /* The last second of the minute, then the next minute. */
+  update_approx_time(t0 + 59);
+  rep_hist_note_begindir_cell(circ);
+  tt_i64_op(BEGINDIR_SOURCE("known_relay", "2_10"), OP_EQ, begindir2 + 2);
+  update_approx_time(t0 + 60);
+  rep_hist_note_begindir_cell(circ);
+  rep_hist_note_create_cell(relay, CHANNEL_PREV_HOP_KNOWN_RELAY);
+  tt_i64_op(BEGINDIR_SOURCE("known_relay", "1"), OP_EQ, begindir1 + 2);
+  tt_i64_op(CREATE_SOURCE("known_relay", "1"), OP_EQ, create1 + 2);
+
+ done:
+  circ->p_chan = NULL;
+  circuit_free_all();
+  free_fake_channel(relay);
+}
+
+/* A source's count stops at the last band: its 65537th cell in a minute,
+ * past what 16 bits hold, is still the 1001st or later. */
+static void
+test_source_cell_saturation(void *arg)
+{
+  channel_t *relay = new_fake_channel();
+  int64_t first0, last0;
+  (void) arg;
+
+  get_options_mutable()->MetricsPort_set = 1;
+  first0 = CREATE_SOURCE("unknown_relay", "1");
+  last0 = CREATE_SOURCE("unknown_relay", "1001_plus");
+  update_approx_time(1800000000); /* The start of a minute. */
+  for (int i = 0; i < 65537; i++)
+    rep_hist_note_create_cell(relay, CHANNEL_PREV_HOP_UNKNOWN_RELAY);
+  tt_i64_op(CREATE_SOURCE("unknown_relay", "1"), OP_EQ, first0 + 1);
+  tt_i64_op(CREATE_SOURCE("unknown_relay", "1001_plus"), OP_EQ,
+            last0 + 65537 - 1000);
+
+ done:
+  free_fake_channel(relay);
+}
+
+/* Without a MetricsPort, a relay looks at no cell's source: its cells don't
+ * count towards the source's place in the minute, so once a MetricsPort is
+ * added, the source's next cell is its first. A cell without a channel has
+ * no source. */
+static void
+test_source_cell_metrics_port(void *arg)
+{
+  channel_t *relay = new_fake_channel();
+  or_circuit_t *circ = or_circuit_new(0, NULL);
+  int64_t first0, later0;
+  (void) arg;
+
+  first0 = CREATE_SOURCE("known_relay", "1");
+  later0 = CREATE_SOURCE("known_relay", "2_10");
+  update_approx_time(1800000000); /* The start of a minute. */
+  rep_hist_note_create_cell(relay, CHANNEL_PREV_HOP_KNOWN_RELAY);
+  get_options_mutable()->MetricsPort_set = 1;
+  rep_hist_note_create_cell(relay, CHANNEL_PREV_HOP_KNOWN_RELAY);
+  tt_i64_op(CREATE_SOURCE("known_relay", "1"), OP_EQ, first0 + 1);
+  tt_i64_op(CREATE_SOURCE("known_relay", "2_10"), OP_EQ, later0);
+  rep_hist_note_create_cell(NULL, CHANNEL_PREV_HOP_KNOWN_RELAY);
+  circ->prev_hop = CHANNEL_PREV_HOP_KNOWN_RELAY;
+  rep_hist_note_begindir_cell(circ);
+  tt_i64_op(CREATE_SOURCE("known_relay", "1"), OP_EQ, first0 + 1);
+
+ done:
+  get_options_mutable()->MetricsPort_set = 0;
+  circuit_free_all();
+  free_fake_channel(relay);
+}
