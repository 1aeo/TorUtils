 void
-rep_hist_note_create_cell(channel_prev_hop_t prev_hop)
+rep_hist_note_create_cell(channel_t *chan, channel_prev_hop_t prev_hop)
 {
   create_cells[prev_hop]++;
+  rep_hist_note_source_cell(chan, prev_hop, false);
 }
 
