diff --git a/src/feature/dircommon/directory.c b/src/feature/dircommon/directory.c
index 50487d4ea7..e0d8197e5d 100644
--- a/src/feature/dircommon/directory.c
+++ b/src/feature/dircommon/directory.c
@@ -268,50 +268,69 @@ connection_dir_is_anonymous(const dir_connection_t *dir_conn)
 /** Note that the anonymous directory connection <b>conn</b> is making an onion
  * service directory request, and return true iff an HSDir should serve it.
  *
- * HSDirs have refused onion service requests from client channels since
- * 0.4.2.1-alpha (24964), so they can't be made over one-hop circuits. But a
- * peer that authenticates with any self-generated relay identity is not a
- * client channel, so it can still make one-hop HS requests. As exits do for
- * RefuseUnknownExits (1751), require the previous hop to be a known relay: one
- * in our consensus or with a descriptor. This rejects arbitrary unknown
- * prev-hop identities; an attacker can still add one hop through any consensus
- * relay, so it is not a rate limit.
+ * First, require the previous hop to be a known relay (in our consensus or
+ * with a descriptor), as exits do for RefuseUnknownExits (1751), because a
+ * peer that authenticates with a self-generated relay identity is not a client
+ * channel and could otherwise make one-hop HS requests.
  *
- * We count every unknown-prev-hop request, whether or not we enforce, so the
- * effect can be measured first. When enforcement is enabled, we send a 503 and
- * return false. Enforcement is off by default and is its own
- * HSDirRefuseUnknownPrevHop torrc option and hsdir_refuse_unknown_prev_hop
- * consensus parameter, independent of RefuseUnknownExits, so turning the HSDir
- * rule off does not weaken exit protection (and vice versa).
+ * Second, Tor and Arti make every onion service directory request on its own
+ * circuit, so a circuit that already made one is not a stock client. We count
+ * total anonymous HS requests (as
+ * tor_relay_dos_total{type="hsdir_request_total"}), every repeat request on a
+ * circuit ({type="hsdir_req_reused"}), and reused circuits once per circuit
+ * (in the heartbeat and as {type="hsdir_circ_reused"}), whether or not we
+ * enforce, and even when unknown-previous-hop enforcement is active. When
+ * one-request-per-circuit enforcement is enabled, a repeat request closes the
+ * circuit with END_CIRC_REASON_RESOURCELIMIT; otherwise, when
+ * unknown-previous-hop enforcement is enabled, an unknown previous hop gets a
+ * 503 response.
  *
- * Stock C tor, Arti and Onionbalance always have a consensus relay as the
- * previous hop; the only false positives are during the ~1e-6/request window
- * when the relay has not yet seen the previous hop in a fresh consensus. */
+ * Both rules stay specific to onion service requests: relays fetching other
+ * documents over one-hop circuits also pass connection_dir_is_anonymous(),
+ * and legitimately make several requests per circuit. */
 bool
 connection_dir_allow_hs_request(dir_connection_t *conn)
 {
-  const circuit_t *circ;
+  or_circuit_t *circ;
   channel_t *p_chan;
 
   /* This guarantees a linked edge connection on an open OR circuit. */
   if (BUG(!connection_dir_is_anonymous(conn)))
     return true;
-  circ = CONST_TO_EDGE_CONN(TO_CONN(conn)->linked_conn)->on_circuit;
-  p_chan = CONST_TO_OR_CIRCUIT(circ)->p_chan;
+  circ = TO_OR_CIRCUIT(TO_EDGE_CONN(TO_CONN(conn)->linked_conn)->on_circuit);
+  p_chan = circ->p_chan;
 
-  if (!connection_or_digest_is_known_relay(p_chan->identity_digest)) {
+  const bool prev_hop_known =
+    connection_or_digest_is_known_relay(p_chan->identity_digest);
+  if (!prev_hop_known)
     dos_note_hsdir_unknown_prev_hop();
-    if (dos_should_refuse_unknown_hsdir_prev_hop()) {
-      static ratelim_t prev_hop_lim = RATELIM_INIT(600);
-      log_fn_ratelim(&prev_hop_lim, LOG_PROTOCOL_WARN, LD_REND,
-                     "Refusing HS directory request from unknown previous "
-                     "hop %s.",
-                     p_chan->describe_peer ?
-                     safe_str(channel_describe_peer(p_chan)) : "(unknown)");
-      write_short_http_response(conn, 503, "Rejecting HS request: previous "
-                                "hop is not a known relay");
-      return false;
-    }
+
+  const unsigned int prev_reqs = circ->n_hsdir_requests;
+  dos_note_hsdir_request(prev_reqs);
+  if (prev_reqs < 2)
+    circ->n_hsdir_requests = prev_reqs + 1;
+
+  if (prev_reqs > 0 && dos_should_enforce_hsdir_one_request_per_circ()) {
+    static ratelim_t reuse_lim = RATELIM_INIT(600);
+    log_fn_ratelim(&reuse_lim, LOG_PROTOCOL_WARN, LD_REND,
+                   "Closing circuit after repeated HS directory request "
+                   "from %s.",
+                   p_chan->describe_peer ?
+                   safe_str(channel_describe_peer(p_chan)) : "(unknown)");
+    circuit_mark_for_close(TO_CIRCUIT(circ), END_CIRC_REASON_RESOURCELIMIT);
+    return false;
+  }
+
+  if (!prev_hop_known && dos_should_refuse_unknown_hsdir_prev_hop()) {
+    static ratelim_t prev_hop_lim = RATELIM_INIT(600);
+    log_fn_ratelim(&prev_hop_lim, LOG_PROTOCOL_WARN, LD_REND,
+                   "Refusing HS directory request from unknown previous "
+                   "hop %s.",
+                   p_chan->describe_peer ?
+                   safe_str(channel_describe_peer(p_chan)) : "(unknown)");
+    write_short_http_response(conn, 503, "Rejecting HS request: previous "
+                              "hop is not a known relay");
+    return false;
   }
   return true;
 }
