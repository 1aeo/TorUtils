+/* Note down that we've just seen an anonymous onion service directory request
+ * on a circuit that had previously made <b>prev_count</b> such requests.
+ * Counts all anonymous HS requests in num_hsdir_request_total, every repeat
+ * request in num_hsdir_req_reused, and each reused circuit once in
+ * num_hsdir_circ_reused (for the heartbeat and the MetricsPort). */
+void
+dos_note_hsdir_request(unsigned int prev_count)
+{
+  num_hsdir_request_total++;
+  if (prev_count >= 1) {
+    num_hsdir_req_reused++;
+    if (prev_count == 1)
+      num_hsdir_circ_reused++;
+  }
+}
