+/** Note that the anonymous directory connection <b>conn</b> is making an onion
+ * service directory request, and return true iff an HSDir should serve it.
+ *
+ * Tor and Arti make every onion service directory request on its own circuit,
+ * so a circuit that already made one is not a stock client. We count that
+ * reuse exactly once per circuit, whether or not we enforce, so the heartbeat
+ * and the tor_relay_dos_total{type="hsdir_circ_reused"} MetricsPort metric
+ * mean the same thing in both modes. We close the circuit (RESOURCELIMIT)
+ * only when enforcement is enabled; by default a relay with no torrc or
+ * consensus opinion only observes. See
+ * dos_should_enforce_hsdir_one_request_per_circ().
+ *
+ * This must stay specific to onion service requests: relays fetching other
+ * documents over one-hop circuits also pass connection_dir_is_anonymous(),
+ * and legitimately make several requests per circuit.
+ *
+ * Like the other DoS defenses, we use RESOURCELIMIT rather than TORPROTOCOL,
+ * since the spec does not (yet) require one request per circuit. */
+bool
+connection_dir_note_hs_request(dir_connection_t *conn)
+{
+  or_circuit_t *circ;
+
+  /* This guarantees a linked edge connection on an open OR circuit. */
+  if (BUG(!connection_dir_is_anonymous(conn)))
+    return true;
+  circ = TO_OR_CIRCUIT(TO_EDGE_CONN(TO_CONN(conn)->linked_conn)->on_circuit);
+
+  if (circ->already_received_hsdir_request) {
+    if (!circ->hsdir_request_reuse_counted) {
+      dos_note_hsdir_circ_reused();
+      circ->hsdir_request_reuse_counted = 1;
+    }
+    if (dos_should_enforce_hsdir_one_request_per_circ()) {
+      circuit_mark_for_close(TO_CIRCUIT(circ), END_CIRC_REASON_RESOURCELIMIT);
+      return false;
+    }
+  }
+  circ->already_received_hsdir_request = 1;
+  return true;
+}
