  * store.
@@ -258,6 +260,20 @@ static const relay_metrics_entry_t base_metrics[] =
     .help = "Total number of onion service descriptor uploads we received",
     .fill_fn = fill_hsdir_post_values,
   },
+  {
+    .key = RELAY_METRICS_NUM_BEGINDIR_REQUESTS,
+    .type = METRICS_TYPE_COUNTER,
+    .name = METRICS_NAME(relay_begindir_request_total),
+    .help = "Total number of other tunneled directory requests we received",
+    .fill_fn = fill_begindir_request_values,
+  },
+  {
+    .key = RELAY_METRICS_NUM_BEGINDIR_RESPONSES,
+    .type = METRICS_TYPE_COUNTER,
+    .name = METRICS_NAME(relay_begindir_response_total),
+    .help = "Total number of tunneled directory responses we handed off",
+    .fill_fn = fill_begindir_response_values,
+  },
 };
 static const size_t num_base_metrics = ARRAY_LENGTH(base_metrics);
 
@@ -1349,6 +1365,55 @@ fill_hsdir_post_values(void)
                       HSDIR_POST_ACTION_COUNT);
 }
 
+/** Tunneled directory requests, by type. */
+static uint64_t dir_requests[DIR_REQUEST_TYPE_COUNT];
+/** Label values for a dir_request_type_t. */
+static const char *const dir_request_names[] = {
+  [DIR_REQUEST_NON_HS] = "non_hs",
+  [DIR_REQUEST_UNPARSED] = "unparsed",
+};
+
+/** Count a tunneled directory request of type <b>type</b>. */
+void
+relay_increment_dir_request(dir_request_type_t type)
+{
+  dir_requests[type]++;
+}
+
+/** Fill function for the RELAY_METRICS_NUM_BEGINDIR_REQUESTS metric. */
+static void
+fill_begindir_request_values(void)
+{
+  fill_labeled_values(&base_metrics[RELAY_METRICS_NUM_BEGINDIR_REQUESTS],
+                      "type", dir_request_names, dir_requests,
+                      DIR_REQUEST_TYPE_COUNT);
+}
+
+/** Tunneled directory responses fully handed to their stream, by type. */
+static uint64_t dir_responses[DIR_RESPONSE_TYPE_COUNT];
+/** Label values for a dir_response_type_t. */
+static const char *const dir_response_names[] = {
+  [DIR_RESPONSE_HS_DESCRIPTOR] = "hs_descriptor",
+  [DIR_RESPONSE_OTHER] = "other",
+};
+
+/** Count a tunneled directory response of type <b>type</b>, fully handed
+ * to its stream. */
+void
+relay_increment_dir_response(dir_response_type_t type)
+{
+  dir_responses[type]++;
+}
+
+/** Fill function for the RELAY_METRICS_NUM_BEGINDIR_RESPONSES metric. */
+static void
+fill_begindir_response_values(void)
+{
+  fill_labeled_values(&base_metrics[RELAY_METRICS_NUM_BEGINDIR_RESPONSES],
+                      "type", dir_response_names, dir_responses,
+                      DIR_RESPONSE_TYPE_COUNT);
+}
+
 /** Fill the metrics store for the RELAY_METRICS_CIRC_DROP_CELL counter. */
 static void
 fill_relay_drop_cell(void)
diff --git a/src/feature/relay/relay_metrics.h b/src/feature/relay/relay_metrics.h
index 500d9ddd94..9a99287a7c 100644
--- a/src/feature/relay/relay_metrics.h
+++ b/src/feature/relay/relay_metrics.h
@@ -67,6 +67,10 @@ typedef enum {
   RELAY_METRICS_NUM_HSDIR_GET,
   /** Onion service descriptor uploads, by outcome. */
   RELAY_METRICS_NUM_HSDIR_POST,
+  /** Other tunneled directory requests, by type. */
+  RELAY_METRICS_NUM_BEGINDIR_REQUESTS,
+  /** Tunneled directory responses handed to their stream, by type. */
+  RELAY_METRICS_NUM_BEGINDIR_RESPONSES,
 } relay_metrics_key_t;
 
 /** The metadata of a relay metric. */
@@ -182,4 +186,31 @@ typedef enum {
 
 void relay_increment_hsdir_post_action(hsdir_post_action_t);
 
+/** Type of a tunneled (BEGIN_DIR) directory request that isn't an onion
+ * service descriptor fetch or upload. */
+typedef enum {
+  /** Any other request that parsed. */
+  DIR_REQUEST_NON_HS,
+  /** No usable request: parse_http_url() failed, or the connection closed
+   * while waiting for one. */
+  DIR_REQUEST_UNPARSED,
+
+  DIR_REQUEST_TYPE_COUNT
+} dir_request_type_t;
+
+void relay_increment_dir_request(dir_request_type_t);
+
+/** Type of a tunneled directory response that was fully handed to its
+ * stream (which doesn't mean that the client received it). */
+typedef enum {
+  /** An onion service descriptor. */
+  DIR_RESPONSE_HS_DESCRIPTOR,
+  /** Anything else, including error responses. */
+  DIR_RESPONSE_OTHER,
+
+  DIR_RESPONSE_TYPE_COUNT
+} dir_response_type_t;
+
+void relay_increment_dir_response(dir_response_type_t);
+
