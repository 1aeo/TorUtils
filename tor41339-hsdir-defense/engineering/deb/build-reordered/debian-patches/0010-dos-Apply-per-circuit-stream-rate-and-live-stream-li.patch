-/* Return the action to take against a BEGIN or RESOLVE cell. Return
- *  DOS_STREAM_DEFENSE_NONE when no action should be taken.
- *  Increment the appropriate counter when the cell was found to go over a
- *  limit. */
+/* Consume one token from <b>bucket</b> using <b>rate</b> and <b>burst</b>,
+ * initializing or adjusting <b>bucket</b> if needed. Return true iff a token
+ * was available. */
+static bool
+dos_token_bucket_consume(token_bucket_ctr_t *bucket,
+                         uint32_t rate, uint32_t burst)
+{
+  const uint32_t now = (uint32_t) monotime_coarse_absolute_sec();
+  if (BUG(rate == 0 || burst == 0))
+    return true;
+  if (bucket->cfg.rate == 0) {
+    token_bucket_ctr_init(bucket, rate, burst, now);
+  } else if (bucket->cfg.rate != rate ||
+             (uint32_t)bucket->cfg.burst != burst) {
+    token_bucket_ctr_adjust(bucket, rate, burst);
+  }
+  token_bucket_ctr_refill(bucket, now);
+  if (token_bucket_ctr_get(bucket) > 0) {
+    token_bucket_ctr_dec(bucket, 1);
+    return true;
+  }
+  return false;
+}
+
+/* Return the action to take against a BEGIN, BEGIN_DIR (when
+ * <b>is_begindir</b> is true), or RESOLVE cell on <b>circ</b>. Evaluates both
+ * the per-circuit stream token bucket and the per-circuit live-stream ceiling
+ * (scanning at most dos_stream_max_concurrent streams across n_streams and
+ * resolving_streams), updating the global and BEGIN_DIR-specific counters even
+ * when enforcement is disabled. */
 dos_stream_defense_type_t
-dos_stream_new_begin_or_resolve_cell(or_circuit_t *circ)
+dos_stream_new_begin_or_resolve_cell(or_circuit_t *circ, bool is_begindir)
 {
-  if (!dos_stream_enabled || circ == NULL)
+  if (circ == NULL || !public_server_mode(get_options())) {
     return DOS_STREAM_DEFENSE_NONE;
-
-  token_bucket_ctr_refill(&circ->stream_limiter,
-                          (uint32_t) monotime_coarse_absolute_sec());
-
-  if (token_bucket_ctr_get(&circ->stream_limiter) > 0) {
-    token_bucket_ctr_dec(&circ->stream_limiter, 1);
+  }
+  const edge_connection_t *lists[] = {
+    circ->n_streams, circ->resolving_streams
+  };
+  uint32_t live = 0;
+  for (size_t i = 0; i < ARRAY_LENGTH(lists); ++i) {
+    for (const edge_connection_t *c = lists[i];
+         c && live < dos_stream_max_concurrent; c = c->next_stream) {
+      live += !c->base_.marked_for_close;
+    }
+  }
+  const bool over_rate = !dos_token_bucket_consume(
+    &circ->stream_limiter, dos_stream_rate, dos_stream_burst);
+  const bool over_live = (live >= dos_stream_max_concurrent);
+  if (!over_rate && !over_live) {
     return DOS_STREAM_DEFENSE_NONE;
   }
-  /* if defense type is DOS_STREAM_DEFENSE_NONE but DoSStreamEnabled is true,
-   * we count offending cells as rejected, despite them being actually
-   * accepted. */
+  if (is_begindir) {
+    if (over_rate)
+      dos_note_dir_stat(DOS_DIR_BEGINDIR_RATE_LIMITED);
+    if (over_live)
+      dos_note_dir_stat(DOS_DIR_BEGINDIR_LIVE_LIMITED);
+  }
+  /* Count offending cells even when DoSStreamCreationEnabled is off or
+   * defense type is DOS_STREAM_DEFENSE_NONE. */
   ++stream_num_rejected;
-  return dos_stream_defense_type;
+  return dos_stream_enabled ? dos_stream_defense_type
+                            : DOS_STREAM_DEFENSE_NONE;
 }
 
 /* Initialize the token bucket for stream rate limit on a circuit. */
