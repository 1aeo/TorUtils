+/** Note that the anonymous directory connection <b>conn</b> is making an onion
+ * service directory request, and return true iff an HSDir should serve it.
+ *
+ * First, check whether the previous hop is a known relay (in our consensus or
+ * with a descriptor), as exits do for RefuseUnknownExits (1751), because a
+ * peer that authenticates with a self-generated relay identity is not a client
+ * channel and could otherwise make one-hop HS requests.
+ *
+ * Second, Tor and Arti make every onion service directory request on its own
+ * circuit, so a circuit that already made one is not a stock client. We count
+ * total anonymous HS requests (as
+ * tor_relay_dos_total{type="hsdir_request_total"}), every repeat request on a
+ * circuit ({type="hsdir_req_reused"}), and reused circuits once per circuit
+ * (in the heartbeat and as {type="hsdir_circ_reused"}).
+ *
+ * Both checks stay specific to onion service requests: relays fetching other
+ * documents over one-hop circuits also pass connection_dir_is_anonymous(),
+ * and legitimately make several requests per circuit. */
+bool
+connection_dir_allow_hs_request(dir_connection_t *conn)
+{
+  or_circuit_t *circ;
+  channel_t *p_chan;
+
+  /* This guarantees a linked edge connection on an open OR circuit. */
+  if (BUG(!connection_dir_is_anonymous(conn)))
+    return true;
+  circ = TO_OR_CIRCUIT(TO_EDGE_CONN(TO_CONN(conn)->linked_conn)->on_circuit);
+  p_chan = circ->p_chan;
+
+  const bool prev_hop_known =
+    connection_or_digest_is_known_relay(p_chan->identity_digest);
+  if (!prev_hop_known)
+    dos_note_dir_stat(DOS_DIR_HSDIR_UNKNOWN_PREV_HOP);
+
+  const unsigned int prev_reqs = circ->n_hsdir_requests;
+  dos_note_hsdir_request(prev_reqs);
+  if (prev_reqs < 2)
+    circ->n_hsdir_requests = prev_reqs + 1;
+
+  return true;
+}
+
 /** Did <b>conn</b> ever send us a version 0 sendme cell and we allowed
  * it? Used to decide whether to count consensus fetches from it in our
  * geoip stats.
@@ -536,6 +580,11 @@ connection_dir_about_to_close(dir_connection_t *dir_conn)
 {
   connection_t *conn = TO_CONN(dir_conn);
 
