+/* Note down that we've just seen an anonymous onion service directory request
+ * on a circuit that had previously made <b>prev_count</b> such requests.
+ * Counts all anonymous HS requests in DOS_DIR_HSDIR_REQUEST_TOTAL, every
+ * repeat request in DOS_DIR_HSDIR_REQ_REUSED, and each reused circuit once in
+ * DOS_DIR_HSDIR_CIRC_REUSED (for the heartbeat and the MetricsPort). */
+void
+dos_note_hsdir_request(unsigned int prev_count)
+{
+  dos_note_dir_stat(DOS_DIR_HSDIR_REQUEST_TOTAL);
+  if (prev_count >= 1) {
+    dos_note_dir_stat(DOS_DIR_HSDIR_REQ_REUSED);
+    if (prev_count == 1)
+      dos_note_dir_stat(DOS_DIR_HSDIR_CIRC_REUSED);
+  }
+}
