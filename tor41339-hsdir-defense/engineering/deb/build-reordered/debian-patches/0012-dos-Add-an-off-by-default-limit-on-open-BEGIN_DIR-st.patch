+/** Test that BEGIN_DIR cells on a circuit with DoSBeginDirMaxStreams open
+ * directory streams are counted, and only refused when the limit is
+ * enabled. */
+static void
+test_dos_begindir_max_streams(void *arg)
+{
+  or_circuit_t *circ = or_circuit_new(0, NULL);
+  edge_connection_t *streams[4];
+  dos_options_t *dos_opts = get_dos_options(get_options_mutable());
+  (void) arg;
+
+  MOCK(networkstatus_get_latest_consensus,
+       mock_networkstatus_get_latest_consensus);
+  get_options_mutable()->ORPort_set = 1;
+
+  /* Two open directory streams, a closing one, and an exit stream. */
+  for (int i = 0; i < 4; i++) {
+    streams[i] = edge_connection_new(CONN_TYPE_EXIT, AF_INET);
+    streams[i]->base_.linked = (i < 3);
+    streams[i]->next_stream = circ->n_streams;
+    circ->n_streams = streams[i];
+  }
+  streams[2]->base_.marked_for_close = 1;
+
+  /* Under the default limit of 20 or a torrc limit of 3, nothing is
+   * counted. */
+  tt_assert(!dos_should_refuse_begindir(circ));
+  dos_opts->DoSBeginDirMaxStreams = 3;
+  tt_assert(!dos_should_refuse_begindir(circ));
+  tt_u64_op(dos_get_dir_stat(DOS_DIR_BEGINDIR_OVER_MAX), OP_EQ, 0);
+
+  /* At a limit of 2, we count, but only refuse when enabled. */
+  dos_opts->DoSBeginDirMaxStreams = 2;
+  tt_assert(!dos_should_refuse_begindir(circ));
+  dos_opts->DoSBeginDirLimitEnabled = 1;
+  tt_assert(dos_should_refuse_begindir(circ));
+  tt_u64_op(dos_get_dir_stat(DOS_DIR_BEGINDIR_OVER_MAX), OP_EQ, 2);
+
+  /* The consensus can set both, and the torrc overrides it. */
+  dummy_ns = tor_malloc_zero(sizeof(networkstatus_t));
+  dummy_ns->net_params = smartlist_new();
+  smartlist_add(dummy_ns->net_params, (char *) "DoSBeginDirLimitEnabled=1");
+  smartlist_add(dummy_ns->net_params, (char *) "DoSBeginDirMaxStreams=2");
+  dos_opts->DoSBeginDirLimitEnabled = -1;
+  dos_opts->DoSBeginDirMaxStreams = 0;
+  tt_assert(dos_should_refuse_begindir(circ));
+  dos_opts->DoSBeginDirMaxStreams = 3;
+  tt_assert(!dos_should_refuse_begindir(circ));
+  dos_opts->DoSBeginDirMaxStreams = 0;
+  dos_opts->DoSBeginDirLimitEnabled = 0;
+  tt_assert(!dos_should_refuse_begindir(circ));
+  tt_u64_op(dos_get_dir_stat(DOS_DIR_BEGINDIR_OVER_MAX), OP_EQ, 4);
+
+  /* Relays that aren't public never refuse. */
+  dos_opts->DoSBeginDirLimitEnabled = 1;
+  get_options_mutable()->ORPort_set = 0;
+  tt_assert(!dos_should_refuse_begindir(circ));
+
+ done:
+  UNMOCK(networkstatus_get_latest_consensus);
+  if (dummy_ns)
+    smartlist_free(dummy_ns->net_params);
+  tor_free(dummy_ns);
+  circ->n_streams = NULL;
+  for (int i = 0; i < 4; i++)
+    connection_free_minimal(TO_CONN(streams[i]));
+  circuit_free_all();
+}
