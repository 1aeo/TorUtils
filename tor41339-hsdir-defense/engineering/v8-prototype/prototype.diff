+/* Make a BEGIN_DIR stream on <b>circ</b>, as connection_exit_connect_dir()
+ * does, whose directory connection is waiting for a request and was created
+ * <b>age</b> seconds ago. Return that connection. */
+static dir_connection_t *
+new_dir_stream(or_circuit_t *circ, time_t age)
+{
+  dir_connection_t *conn = new_waiting_dir_conn(circ->prev_hop, NULL);
+  edge_connection_t *edge = edge_connection_new(CONN_TYPE_EXIT, AF_INET);
+
+  edge->on_circuit = TO_CIRCUIT(circ);
+  edge->next_stream = circ->n_streams;
+  circ->n_streams = edge;
+  connection_link_connections(TO_CONN(conn), TO_CONN(edge));
+  TO_CONN(conn)->timestamp_created = approx_time() - age;
+  conn->hs_circuit = circ->n_hsdir_requests > 0;
+  return conn;
+}
+
+/* Close the BEGIN_DIR stream of <b>conn</b> and then <b>conn</b>, as
+ * connection_unlink() would, the stream first with <b>end_reason</b> unless
+ * it is -1; if it is, close <b>conn</b> first. */
+static void
+close_dir_stream(dir_connection_t *conn, int end_reason)
+{
+  edge_connection_t *edge = TO_EDGE_CONN(TO_CONN(conn)->linked_conn);
+
+  edge->edge_has_sent_end = 1;
+  if (end_reason == -1) {
+    connection_dir_about_to_close(conn);
+    TO_CONN(conn)->linked_conn = TO_CONN(edge)->linked_conn = NULL;
+    connection_exit_about_to_close(edge);
+  } else {
+    if ((end_reason & END_STREAM_REASON_MASK) == END_STREAM_REASON_DESTROY) {
+      /* As circuit_about_to_free(). */
+      circuit_detach_stream(edge->on_circuit, edge);
+      connection_edge_destroy(0, edge);
+    } else {
+      edge->end_reason = end_reason;
+    }
+    connection_exit_about_to_close(edge);
+    TO_CONN(conn)->linked_conn = TO_CONN(edge)->linked_conn = NULL;
+    connection_dir_about_to_close(conn);
+  }
+  connection_free_minimal(TO_CONN(edge));
+  connection_free_minimal(TO_CONN(conn));
+}
