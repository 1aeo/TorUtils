+/* Link a new tunneled directory server connection, writing a microdesc
+ * response, to a new exit edge that keeps what it reads on its inbuf, and
+ * add both to the connection array. Return the directory connection. */
+static dir_connection_t *
+new_writing_dir_stream(void)
+{
+  dir_connection_t *conn = new_waiting_dir_conn(CHANNEL_PREV_HOP_CLIENT,
+                                                NULL);
+  edge_connection_t *edge = edge_connection_new(CONN_TYPE_EXIT, AF_INET);
+
+  relay_note_dir_request(conn, DIR_REQUEST_MICRODESC);
+  TO_CONN(conn)->state = DIR_CONN_STATE_SERVER_WRITING;
+  TO_CONN(edge)->state = EXIT_CONN_STATE_CONNECTING;
+  TO_CONN(edge)->purpose = EXIT_PURPOSE_CONNECT;
+  TO_CONN(edge)->address = tor_strdup("127.0.0.1");
+  edge->edge_has_sent_end = 1;
+  connection_link_connections(TO_CONN(conn), TO_CONN(edge));
+  connection_add(TO_CONN(conn));
+  connection_add(TO_CONN(edge));
+  return conn;
+}
