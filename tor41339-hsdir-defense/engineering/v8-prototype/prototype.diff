+/* Every response byte is taken by its stream, dropped, or still pending:
+ * bytes left when the directory connection closes first are taken, those
+ * left when the stream closes first are dropped, and so are those the
+ * stream took but never sent. */
+static void
+test_dir_close_path_bytes(void *arg)
+{
+  dir_connection_t *conn;
+  connection_t *edge;
+  char body[700];
+  int64_t taken0, dir0, stream0;
+  (void) arg;
+
+  tor_init_connection_lists();
+  connection_bucket_init();
+  memset(body, 'x', sizeof(body));
+  taken0 = RESPONSE_BYTES_METRIC("microdesc");
+  dir0 = DISCARDED_METRIC("directory");
+  stream0 = DISCARDED_METRIC("stream");
+
+  /* The directory connection closes first: its stream takes what is left,
+   * then closes without sending it. */
+  conn = new_writing_dir_stream();
+  edge = TO_CONN(conn)->linked_conn;
+  buf_add(TO_CONN(conn)->outbuf, body, 300);
+  buf_add(edge->inbuf, body, 200);
+  tt_i64_op(PENDING_METRIC("directory"), OP_EQ, 300);
+  tt_i64_op(PENDING_METRIC("stream"), OP_EQ, 200);
+  connection_mark_for_close(TO_CONN(conn));
+  close_closeable_connections();
+  tt_i64_op(RESPONSE_BYTES_METRIC("microdesc"), OP_EQ, taken0 + 300);
+  tt_int_op(connection_get_inbuf_len(edge), OP_EQ, 500);
+  tt_i64_op(PENDING_METRIC("directory"), OP_EQ, 0);
+  tt_i64_op(PENDING_METRIC("stream"), OP_EQ, 500);
+  connection_mark_for_close(edge);
+  close_closeable_connections();
+  tt_i64_op(DISCARDED_METRIC("stream"), OP_EQ, stream0 + 500);
+  tt_i64_op(DISCARDED_METRIC("directory"), OP_EQ, dir0);
+  tt_int_op(smartlist_len(get_connection_array()), OP_EQ, 0);
+
+  /* The stream closes first: what its directory connection held is
+   * dropped. */
+  conn = new_writing_dir_stream();
+  edge = TO_CONN(conn)->linked_conn;
+  buf_add(TO_CONN(conn)->outbuf, body, sizeof(body));
+  connection_mark_for_close(edge);
+  close_closeable_connections();
+  tt_i64_op(DISCARDED_METRIC("stream"), OP_EQ, stream0 + 500);
+  connection_mark_for_close(TO_CONN(conn));
+  close_closeable_connections();
+  tt_i64_op(DISCARDED_METRIC("directory"), OP_EQ, dir0 + sizeof(body));
+  tt_i64_op(RESPONSE_BYTES_METRIC("microdesc"), OP_EQ, taken0 + 300);
+  tt_int_op(smartlist_len(get_connection_array()), OP_EQ, 0);
+
+ done:
+  ;
+}
