+  tenth0 = POSITION_METRIC("hs_get", "11_100");
+  other0 = POSITION_METRIC("other_get", "11_100");
+  for (size_t i = 0; i < ARRAY_LENGTH(reached); i++)
+    reached0[i] = REACHED_METRIC("unknown_relay", reached[i]);
+  client0 = REACHED_METRIC("client", "1");
