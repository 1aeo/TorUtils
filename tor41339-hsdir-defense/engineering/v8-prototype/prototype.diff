+  tt_int_op(hs_cache_store_as_dir(str), OP_EQ, 0);
+  ed25519_public_to_base64(key, &desc->plaintext_data.blinded_pubkey);
+  tor_asprintf(&get, GET("/tor/hs/3/%s"), key);
