+/* TEST ONLY: with EVIL_EMPTY_BEGINDIR=N, every Nth onion service descriptor
+ * fetch opens its BEGIN_DIR stream and never sends its request, as the
+ * empty-stream floods of tor#41339 do. */
+static int
+evil_empty_begindir(int dir_purpose)
+{
+  static unsigned int n = 0;
+  const char *every = getenv("EVIL_EMPTY_BEGINDIR");
+
+  if (!every || dir_purpose != DIR_PURPOSE_FETCH_HSDESC)
+    return 0;
+  return ++n % (unsigned int) MAX(atoi(every), 1) == 0;
+}
