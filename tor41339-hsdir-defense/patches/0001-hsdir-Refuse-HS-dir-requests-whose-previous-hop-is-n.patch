+/** Note that the anonymous directory connection <b>conn</b> is making an onion
+ * service directory request, and return true iff an HSDir should serve it.
+ *
+ * HSDirs have refused onion service requests from client channels since
+ * 0.4.2.1-alpha (24964), so they can't be made over one-hop circuits. But a
+ * peer that authenticates with any self-generated relay identity is not a
+ * client channel, so it can still make one-hop HS requests. As exits do for
+ * RefuseUnknownExits (1751), require the previous hop to be a known relay: one
+ * in our consensus or with a descriptor. This rejects arbitrary unknown
+ * prev-hop identities; an attacker can still add one hop through any consensus
+ * relay, so it is not a rate limit.
+ *
+ * We count every unknown-prev-hop request, whether or not we enforce, so the
+ * effect can be measured first. When enforcement is enabled, we send a 503 and
+ * return false. Enforcement is off by default and is its own
+ * HSDirRefuseUnknownPrevHop torrc option and hsdir_refuse_unknown_prev_hop
+ * consensus parameter, independent of RefuseUnknownExits, so turning the HSDir
+ * rule off does not weaken exit protection (and vice versa).
+ *
+ * Stock C tor, Arti and Onionbalance always have a consensus relay as the
+ * previous hop; the only false positives are during the ~1e-6/request window
+ * when the relay has not yet seen the previous hop in a fresh consensus. */
+bool
+connection_dir_allow_hs_request(dir_connection_t *conn)
+{
+  const circuit_t *circ;
+  channel_t *p_chan;
+
+  /* This guarantees a linked edge connection on an open OR circuit. */
+  if (BUG(!connection_dir_is_anonymous(conn)))
+    return true;
+  circ = CONST_TO_EDGE_CONN(TO_CONN(conn)->linked_conn)->on_circuit;
+  p_chan = CONST_TO_OR_CIRCUIT(circ)->p_chan;
+
+  if (!connection_or_digest_is_known_relay(p_chan->identity_digest)) {
+    dos_note_hsdir_unknown_prev_hop();
+    if (dos_should_refuse_unknown_hsdir_prev_hop()) {
+      static ratelim_t prev_hop_lim = RATELIM_INIT(600);
+      log_fn_ratelim(&prev_hop_lim, LOG_PROTOCOL_WARN, LD_REND,
+                     "Refusing HS directory request from unknown previous "
+                     "hop %s.",
+                     p_chan->describe_peer ?
+                     safe_str(channel_describe_peer(p_chan)) : "(unknown)");
+      write_short_http_response(conn, 503, "Rejecting HS request: previous "
+                                "hop is not a known relay");
+      return false;
+    }
+  }
+  return true;
+}
+
 /** Did <b>conn</b> ever send us a version 0 sendme cell and we allowed
  * it? Used to decide whether to count consensus fetches from it in our
  * geoip stats.
