+/* Number of onion service directory requests whose previous hop was not a
+ * known relay. Counted whether or not we enforce; see
+ * connection_dir_allow_hs_request(). */
+static uint64_t num_hsdir_unknown_prev_hop;
+
+/* HSDirRefuseUnknownPrevHop default: enforcement is OFF, so a relay with no
+ * torrc or consensus opinion only counts. */
+#define DOS_HSDIR_REFUSE_UNKNOWN_PREV_HOP_DEFAULT 0
+static unsigned int dos_hsdir_refuse_unknown_prev_hop =
+  DOS_HSDIR_REFUSE_UNKNOWN_PREV_HOP_DEFAULT;
+
 /** Return the consensus parameter for the outbound circ_max_cell_queue_size
  * limit. */
 static uint32_t
@@ -360,6 +371,12 @@ set_dos_parameters(const networkstatus_t *ns)
   dos_stream_defense_type = get_param_stream_defense_type(ns);
   dos_stream_rate = get_param_stream_rate(ns);
   dos_stream_burst = get_param_stream_burst(ns);
+
+  /* HSDir. */
+  dos_hsdir_refuse_unknown_prev_hop =
+    !!networkstatus_get_param(ns, "hsdir_refuse_unknown_prev_hop",
+                              DOS_HSDIR_REFUSE_UNKNOWN_PREV_HOP_DEFAULT,
+                              0, 1);
 }
 
 /* Free everything for the circuit creation DoS mitigation subsystem. */
@@ -702,6 +719,14 @@ dos_get_num_single_hop_refused(void)
   return num_single_hop_client_refused;
 }
 
+/** Return the number of onion service directory requests whose previous hop
+ * was not a known relay. */
+uint64_t
+dos_get_num_hsdir_unknown_prev_hop(void)
+{
