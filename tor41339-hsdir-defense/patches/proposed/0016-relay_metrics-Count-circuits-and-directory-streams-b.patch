diff --git a/changes/ticket41339_prev_hop_metrics b/changes/ticket41339_prev_hop_metrics
new file mode 100644
index 0000000000..789b85447e
--- /dev/null
+++ b/changes/ticket41339_prev_hop_metrics
@@ -0,0 +1,15 @@
+  o Minor features (metrics port, relay):
+    - Count CREATE cells, BEGIN_DIR cells and accepted BEGIN_DIR streams by
+      how the circuit's previous hop identified itself: as a client (it
+      never authenticated: a tor client or a bridge), as a relay we know,
+      or as a relay identity we don't know. This is not a hop count. Count
+      BEGIN_DIR cells also by their place on their circuit, and every
+      tunneled directory request by what it asked for (onion service
+      fetch or upload, consensus, microdescriptors, relay descriptors,
+      other, unparsable, or nothing) and by previous hop, as
+      tor_relay_begindir_requests_total. An onion service request refused
+      because its stream or circuit was already closing is now counted as
+      action "circuit_dead" rather than "single_hop", which now means only
+      a client channel. This tells an operator whether a flood of BEGIN_DIR
+      streams comes over one-hop circuits from clients or over circuits
+      extended by relays. Part of ticket 41339.
diff --git a/src/core/or/channel.c b/src/core/or/channel.c
index ca13fb5aa9..775d35538e 100644
--- a/src/core/or/channel.c
+++ b/src/core/or/channel.c
@@ -2991,6 +2991,24 @@ channel_is_client(const channel_t *chan)
   return chan->is_client;
 }
 
+/**
+ * Return how the peer of <b>chan</b>, the previous hop of the circuits it
+ * extends to us, identified itself: as a client (it never authenticated: a
+ * tor client or a bridge), as a relay we know (in our consensus, or whose
+ * descriptor we have), or with an identity we don't know (a relay newer than
+ * our consensus, or one that doesn't publish a descriptor). This is not a
+ * hop count: a relay also makes one-hop circuits for itself.
+ */
+channel_prev_hop_t
+channel_get_prev_hop(const channel_t *chan)
+{
+  if (channel_is_client(chan))
+    return CHANNEL_PREV_HOP_CLIENT;
+  if (connection_or_digest_is_known_relay(chan->identity_digest))
+    return CHANNEL_PREV_HOP_KNOWN_RELAY;
+  return CHANNEL_PREV_HOP_UNKNOWN_RELAY;
+}
+
 /**
  * Set the client flag.
  *
diff --git a/src/core/or/channel.h b/src/core/or/channel.h
index dd9575857b..ed33ac4be1 100644
--- a/src/core/or/channel.h
+++ b/src/core/or/channel.h
@@ -744,6 +744,15 @@ int channel_is_bad_for_new_circs(channel_t *chan);
 void channel_mark_bad_for_new_circs(channel_t *chan);
 int channel_is_canonical(channel_t *chan);
 int channel_is_client(const channel_t *chan);
+/** How a channel's peer identified itself: see channel_get_prev_hop(). */
+typedef enum channel_prev_hop_t {
+  CHANNEL_PREV_HOP_UNSET = 0, /**< Not classified yet. */
+  CHANNEL_PREV_HOP_CLIENT = 1, /**< Never authenticated. */
+  CHANNEL_PREV_HOP_KNOWN_RELAY = 2, /**< A relay we know. */
+  CHANNEL_PREV_HOP_UNKNOWN_RELAY = 3, /**< An identity we don't know. */
+} channel_prev_hop_t;
+#define CHANNEL_PREV_HOP_COUNT (CHANNEL_PREV_HOP_UNKNOWN_RELAY + 1)
+channel_prev_hop_t channel_get_prev_hop(const channel_t *chan);
 int channel_is_local(channel_t *chan);
 int channel_is_incoming(channel_t *chan);
 int channel_is_outgoing(channel_t *chan);
