+/*** Circuits and BEGIN_DIR streams by previous hop ***/
+
+/** CREATE cells, by how their previous hop identified itself. */
+static uint64_t create_cells[CHANNEL_PREV_HOP_COUNT];
+/** BEGIN_DIR cells, by previous hop and by place among those of their
+ * circuit. */
+static uint64_t begindir_cells[CHANNEL_PREV_HOP_COUNT][BEGINDIR_NTH_COUNT];
+/** BEGIN_DIR streams we accepted, by previous hop. */
+static uint64_t begindir_streams[CHANNEL_PREV_HOP_COUNT];
+
+/** Note a CREATE cell from a previous hop of kind <b>prev_hop</b>, before we
+ * decide whether to accept it. */
+void
+rep_hist_note_create_cell(channel_prev_hop_t prev_hop)
+{
+  create_cells[prev_hop]++;
+}
+
+/** Note a BEGIN_DIR cell on <b>circ</b>, before we decide whether to accept
+ * it. A NULL <b>circ</b> (one we originated) isn't counted. */
+void
+rep_hist_note_begindir_cell(or_circuit_t *circ)
+{
+  begindir_nth_t nth;
+
+  if (!circ)
+    return;
+  /* command_process_create_cell() sets it; only tests make circuits
+   * otherwise. */
+  if (circ->prev_hop == CHANNEL_PREV_HOP_UNSET && circ->p_chan)
+    circ->prev_hop = channel_get_prev_hop(circ->p_chan);
+
+  if (circ->n_begindir == 0)
+    nth = BEGINDIR_NTH_1;
+  else if (circ->n_begindir < 9)
+    nth = BEGINDIR_NTH_2_9;
+  else if (circ->n_begindir < BEGINDIR_NTH_MAX)
+    nth = BEGINDIR_NTH_10_49;
+  else
+    nth = BEGINDIR_NTH_50_PLUS;
+  if (circ->n_begindir < BEGINDIR_NTH_MAX)
+    circ->n_begindir++;
+  begindir_cells[circ->prev_hop][nth]++;
+}
+
+/** Note a BEGIN_DIR stream that we accepted from a previous hop of kind
+ * <b>prev_hop</b>. */
+void
+rep_hist_note_begindir_stream(channel_prev_hop_t prev_hop)
+{
+  begindir_streams[prev_hop]++;
+}
+
+/** Return the number of CREATE cells from previous hops of kind
+ * <b>prev_hop</b>. */
+uint64_t
+rep_hist_get_create_cells(channel_prev_hop_t prev_hop)
+{
+  return create_cells[prev_hop];
+}
+
+/** Return the number of BEGIN_DIR cells from previous hops of kind
+ * <b>prev_hop</b> that were at place <b>nth</b> on their circuit. */
+uint64_t
+rep_hist_get_begindir_cells(channel_prev_hop_t prev_hop, begindir_nth_t nth)
+{
+  return begindir_cells[prev_hop][nth];
+}
+
+/** Return the number of BEGIN_DIR streams we accepted from previous hops of
+ * kind <b>prev_hop</b>. */
+uint64_t
+rep_hist_get_begindir_streams(channel_prev_hop_t prev_hop)
+{
+  return begindir_streams[prev_hop];
+}
