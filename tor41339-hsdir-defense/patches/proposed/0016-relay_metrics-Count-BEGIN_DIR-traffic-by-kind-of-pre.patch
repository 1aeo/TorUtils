+/* Return the sum of the series of metric <b>name</b> with the label
+ * <b>key</b>=<b>value</b>, and, if <b>key2</b> is not NULL,
+ * <b>key2</b>=<b>value2</b>. */
+static int64_t
+get_metric_sum(const char *name, const char *key, const char *value,
+               const char *key2, const char *value2)
+{
+  const smartlist_t *entries =
+    metrics_store_get_all(smartlist_get(relay_metrics_get_stores(), 0), name);
+  char *label = tor_strdup(metrics_format_label(key, value));
+  char *label2 = key2 ? tor_strdup(metrics_format_label(key2, value2)) : NULL;
+  int64_t sum = 0;
+
+  SMARTLIST_FOREACH(entries, const metrics_store_entry_t *, e, {
+    if (metrics_store_entry_has_label(e, label) &&
+        (!label2 || metrics_store_entry_has_label(e, label2)))
+      sum += metrics_store_entry_get_value(e);
+  });
+  tor_free(label);
+  tor_free(label2);
+  return sum;
+}
