+/* Tunneled directory requests are counted by the kind of their circuit's
+ * previous hop, and an onion service request that isn't anonymous is
+ * single_hop only if that previous hop never authenticated. */
+static void
+test_dir_requests_by_prev_hop(void *arg)
+{
+  channel_t *chan = tor_malloc_zero(sizeof(channel_t));
+  dir_connection_t *waiting = dir_connection_new(AF_INET);
+  routerstatus_t known_rs;
+  or_circuit_t *circ;
+  const char *hops[] = { "client", "relay", "unknown_relay" };
+  int64_t non_hs0[3], unparsed0[3], single0, closing0;
+  (void) arg;
+
+  init_test();
+  MOCK(connection_write_to_buf_impl_, connection_write_to_buf_mock);
+  get_options_mutable()->ORPort_set = 1; /* Accept directory posts. */
+  for (int i = 0; i < 3; i++) {
+    non_hs0[i] = DIR_REQUEST_HOP_METRIC("non_hs", hops[i]);
+    unparsed0[i] = DIR_REQUEST_HOP_METRIC("unparsed", hops[i]);
+  }
+  single0 = GET_METRIC("single_hop");
+  closing0 = GET_METRIC("closing");
+
+  /* A zeroed identity is not a relay we know... */
+  hsdir_request_on_new_circ(chan, GET("/tor/robots.txt"), NULL);
+  /* ...until it is in our consensus. */
+  memset(&known_rs, 0, sizeof(known_rs));
+  mock_hsdir_ns = tor_malloc_zero(sizeof(networkstatus_t));
+  mock_hsdir_ns->routerstatus_list = smartlist_new();
+  smartlist_add(mock_hsdir_ns->routerstatus_list, &known_rs);
+  MOCK(networkstatus_get_latest_consensus, mock_hsdir_get_latest_consensus);
+  hsdir_request_on_new_circ(chan, GET("/tor/robots.txt"), NULL);
+  hsdir_request_on_new_circ(chan, "GET\r\n\r\n", NULL);
+  /* An onion service request on a circuit that is already closing. */
+  circ = or_circuit_new(0, NULL);
+  circ->p_chan = chan;
+  TO_CIRCUIT(circ)->marked_for_close = 1;
+  hsdir_request_on_circ(circ, GET("/tor/hs/3/x"), NULL);
+  /* A client that never authenticated. */
+  chan->is_client = 1;
+  hsdir_request_on_new_circ(chan, GET("/tor/robots.txt"), NULL);
+  hsdir_request_on_new_circ(chan, GET("/tor/hs/3/x"), NULL);
+  hsdir_request_on_new_circ(chan, "POST\r\n\r\n", "x");
+  /* A stream that closed before its request arrived keeps its previous
+   * hop. */
+  TO_CONN(waiting)->purpose = DIR_PURPOSE_SERVER;
+  TO_CONN(waiting)->state = DIR_CONN_STATE_SERVER_COMMAND_WAIT;
+  TO_CONN(waiting)->linked = 1;
+  waiting->prev_hop = DOS_PREV_HOP_UNKNOWN_RELAY;
+  connection_dir_about_to_close(waiting);
+
+  tt_i64_op(DIR_REQUEST_HOP_METRIC("non_hs", "client"), OP_EQ,
+            non_hs0[0] + 1);
+  tt_i64_op(DIR_REQUEST_HOP_METRIC("non_hs", "relay"), OP_EQ,
+            non_hs0[1] + 1);
+  tt_i64_op(DIR_REQUEST_HOP_METRIC("non_hs", "unknown_relay"), OP_EQ,
+            non_hs0[2] + 1);
+  tt_i64_op(DIR_REQUEST_HOP_METRIC("unparsed", "client"), OP_EQ,
+            unparsed0[0] + 1);
+  tt_i64_op(DIR_REQUEST_HOP_METRIC("unparsed", "relay"), OP_EQ,
+            unparsed0[1] + 1);
+  tt_i64_op(DIR_REQUEST_HOP_METRIC("unparsed", "unknown_relay"), OP_EQ,
+            unparsed0[2] + 1);
+  tt_i64_op(GET_METRIC("single_hop"), OP_EQ, single0 + 1);
+  tt_i64_op(GET_METRIC("closing"), OP_EQ, closing0 + 1);
+  /* The BEGIN_DIR cells and their circuits were counted too. */
+  tt_i64_op(get_metric(METRICS_NAME(relay_begindir_cells_total), "prev_hop",
+                       "client"), OP_EQ, 3);
+  tt_i64_op(get_metric(METRICS_NAME(relay_begindir_circuits_total),
+                       "prev_hop", "relay"), OP_EQ, 3);
+  tt_i64_op(get_metric(METRICS_NAME(relay_begindir_cells_total), "prev_hop",
+                       "unknown_relay"), OP_EQ, 1);
+
+ done:
+  UNMOCK(connection_write_to_buf_impl_);
+  UNMOCK(networkstatus_get_latest_consensus);
+  if (mock_hsdir_ns) {
+    smartlist_free(mock_hsdir_ns->routerstatus_list);
+    tor_free(mock_hsdir_ns);
+  }
+  SMARTLIST_FOREACH(circuit_get_global_list(), circuit_t *, c,
+                    TO_OR_CIRCUIT(c)->p_chan = NULL);
+  circuit_free_all();
+  connection_free_minimal(TO_CONN(waiting));
+  tor_free(hsdir_reply);
+  tor_free(chan);
+}
