+
+/** Kind of the previous hop of a circuit, as this relay sees it. */
+typedef enum dos_prev_hop_t {
+  /** The channel never authenticated: a tor client or a bridge, which made
+   * a one-hop circuit to us. */
+  DOS_PREV_HOP_CLIENT,
+  /** An authenticated relay in our consensus, or whose descriptor we have. */
+  DOS_PREV_HOP_RELAY,
+  /** An authenticated relay identity we don't know: a relay newer than our
+   * consensus, or an unpublished one. */
+  DOS_PREV_HOP_UNKNOWN_RELAY,
+
+  DOS_PREV_HOP_MAX
+} dos_prev_hop_t;
+
+dos_prev_hop_t dos_get_prev_hop(const channel_t *chan);
+uint64_t dos_get_create_cells(dos_prev_hop_t prev_hop);
+uint64_t dos_get_begindir_cells(dos_prev_hop_t prev_hop);
+uint64_t dos_get_begindir_circs(dos_prev_hop_t prev_hop);
 uint64_t dos_get_dir_stat(dos_dir_stat_t stat);
 int dos_should_close_reused_hsdir_circ(void);
 int dos_should_refuse_unknown_hsdir_prev_hop(void);
@@ -224,7 +243,7 @@ typedef enum dos_stream_defense_type_t {
 dos_stream_defense_type_t dos_stream_new_begin_or_resolve_cell(
                                                           or_circuit_t *circ);
 void dos_stream_init_circ_tbf(or_circuit_t *circ);
-bool dos_should_refuse_begindir(const or_circuit_t *circ);
+bool dos_should_refuse_begindir(or_circuit_t *circ);
 
 #ifdef DOS_PRIVATE
 
