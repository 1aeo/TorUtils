+};
+
+/** Fill the metric <b>key</b> with <b>get</b>(kind) for each kind of
+ * previous hop. */
+static void
+fill_prev_hop_values(relay_metrics_key_t key,
+                     uint64_t (*get)(dos_prev_hop_t))
+{
+  uint64_t values[DOS_PREV_HOP_MAX];
+
+  for (int k = 0; k < DOS_PREV_HOP_MAX; k++)
+    values[k] = get(k);
+  fill_labeled_values(&base_metrics[key], "prev_hop", prev_hop_names,
+                      values, DOS_PREV_HOP_MAX);
+}
+
+static void
+fill_create_cell_values(void)
+{
+  fill_prev_hop_values(RELAY_METRICS_NUM_CREATE_CELLS, dos_get_create_cells);
+}
+
+static void
+fill_begindir_cell_values(void)
+{
+  fill_prev_hop_values(RELAY_METRICS_NUM_BEGINDIR_CELLS,
+                       dos_get_begindir_cells);
+}
+
+static void
+fill_begindir_circ_values(void)
+{
+  fill_prev_hop_values(RELAY_METRICS_NUM_BEGINDIR_CIRCS,
+                       dos_get_begindir_circs);
+}
+
+static uint64_t dir_requests[DIR_REQUEST_TYPE_COUNT][DOS_PREV_HOP_MAX];
 static const char *const dir_request_names[] = {
