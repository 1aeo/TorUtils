   return dos_dir_stats[stat];
 }
 
+/** CREATE cells, BEGIN_DIR cells, and circuits that sent a BEGIN_DIR cell,
+ * by kind of previous hop. */
+static uint64_t create_cells[DOS_PREV_HOP_MAX];
+static uint64_t begindir_cells[DOS_PREV_HOP_MAX];
+static uint64_t begindir_circs[DOS_PREV_HOP_MAX];
+
+/** Return the kind of previous hop of a circuit that came in on <b>chan</b>.
+ */
+dos_prev_hop_t
+dos_get_prev_hop(const channel_t *chan)
+{
+  if (channel_is_client(chan))
+    return DOS_PREV_HOP_CLIENT;
+  if (connection_or_digest_is_known_relay(chan->identity_digest))
+    return DOS_PREV_HOP_RELAY;
+  return DOS_PREV_HOP_UNKNOWN_RELAY;
+}
+
+/** Return the number of CREATE cells from a previous hop of kind
+ * <b>prev_hop</b>. */
+uint64_t
+dos_get_create_cells(dos_prev_hop_t prev_hop)
+{
+  return create_cells[prev_hop];
+}
+
+/** Return the number of BEGIN_DIR cells from a previous hop of kind
+ * <b>prev_hop</b>. */
+uint64_t
+dos_get_begindir_cells(dos_prev_hop_t prev_hop)
+{
+  return begindir_cells[prev_hop];
+}
+
+/** Return the number of circuits that sent a BEGIN_DIR cell, by kind of
+ * previous hop <b>prev_hop</b>. */
+uint64_t
+dos_get_begindir_circs(dos_prev_hop_t prev_hop)
+{
+  return begindir_circs[prev_hop];
+}
+
 /* Return whether the defense with the AUTOBOOL torrc option <b>opt</b> and
  * the consensus parameter <b>name</b> (default 0) is enabled. If we aren't a
  * public relay, it shouldn't apply to anything. */
@@ -917,6 +959,8 @@ dos_cc_new_create_cell(channel_t *chan)
 
   tor_assert(chan);
 
+  create_cells[dos_get_prev_hop(chan)]++;
+
   /* Skip everything if not enabled. */
   if (!dos_cc_enabled) {
     goto end;
@@ -1078,14 +1122,24 @@ dos_stream_new_begin_or_resolve_cell(or_circuit_t *circ)
 
 /** Return true iff we should refuse a BEGIN_DIR cell on <b>circ</b> because it
  * already has DoSBeginDirMaxStreams open directory streams. We count such
- * cells even when DoSBeginDirLimitEnabled is off. */
+ * cells even when DoSBeginDirLimitEnabled is off. We also count every
+ * BEGIN_DIR cell, and every circuit that sends one, by kind of previous hop,
+ * which we note on the circuit for its directory streams. */
 bool
-dos_should_refuse_begindir(const or_circuit_t *circ)
+dos_should_refuse_begindir(or_circuit_t *circ)
 {
   const dos_options_t *options = dos_get_options();
   int max = options->DoSBeginDirMaxStreams;
   int n = 0;
 
+  if (!circ->sent_begindir) {
+    circ->sent_begindir = 1;
+    if (circ->p_chan)
+      circ->begindir_prev_hop = dos_get_prev_hop(circ->p_chan);
+    begindir_circs[circ->begindir_prev_hop]++;
+  }
+  begindir_cells[circ->begindir_prev_hop]++;
+
   if (!max) {
     max = networkstatus_get_param(NULL, "DoSBeginDirMaxStreams",
                                   DOS_BEGINDIR_MAX_STREAMS_DEFAULT,
diff --git a/src/core/or/dos.h b/src/core/or/dos.h
