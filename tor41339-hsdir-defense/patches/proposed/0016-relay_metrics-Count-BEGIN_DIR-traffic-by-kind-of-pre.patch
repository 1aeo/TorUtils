+/* Relays count CREATE cells, BEGIN_DIR cells and the circuits that send them
+ * by kind of previous hop, whether or not any defense is enabled. */
+static void
+test_dos_prev_hop_counters(void *arg)
+{
+  channel_t *client = tor_malloc_zero(sizeof(channel_t));
+  channel_t *relay = tor_malloc_zero(sizeof(channel_t));
+  channel_t *unknown = tor_malloc_zero(sizeof(channel_t));
+  routerstatus_t known_rs;
+  or_circuit_t *circ1 = or_circuit_new(0, NULL);
+  or_circuit_t *circ2 = or_circuit_new(0, NULL);
+  (void) arg;
+
+  /* The relay's zeroed identity is in our consensus; the other isn't. */
+  client->is_client = 1;
+  memset(unknown->identity_digest, 0xff, DIGEST_LEN);
+  memset(&known_rs, 0, sizeof(known_rs));
+  dummy_ns = tor_malloc_zero(sizeof(networkstatus_t));
+  dummy_ns->routerstatus_list = smartlist_new();
+  smartlist_add(dummy_ns->routerstatus_list, &known_rs);
+  MOCK(networkstatus_get_latest_consensus,
+       mock_networkstatus_get_latest_consensus);
+  tt_int_op(dos_get_prev_hop(client), OP_EQ, DOS_PREV_HOP_CLIENT);
+  tt_int_op(dos_get_prev_hop(relay), OP_EQ, DOS_PREV_HOP_RELAY);
+  tt_int_op(dos_get_prev_hop(unknown), OP_EQ, DOS_PREV_HOP_UNKNOWN_RELAY);
+
+  dos_cc_new_create_cell(client);
+  dos_cc_new_create_cell(relay);
+  dos_cc_new_create_cell(relay);
+  tt_u64_op(dos_get_create_cells(DOS_PREV_HOP_CLIENT), OP_EQ, 1);
+  tt_u64_op(dos_get_create_cells(DOS_PREV_HOP_RELAY), OP_EQ, 2);
+  tt_u64_op(dos_get_create_cells(DOS_PREV_HOP_UNKNOWN_RELAY), OP_EQ, 0);
+
+  /* Three BEGIN_DIR cells on one circuit, one on another. */
+  circ1->p_chan = unknown;
+  circ2->p_chan = relay;
+  for (int i = 0; i < 3; i++)
+    tt_assert(!dos_should_refuse_begindir(circ1));
+  tt_assert(!dos_should_refuse_begindir(circ2));
+  tt_int_op(circ1->begindir_prev_hop, OP_EQ, DOS_PREV_HOP_UNKNOWN_RELAY);
+  tt_u64_op(dos_get_begindir_cells(DOS_PREV_HOP_UNKNOWN_RELAY), OP_EQ, 3);
+  tt_u64_op(dos_get_begindir_circs(DOS_PREV_HOP_UNKNOWN_RELAY), OP_EQ, 1);
+  tt_u64_op(dos_get_begindir_cells(DOS_PREV_HOP_RELAY), OP_EQ, 1);
+  tt_u64_op(dos_get_begindir_circs(DOS_PREV_HOP_RELAY), OP_EQ, 1);
+  tt_u64_op(dos_get_begindir_cells(DOS_PREV_HOP_CLIENT), OP_EQ, 0);
+
+ done:
+  UNMOCK(networkstatus_get_latest_consensus);
+  if (dummy_ns)
+    smartlist_free(dummy_ns->routerstatus_list);
+  tor_free(dummy_ns);
+  circ1->p_chan = circ2->p_chan = NULL;
+  circuit_free_all();
+  tor_free(client);
+  tor_free(relay);
+  tor_free(unknown);
+}
