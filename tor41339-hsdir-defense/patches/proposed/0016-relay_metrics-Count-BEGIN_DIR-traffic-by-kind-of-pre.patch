+
+  for (int t = 0; t < DIR_REQUEST_TYPE_COUNT; t++) {
+    for (int k = 0; k < DOS_PREV_HOP_MAX; k++) {
+      metrics_store_entry_t *sentry = metrics_store_add(
+          the_store, rentry->type, rentry->name, rentry->help, 0, NULL);
+      metrics_store_entry_add_label(sentry,
+                         metrics_format_label("type", dir_request_names[t]));
+      metrics_store_entry_add_label(sentry,
+                         metrics_format_label("prev_hop", prev_hop_names[k]));
+      metrics_store_entry_update(sentry, dir_requests[t][k]);
+    }
+  }
