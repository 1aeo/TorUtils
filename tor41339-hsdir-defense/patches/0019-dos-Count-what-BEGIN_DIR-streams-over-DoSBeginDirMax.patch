+  fill_labeled_values(
+               &base_metrics[RELAY_METRICS_NUM_BEGINDIR_REQUESTS_OVER_MAX],
+               NULL, NULL, "type", dir_request_names, dir_over_max_requests,
+               DIR_REQUEST_TYPE_COUNT);
 }
 
