+/** Tunneled directory requests on streams over DoSBeginDirMaxStreams: what
+ * DoSBeginDirLimitEnabled refuses, while it is off. */
+static uint64_t dir_over_max_requests[DIR_REQUEST_TYPE_COUNT];
+
 /** Count the request on the tunneled directory server connection <b>conn</b>
  * as <b>type</b>, once: later calls for <b>conn</b> do nothing. DirPort
