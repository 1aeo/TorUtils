+#define OVER_MAX_METRIC(type) \
+  get_metric(METRICS_NAME(relay_begindir_request_over_max_total), "type", \
+             (type))
+
+/* Requests on streams over DoSBeginDirMaxStreams are also counted by type,
+ * once, including streams that close without a request. */
+static void
+test_dir_over_max_request_metric(void *arg)
+{
+  dir_connection_t *over = NULL, *under = NULL;
+  int64_t micro0, none0, micro_all0;
+  (void) arg;
+
+  init_test();
+  MOCK(connection_write_to_buf_impl_, connection_write_to_buf_mock);
+  MOCK(connection_mark_for_close_internal_, hsdir_mock_mark_for_close);
+  micro0 = OVER_MAX_METRIC("microdesc");
+  none0 = OVER_MAX_METRIC("no_request");
+  micro_all0 = REQ_SUM("microdesc");
+
+  over = new_waiting_dir_conn(CHANNEL_PREV_HOP_CLIENT, NULL);
+  over->begindir_over_max = 1;
+  directory_handle_command_get(over, GET("/tor/micro/d/x"), NULL, 0);
+  under = new_waiting_dir_conn(CHANNEL_PREV_HOP_CLIENT, NULL);
+  directory_handle_command_get(under, GET("/tor/micro/d/x"), NULL, 0);
+  connection_dir_about_to_close(over);
+  tt_i64_op(OVER_MAX_METRIC("microdesc"), OP_EQ, micro0 + 1);
+  tt_i64_op(REQ_SUM("microdesc"), OP_EQ, micro_all0 + 2);
+  tt_i64_op(OVER_MAX_METRIC("no_request"), OP_EQ, none0);
+  connection_free_minimal(TO_CONN(over));
+  over = new_waiting_dir_conn(CHANNEL_PREV_HOP_KNOWN_RELAY, NULL);
+  over->begindir_over_max = 1;
+  connection_dir_about_to_close(over);
+  tt_i64_op(OVER_MAX_METRIC("no_request"), OP_EQ, none0 + 1);
+
+ done:
+  UNMOCK(connection_write_to_buf_impl_);
+  UNMOCK(connection_mark_for_close_internal_);
+  if (over)
+    connection_free_minimal(TO_CONN(over));
+  if (under)
+    connection_free_minimal(TO_CONN(under));
+}
+
