+/* HSDirs count fetches of a descriptor over HSDirDescriptorFetchRate, and
+ * only refuse them if HSDirDescriptorFetchLimit is set. */
+static void
+test_hsdir_desc_fetch_limit(void *arg)
+{
+  channel_t *chan = tor_malloc_zero(sizeof(channel_t));
+  ed25519_keypair_t signing_kp;
+  hs_descriptor_t *desc = NULL;
+  char *desc_str = NULL, *get = NULL;
+  char key[ED25519_BASE64_LEN+1];
+  dos_options_t *dos_opts;
+  or_circuit_t *circ;
+  int64_t served;
+  uint64_t monotime_now = 0xfffffffe;
+  (void) arg;
+
+  init_test();
+  monotime_enable_test_mocking();
+  monotime_coarse_set_mock_time_nsec(monotime_now);
+  MOCK(connection_write_to_buf_impl_, connection_write_to_buf_mock);
+  MOCK(circuit_mark_for_close_, mock_circuit_mark_for_close);
+  get_options_mutable()->ORPort_set = 1; /* Accept descriptor uploads. */
+  dos_opts = get_dos_options(get_options_mutable());
+  dos_opts->HSDirDescriptorFetchRate = 1;
+  dos_opts->HSDirDescriptorFetchBurst = 2;
+  tt_int_op(ed25519_keypair_generate(&signing_kp, 0), OP_EQ, 0);
+  desc = hs_helper_build_hs_desc_with_ip(&signing_kp);
+  tt_int_op(hs_desc_encode_descriptor(desc, &signing_kp, NULL, &desc_str),
+            OP_EQ, 0);
+  tt_int_op(hs_cache_store_as_dir(desc_str), OP_EQ, 0);
+  ed25519_public_to_base64(key, &desc->plaintext_data.blinded_pubkey);
+  tor_asprintf(&get, GET("/tor/hs/3/%s"), key);
+  served = GET_METRIC("success");
+
+  /* By default, a fetch over the burst is counted but served. */
+  for (int i = 0; i < 3; i++) {
+    hsdir_request_on_new_circ(chan, get, NULL);
+    tt_assert(strstr(hsdir_reply, " 200 "));
+  }
+  tt_u64_op(dos_get_dir_stat(DOS_DIR_HSDIR_FETCH_OVER_RATE), OP_EQ, 1);
+  tt_i64_op(GET_METRIC("success"), OP_EQ, served + 3);
+
+  /* With the limit, it closes the circuit without an answer. */
+  dos_opts->HSDirDescriptorFetchLimit = 1;
+  circ = or_circuit_new(0, NULL);
+  circ->p_chan = chan;
+  hsdir_request_on_circ(circ, get, NULL);
+  tt_str_op(hsdir_reply, OP_EQ, "");
+  tt_int_op(TO_CIRCUIT(circ)->marked_for_close_reason, OP_EQ,
+            END_CIRC_REASON_RESOURCELIMIT);
+  tt_u64_op(dos_get_dir_stat(DOS_DIR_HSDIR_FETCH_OVER_RATE), OP_EQ, 2);
+  tt_i64_op(GET_METRIC("success"), OP_EQ, served + 3);
+
+  /* A second later, the descriptor is served again. */
+  monotime_coarse_set_mock_time_nsec(monotime_now + 1000000000);
+  hsdir_request_on_new_circ(chan, get, NULL);
+  tt_assert(strstr(hsdir_reply, " 200 "));
+
+ done:
+  monotime_disable_test_mocking();
+  UNMOCK(connection_write_to_buf_impl_);
+  UNMOCK(circuit_mark_for_close_);
+  SMARTLIST_FOREACH(circuit_get_global_list(), circuit_t *, c,
+                    TO_OR_CIRCUIT(c)->p_chan = NULL);
+  circuit_free_all();
+  tor_free(hsdir_reply);
+  tor_free(chan);
+  hs_descriptor_free(desc);
+  tor_free(desc_str);
+  tor_free(get);
+}
