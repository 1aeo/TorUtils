@@ -0,0 +1,6 @@
+  o Minor features (DoS-resistance, onion service directory):
+    - Add the HSDirDescriptorFetchLimit, HSDirDescriptorFetchRate and
+      HSDirDescriptorFetchBurst options. When enabled (off by default), an
+      HSDir closes circuits that fetch a cached onion service descriptor
+      more often than that descriptor's rate limit allows. Part of ticket
+      41339.
diff --git a/doc/man/tor.1.txt b/doc/man/tor.1.txt
index ae5a7d075a..6c5260add1 100644
--- a/doc/man/tor.1.txt
+++ b/doc/man/tor.1.txt
@@ -3183,6 +3183,25 @@ MetricsPort.
     the consensus parameter. If not defined in the consensus, the value is 0.
     (Default: auto)
 
+[[HSDirDescriptorFetchLimit]] **HSDirDescriptorFetchLimit** **0**|**1**::
+
+    Close a circuit that fetches an onion service descriptor more often than
+    HSDirDescriptorFetchRate and HSDirDescriptorFetchBurst allow. Each
+    descriptor has one limit shared by all its clients, so a single client
+    can use it up and deny the descriptor to everyone else on this HSDir;
+    they can still fetch it from its other HSDirs. Only enable it to save
+    bandwidth during a flood of fetches. (Default: 0)
+
+[[HSDirDescriptorFetchRate]] **HSDirDescriptorFetchRate** __NUM__::
+
+    The allowed rate of fetches of each cached onion service descriptor per
+    second. See HSDirDescriptorFetchLimit. (Default: 5)
+
+[[HSDirDescriptorFetchBurst]] **HSDirDescriptorFetchBurst** __NUM__::
+
+    The allowed burst of fetches of each cached onion service descriptor. See
+    HSDirDescriptorFetchLimit. (Default: 20)
+
 
 For onion services, mitigations are a work in progress and multiple options
 are currently available.
diff --git a/src/core/or/dos.c b/src/core/or/dos.c
index 740fc53c91..93e760f23a 100644
--- a/src/core/or/dos.c
+++ b/src/core/or/dos.c
@@ -751,6 +751,32 @@ dos_should_refuse_unknown_hsdir_prev_hop(void)
                              "HSDirRefuseUnknownPrevHop");
 }
 
+/** Take a token from <b>bucket</b>, the fetch rate limiter of a cached onion
+ * service descriptor. Return false iff it was empty and
+ * HSDirDescriptorFetchLimit is set; we count empty buckets either way. */
+bool
+dos_hsdir_desc_fetch_allowed(token_bucket_ctr_t *bucket)
+{
+  const dos_options_t *options = dos_get_options();
+  const uint32_t rate = MAX(options->HSDirDescriptorFetchRate, 1);
+  const uint32_t burst = MAX(options->HSDirDescriptorFetchBurst, 1);
+  const uint32_t now = (uint32_t) monotime_coarse_absolute_sec();
+
+  if (!bucket->cfg.rate) {
+    token_bucket_ctr_init(bucket, rate, burst, now);
+  } else if (bucket->cfg.rate != rate ||
+             (uint32_t) bucket->cfg.burst != burst) {
+    token_bucket_ctr_adjust(bucket, rate, burst);
+  }
+  token_bucket_ctr_refill(bucket, now);
+  if (token_bucket_ctr_get(bucket) > 0) {
+    token_bucket_ctr_dec(bucket, 1);
+    return true;
+  }
+  dos_note_dir_stat(DOS_DIR_HSDIR_FETCH_OVER_RATE);
+  return !options->HSDirDescriptorFetchLimit;
+}
+
 /* Called when a CREATE cell is received from the given channel. */
 void
 dos_cc_new_create_cell(channel_t *chan)
@@ -1170,6 +1196,15 @@ dos_log_heartbeat(void)
     smartlist_add_asprintf(elems, "[HSDirRefuseUnknownPrevHop disabled]");
   }
 
+  if (dos_get_options()->HSDirDescriptorFetchLimit) {
+    smartlist_add_asprintf(elems,
+                           "%" PRIu64 " HSDir descriptor fetches over the "
+                           "rate",
+                           dos_dir_stats[DOS_DIR_HSDIR_FETCH_OVER_RATE]);
+  } else {
+    smartlist_add_asprintf(elems, "[HSDirDescriptorFetchLimit disabled]");
+  }
+
   char *msg = smartlist_join_strings(elems, ", ", 0, NULL);
 
   log_notice(LD_HEARTBEAT,
