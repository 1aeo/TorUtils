+/* Without a MetricsPort, a relay doesn't remember descriptor fetches either:
+ * once one is added, a descriptor's next fetch is its first. */
+static void
+test_hsdir_fetch_target_metrics_port(void *arg)
+{
+  int64_t first0, again0;
+  (void) arg;
+
+  first0 = FETCH_TARGET_METRIC("not_found", "1");
+  again0 = FETCH_TARGET_METRIC("not_found", "2_10");
+  update_approx_time(1800000000); /* The start of a minute. */
+  relay_note_hsdir_fetch_target(fetch_target_key(1), false);
+  get_options_mutable()->MetricsPort_set = 1;
+  relay_note_hsdir_fetch_target(fetch_target_key(1), false);
+  tt_i64_op(FETCH_TARGET_METRIC("not_found", "1"), OP_EQ, first0 + 1);
+  tt_i64_op(FETCH_TARGET_METRIC("not_found", "2_10"), OP_EQ, again0);
+
+ done:
+  get_options_mutable()->MetricsPort_set = 0;
+}
