+/* The slot where relay_note_hsdir_fetch_target() starts to look for the
+ * descriptor with blinded key <b>key</b>. */
+static unsigned
+fetch_target_slot(const ed25519_public_key_t *key)
+{
+  return (unsigned) (siphash24g(key->pubkey, sizeof(key->pubkey)) %
+                     FETCH_TARGET_SLOTS);
+}
+
+/* A fetch looks for its descriptor in the FETCH_TARGET_PROBES (16) slots
+ * from its own: of 17 descriptors that start at the same slot, 16 are found
+ * again and the 17th counts as a first fetch each time, until the minute
+ * ends. The keys all start at the table's last slot, so that their probes
+ * wrap to its start, and are chosen by slot, so this holds whatever the
+ * siphash key. */
+static void
+test_hsdir_fetch_target_probing(void *arg)
+{
+  const time_t t0 = 1800000000; /* The start of a minute. */
+  const int n_keys = FETCH_TARGET_PROBES + 1;
+  uint32_t keys[FETCH_TARGET_PROBES + 1];
+  unsigned slot;
+  int64_t first0, again0;
+  int n = 1;
+  (void) arg;
+
+  keys[0] = 1;
+  while (fetch_target_slot(fetch_target_key(keys[0])) !=
+         FETCH_TARGET_SLOTS - 1)
+    keys[0]++;
+  slot = fetch_target_slot(fetch_target_key(keys[0]));
+  for (uint32_t i = keys[0] + 1; n < n_keys && i < 10000000; i++) {
+    if (fetch_target_slot(fetch_target_key(i)) == slot)
+      keys[n++] = i;
+  }
+  tt_int_op(n, OP_EQ, n_keys);
+  get_options_mutable()->MetricsPort_set = 1;
+  first0 = FETCH_TARGET_METRIC("not_found", "1");
+  again0 = FETCH_TARGET_METRIC("not_found", "2_10");
+  update_approx_time(t0);
+
+  /* The first key twice, then the others twice each: the last one finds no
+   * slot, so both its fetches are first fetches. */
+  relay_note_hsdir_fetch_target(fetch_target_key(keys[0]), false);
+  relay_note_hsdir_fetch_target(fetch_target_key(keys[0]), false);
+  for (int i = 1; i < n_keys; i++)
+    relay_note_hsdir_fetch_target(fetch_target_key(keys[i]), false);
+  for (int i = 1; i < n_keys; i++)
+    relay_note_hsdir_fetch_target(fetch_target_key(keys[i]), false);
+  tt_i64_op(FETCH_TARGET_METRIC("not_found", "1"), OP_EQ,
+            first0 + n_keys + 1);
+  tt_i64_op(FETCH_TARGET_METRIC("not_found", "2_10"), OP_EQ,
+            again0 + n_keys - 1);
+  /* The last second of the same minute. */
+  update_approx_time(t0 + 59);
+  relay_note_hsdir_fetch_target(fetch_target_key(keys[1]), false);
+  tt_i64_op(FETCH_TARGET_METRIC("not_found", "2_10"), OP_EQ, again0 + n_keys);
+
+ done:
+  ;
+}
+
+/* Two keys that differ only in their last byte are two descriptors. */
+static void
+test_hsdir_fetch_target_whole_key(void *arg)
+{
+  ed25519_public_key_t a, b;
+  int64_t first0, again0;
+  (void) arg;
+
+  memset(&a, 0x55, sizeof(a));
+  memcpy(&b, &a, sizeof(b));
+  b.pubkey[sizeof(b.pubkey) - 1] ^= 1;
+  get_options_mutable()->MetricsPort_set = 1;
+  first0 = FETCH_TARGET_METRIC("found", "1");
+  again0 = FETCH_TARGET_METRIC("found", "2_10");
+  update_approx_time(1800000000); /* The start of a minute. */
+  relay_note_hsdir_fetch_target(&a, true);
+  relay_note_hsdir_fetch_target(&b, true);
+  tt_i64_op(FETCH_TARGET_METRIC("found", "1"), OP_EQ, first0 + 2);
+  tt_i64_op(FETCH_TARGET_METRIC("found", "2_10"), OP_EQ, again0);
+
+ done:
+  ;
+}
+
+/* Fetches of two different keys are two first fetches, even when the keys
+ * don't decode and share their first 40 characters, which base64_decode()
+ * decodes before it fails. */
+static void
+test_hsdir_fetch_target_long_keys(void *arg)
+{
+  channel_t *chan = new_fake_channel();
+  char key[61], *req = NULL;
+  int64_t first0, again0;
+  (void) arg;
+
+  init_test();
+  MOCK(connection_write_to_buf_impl_, connection_write_to_buf_mock);
+  get_options_mutable()->MetricsPort_set = 1;
+  update_approx_time(1800000000); /* The start of a minute. */
+  first0 = FETCH_TARGET_METRIC("not_found", "1");
+  again0 = FETCH_TARGET_METRIC("not_found", "2_10");
+  memset(key, 'a', sizeof(key) - 1);
+  key[sizeof(key) - 1] = '\0';
+  tor_asprintf(&req, GET("/tor/hs/3/%s"), key);
+  hsdir_request_on_new_circ(chan, req, NULL);
+  tor_free(req);
+  key[sizeof(key) - 2] = 'b';
+  tor_asprintf(&req, GET("/tor/hs/3/%s"), key);
+  hsdir_request_on_new_circ(chan, req, NULL);
+  tt_i64_op(FETCH_TARGET_METRIC("not_found", "1"), OP_EQ, first0 + 2);
+  tt_i64_op(FETCH_TARGET_METRIC("not_found", "2_10"), OP_EQ, again0);
+
+ done:
+  UNMOCK(connection_write_to_buf_impl_);
+  tor_free(req);
+  SMARTLIST_FOREACH(circuit_get_global_list(), circuit_t *, c,
+                    TO_OR_CIRCUIT(c)->p_chan = NULL);
+  circuit_free_all();
+  free_fake_channel(chan);
+}
