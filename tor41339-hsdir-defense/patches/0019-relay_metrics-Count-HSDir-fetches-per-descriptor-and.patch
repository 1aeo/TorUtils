+/* The blinded key numbered <b>i</b>, for tests. */
+static const ed25519_public_key_t *
+fetch_target_key(uint32_t i)
+{
+  static ed25519_public_key_t key;
+
+  set_uint32(key.pubkey, i);
+  return &key;
+}
