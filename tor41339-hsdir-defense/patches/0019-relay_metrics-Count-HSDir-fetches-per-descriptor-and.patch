+  relay_note_hsdir_fetch_target(fetch_target_key(3), false);
+  get_options_mutable()->BridgeRelay = 0;
+  get_options_mutable()->MetricsPort_set = 0;
+  relay_note_hsdir_fetch_target(fetch_target_key(3), false);
+  tt_i64_op(FETCH_TARGET_METRIC("not_found", "1001_plus"), OP_EQ, 1);
+
+ done:
