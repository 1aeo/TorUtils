+/* Descriptor fetches are counted by their place among the fetches of the
+ * same descriptor in the same minute, found and missing apart. A minute with
+ * more descriptors than the table holds counts the rest as first fetches, as
+ * it does keys that don't decode. */
+static void
+test_hsdir_fetch_target_metrics(void *arg)
+{
+  const time_t t0 = 1800000000; /* The start of a minute. */
+  const char *bands[] = { "1", "2_10", "11_100", "101_1000", "1001_plus" };
+  int64_t found0[ARRAY_LENGTH(bands)], missing0[ARRAY_LENGTH(bands)];
+  (void) arg;
+
+  get_options_mutable()->MetricsPort_set = 1;
+  for (size_t i = 0; i < ARRAY_LENGTH(bands); i++) {
+    found0[i] = FETCH_TARGET_METRIC("found", bands[i]);
+    missing0[i] = FETCH_TARGET_METRIC("not_found", bands[i]);
+  }
+  update_approx_time(t0);
+  for (int i = 0; i < 12; i++)
+    relay_note_hsdir_fetch_target(fetch_target_key(1), true);
+  relay_note_hsdir_fetch_target(fetch_target_key(2), false);
+  relay_note_hsdir_fetch_target(fetch_target_key(2), false);
+  tt_i64_op(FETCH_TARGET_METRIC("found", "1"), OP_EQ, found0[0] + 1);
+  tt_i64_op(FETCH_TARGET_METRIC("found", "2_10"), OP_EQ, found0[1] + 9);
+  tt_i64_op(FETCH_TARGET_METRIC("found", "11_100"), OP_EQ, found0[2] + 2);
+  tt_i64_op(FETCH_TARGET_METRIC("not_found", "1"), OP_EQ, missing0[0] + 1);
+  tt_i64_op(FETCH_TARGET_METRIC("not_found", "2_10"), OP_EQ, missing0[1] + 1);
+  /* Keys that don't decode are each a first fetch. */
+  relay_note_hsdir_fetch_target(NULL, false);
+  relay_note_hsdir_fetch_target(NULL, false);
+  tt_i64_op(FETCH_TARGET_METRIC("not_found", "1"), OP_EQ, missing0[0] + 3);
+  tt_i64_op(FETCH_TARGET_METRIC("not_found", "2_10"), OP_EQ, missing0[1] + 1);
+
+  /* A new minute starts over. */
+  update_approx_time(t0 + 60);
+  relay_note_hsdir_fetch_target(fetch_target_key(1), true);
+  tt_i64_op(FETCH_TARGET_METRIC("found", "1"), OP_EQ, found0[0] + 2);
+
