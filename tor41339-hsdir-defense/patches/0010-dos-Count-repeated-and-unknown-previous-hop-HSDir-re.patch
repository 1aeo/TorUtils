+
+/* HSDirs count anonymous onion service directory requests, the requests and
+ * circuits that repeat them, and those whose previous hop is not a known
+ * relay. */
+static void
+test_hsdir_reuse_and_prev_hop_counters(void *arg)
+{
+  channel_t *chan = tor_malloc_zero(sizeof(channel_t));
+  routerstatus_t known_rs;
+  or_circuit_t *circ;
+  uint64_t req0, reused0, circ0, unknown0;
+  (void) arg;
+
+  init_test();
+  MOCK(connection_write_to_buf_impl_, connection_write_to_buf_mock);
+  get_options_mutable()->ORPort_set = 1; /* Accept descriptor uploads. */
+  /* Other tests may have counted requests before we forked. */
+  req0 = dos_get_dir_stat(DOS_DIR_HSDIR_REQUEST);
+  reused0 = dos_get_dir_stat(DOS_DIR_HSDIR_REQ_REUSED);
+  circ0 = dos_get_dir_stat(DOS_DIR_HSDIR_CIRC_REUSED);
+  unknown0 = dos_get_dir_stat(DOS_DIR_HSDIR_UNKNOWN_PREV_HOP);
+
+  /* Three requests on one circuit, one on another: the zeroed previous hop
+   * identity is not a known relay. */
+  circ = or_circuit_new(0, NULL);
+  circ->p_chan = chan;
+  for (int i = 0; i < 3; i++)
+    hsdir_request_on_circ(circ, GET("/tor/hs/3/x"), NULL);
+  hsdir_request_on_new_circ(chan, "POST /tor/hs/3/publish HTTP/1.0\r\n\r\n",
+                            "x");
+  tt_u64_op(dos_get_dir_stat(DOS_DIR_HSDIR_REQUEST), OP_EQ, req0 + 4);
+  tt_u64_op(dos_get_dir_stat(DOS_DIR_HSDIR_REQ_REUSED), OP_EQ, reused0 + 2);
+  tt_u64_op(dos_get_dir_stat(DOS_DIR_HSDIR_CIRC_REUSED), OP_EQ, circ0 + 1);
+  tt_u64_op(dos_get_dir_stat(DOS_DIR_HSDIR_UNKNOWN_PREV_HOP), OP_EQ,
+            unknown0 + 4);
+  tt_i64_op(get_metric(METRICS_NAME(relay_dos_total), "type",
+                       "hsdir_circ_reused"), OP_EQ, circ0 + 1);
+
+  /* A previous hop in our consensus is known. */
+  memset(&known_rs, 0, sizeof(known_rs)); /* Matches the zeroed identity. */
+  mock_hsdir_ns = tor_malloc_zero(sizeof(networkstatus_t));
+  mock_hsdir_ns->routerstatus_list = smartlist_new();
+  smartlist_add(mock_hsdir_ns->routerstatus_list, &known_rs);
+  MOCK(networkstatus_get_latest_consensus, mock_hsdir_get_latest_consensus);
+  hsdir_request_on_new_circ(chan, GET("/tor/hs/3/x"), NULL);
+  tt_u64_op(dos_get_dir_stat(DOS_DIR_HSDIR_REQUEST), OP_EQ, req0 + 5);
+  tt_u64_op(dos_get_dir_stat(DOS_DIR_HSDIR_UNKNOWN_PREV_HOP), OP_EQ,
+            unknown0 + 4);
+
+  /* Single-hop requests are refused, and not counted here. */
+  chan->is_client = 1;
+  hsdir_request_on_new_circ(chan, GET("/tor/hs/3/x"), NULL);
+  tt_u64_op(dos_get_dir_stat(DOS_DIR_HSDIR_REQUEST), OP_EQ, req0 + 5);
+
+ done:
+  UNMOCK(connection_write_to_buf_impl_);
+  UNMOCK(networkstatus_get_latest_consensus);
+  if (mock_hsdir_ns) {
+    smartlist_free(mock_hsdir_ns->routerstatus_list);
+    tor_free(mock_hsdir_ns);
+  }
+  SMARTLIST_FOREACH(circuit_get_global_list(), circuit_t *, c,
+                    TO_OR_CIRCUIT(c)->p_chan = NULL);
+  circuit_free_all();
+  tor_free(chan);
+}
