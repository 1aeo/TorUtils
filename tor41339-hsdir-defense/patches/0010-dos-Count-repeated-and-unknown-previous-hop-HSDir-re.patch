+/** Count the onion service directory request on <b>conn</b>, which
+ * connection_dir_is_anonymous() accepted: every request, every repeat on the
+ * same circuit and each such circuit once, and every request whose previous
+ * hop is not a known relay. Stock tor and Arti make each of these requests on
+ * its own circuit, through a relay in the consensus. */
+static void
+note_hs_dir_request(dir_connection_t *conn)
+{
+  or_circuit_t *circ =
+    TO_OR_CIRCUIT(TO_EDGE_CONN(TO_CONN(conn)->linked_conn)->on_circuit);
+  const unsigned int prev_reqs = circ->n_hsdir_requests;
+
+  dos_note_dir_stat(DOS_DIR_HSDIR_REQUEST);
+  if (prev_reqs >= 1)
+    dos_note_dir_stat(DOS_DIR_HSDIR_REQ_REUSED);
+  if (prev_reqs == 1)
+    dos_note_dir_stat(DOS_DIR_HSDIR_CIRC_REUSED);
+  if (prev_reqs < 2)
+    circ->n_hsdir_requests = prev_reqs + 1;
+  if (!connection_or_digest_is_known_relay(circ->p_chan->identity_digest))
+    dos_note_dir_stat(DOS_DIR_HSDIR_UNKNOWN_PREV_HOP);
+}
+
 /** Helper function for GET `/tor/hs/3/...`. Only for version 3.
  */
 STATIC int
@@ -1373,6 +1403,7 @@ handle_get_hs_descriptor_v3(dir_connection_t *conn,
                               "Rejecting single hop HS v3 descriptor request");
     goto done;
   }
+  note_hs_dir_request(conn);
 
   /* After the path prefix follows the base64 encoded blinded pubkey which we
    * use to get the descriptor from the cache. Skip the prefix and get the
@@ -1634,6 +1665,7 @@ directory_handle_command_post,(dir_connection_t *conn, const char *headers,
                                 "Rejecting single hop HS descriptor post");
       goto done;
     }
+    note_hs_dir_request(conn);
     const char *msg = "HS descriptor stored successfully.";
 
     /* We most probably have a publish request for an HS descriptor. */
