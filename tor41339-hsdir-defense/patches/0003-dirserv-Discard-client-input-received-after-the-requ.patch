From 5a08e49137a0ff8fdd9af48c99a824953d34884a Mon Sep 17 00:00:00 2001
From: 1aeo <github@1aeo.com>
Date: Wed, 14 Oct 2026 01:49:22 +0000
Subject: [PATCH 03/15] dirserv: Discard client input received after the
 request

A directory server handles one request per connection, but it keeps
reading while it writes its answer. connection_dir_process_inbuf() then
buffered whatever else the client sent, up to MAX_DIRECTORY_OBJECT_SIZE
(10 MB), before closing the connection with an unthrottled "Too much
data received" warning. So a client that stops reading its answer but
keeps sending could make a relay hold about 10 MB per stream.

Discard that input instead. Once directory_handle_command() has consumed
the request and moved the connection to SERVER_WRITING, we clear the
input in that same pass, so bytes that arrived together with the request
are dropped too; a still-incomplete request is left in
SERVER_COMMAND_WAIT and kept.

We don't close the connection, so a client that sends a stray CRLF after
its request still gets its answer, and we don't stop reading, since
linked connections only notice EOF while reading. A client that keeps
sending without reading its answer is still closed by the
TestingDirConnectionMaxStall timeout, and the OOM handler still covers
these connections.

Related to #41339.
---
 changes/dirserv_extra_input       |  4 ++
 src/feature/dircommon/directory.c | 17 +++++++++
 src/test/test_dir_handle_get.c    | 63 +++++++++++++++++++++++++++++++
 3 files changed, 84 insertions(+)
 create mode 100644 changes/dirserv_extra_input

diff --git a/changes/dirserv_extra_input b/changes/dirserv_extra_input
new file mode 100644
index 0000000000..449cdfb7f7
--- /dev/null
+++ b/changes/dirserv_extra_input
@@ -0,0 +1,4 @@
+  o Minor features (directory server, denial of service):
+    - Directory servers now discard anything a client sends after its
+      request, instead of buffering up to 10 MB of it per connection while
+      they send their answer. Related to ticket 41339.
diff --git a/src/feature/dircommon/directory.c b/src/feature/dircommon/directory.c
index 6b5c38c7c1..b8b01973ba 100644
--- a/src/feature/dircommon/directory.c
+++ b/src/feature/dircommon/directory.c
@@ -18,6 +18,7 @@
 #include "feature/dircommon/fp_pair.h"
 #include "feature/hs/hs_cache.h"
 #include "feature/stats/geoip_stats.h"
+#include "lib/buf/buffers.h"
 #include "lib/compress/compress.h"
 
 #include "core/or/circuit_st.h"
@@ -491,6 +492,22 @@ connection_dir_process_inbuf(dir_connection_t *conn)
       connection_mark_for_close(TO_CONN(conn));
       return -1;
     }
+    /* Fall through to discard any trailing bytes once in SERVER_WRITING. */
+  }
+
+  /* On the server side, once the request is read and we are writing the
+   * response, discard anything else the client sends (whether in the same read
+   * or a later one) instead of buffering it. A still-incomplete request stays
+   * in COMMAND_WAIT and is kept for the next read. We don't close the
+   * connection, so a client that sends a stray CRLF after its request still
+   * gets its answer, and we don't stop reading, since linked connections only
+   * notice EOF while reading. Memory stays bounded because each read is
+   * discarded at once; a client that keeps sending without reading its answer
+   * is closed by the TestingDirConnectionMaxStall timeout, and the OOM handler
+   * still covers these connections. */
+  if (DIR_CONN_IS_SERVER(TO_CONN(conn))) {
+    if (conn->base_.state == DIR_CONN_STATE_SERVER_WRITING)
+      buf_clear(TO_CONN(conn)->inbuf);
     return 0;
   }
 
diff --git a/src/test/test_dir_handle_get.c b/src/test/test_dir_handle_get.c
index b4e69d19b6..6c75b9d935 100644
--- a/src/test/test_dir_handle_get.c
+++ b/src/test/test_dir_handle_get.c
@@ -2785,6 +2785,68 @@ test_dir_handle_get_hs_post_size_limit(void *data)
   UNMOCK(connection_write_to_buf_impl_);
 }
 
+/* Helper: feed `in` (`in_len` bytes) into a dir connection with `purpose` and
+ * `state`, run connection_dir_process_inbuf(), and verify the resulting state
+ * and remaining inbuf length. */
+static void
+check_dir_inbuf(uint8_t purpose, uint8_t state,
+                const char *in, size_t in_len,
+                uint8_t exp_state, size_t exp_inbuf)
+{
+  dir_connection_t *conn = new_dir_conn();
+  TO_CONN(conn)->purpose = purpose;
+  TO_CONN(conn)->state = state;
+  buf_add(TO_CONN(conn)->inbuf, in, in_len);
+  tt_int_op(connection_dir_process_inbuf(conn), OP_EQ, 0);
+  tt_int_op(TO_CONN(conn)->state, OP_EQ, exp_state);
+  tt_size_op(connection_get_inbuf_len(TO_CONN(conn)), OP_EQ, exp_inbuf);
+  tt_assert(!TO_CONN(conn)->marked_for_close);
+ done:
+  connection_free_minimal(TO_CONN(conn));
+}
+
+/* Verify that a dirserver discards trailing client input once it enters
+ * DIR_CONN_STATE_SERVER_WRITING (whether in the same read, a subsequent read,
+ * or >10 MB), while preserving partial server commands and client replies. */
+static void
+test_dir_handle_get_server_discards_extra_input(void *data)
+{
+  /* Content-Length: 0 bounds the body, so TRAILING survives the HTTP parser
+   * and only the discard can remove it. */
+  const char *req_trail =
+    "GET / HTTP/1.0\r\nContent-Length: 0\r\n\r\nTRAILING";
+  const char *req = "GET / HTTP/1.0\r\n\r\n";
+  const char *partial = "GET / HTTP/1.0\r\n";
+  const char *resp = "HTTP/1.0 200 OK\r\n\r\nbody";
+  const size_t big = 11 * 1024 * 1024;
+  char *junk = tor_malloc_zero(big);
+  (void) data;
+
+  MOCK(connection_write_to_buf_impl_, connection_write_to_buf_mock);
+
+  /* 1. Trailing bytes in the same read as a complete request are discarded. */
+  check_dir_inbuf(DIR_PURPOSE_SERVER, DIR_CONN_STATE_SERVER_COMMAND_WAIT,
+                  req_trail, strlen(req_trail),
+                  DIR_CONN_STATE_SERVER_WRITING, 0);
+  /* 2. Later bytes arriving while already in SERVER_WRITING are discarded. */
+  check_dir_inbuf(DIR_PURPOSE_SERVER, DIR_CONN_STATE_SERVER_WRITING,
+                  req, strlen(req), DIR_CONN_STATE_SERVER_WRITING, 0);
+  /* 3. Over 10 MB of trailing input is discarded without closing. */
+  check_dir_inbuf(DIR_PURPOSE_SERVER, DIR_CONN_STATE_SERVER_WRITING,
+                  junk, big, DIR_CONN_STATE_SERVER_WRITING, 0);
+  /* 4. Partial server command stays in inbuf while in COMMAND_WAIT. */
+  check_dir_inbuf(DIR_PURPOSE_SERVER, DIR_CONN_STATE_SERVER_COMMAND_WAIT,
+                  partial, strlen(partial),
+                  DIR_CONN_STATE_SERVER_COMMAND_WAIT, strlen(partial));
+  /* 5. Directory clients keep their response body. */
+  check_dir_inbuf(DIR_PURPOSE_FETCH_CONSENSUS, DIR_CONN_STATE_CLIENT_READING,
+                  resp, strlen(resp),
+                  DIR_CONN_STATE_CLIENT_READING, strlen(resp));
+
+  UNMOCK(connection_write_to_buf_impl_);
+  tor_free(junk);
+}
+
 #define DIR_HANDLE_CMD(name,flags) \
   { #name, test_dir_handle_get_##name, (flags), NULL, NULL }
 
@@ -2857,5 +2919,6 @@ struct testcase_t dir_handle_get_tests[] = {
   DIR_HANDLE_CMD(parse_accept_encoding, 0),
   DIR_HANDLE_CMD(malformed_warn_ratelim, TT_FORK),
   DIR_HANDLE_CMD(hs_post_size_limit, TT_FORK),
+  DIR_HANDLE_CMD(server_discards_extra_input, TT_FORK),
   END_OF_TESTCASES
 };
