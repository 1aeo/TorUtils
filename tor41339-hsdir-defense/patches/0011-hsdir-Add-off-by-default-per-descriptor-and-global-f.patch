+/* Outcome metrics (hsdir_get_found, hsdir_get_not_found, hsdir_post_*,
+ * hsdir_desc_rate_limited, hsdir_global_rate_limited, begindir_*_limited) and
+ * the off-by-default HSDir*LimitEnabled and DoSStreamCreation* limiters always
+ * count and only enforce when enabled via torrc or consensus. */
+static void
+test_hsdir_rate_limits_and_metrics(void *arg)
+{
+  channel_t *chan = tor_malloc_zero(sizeof(channel_t));
+  dos_options_t *dos_opts;
+  hs_descriptor_t *desc = NULL;
+  char *desc_str = NULL, *fetched = NULL;
+  const ed25519_public_key_t *blinded_key;
+  ed25519_keypair_t signing_kp;
+  or_circuit_t *mcirc = NULL, *pcirc = NULL, *bcirc = NULL;
+  edge_connection_t *live_stream = NULL;
+  const uint64_t non_hs_before = dos_get_dir_stat(DOS_DIR_NON_HS_REQUEST);
+  (void) arg;
+
+  init_test();
+  MOCK(circuit_mark_for_close_, mock_circuit_mark_for_close);
+  get_options_mutable()->ORPort_set = 1;
+  dos_opts = get_dos_options(get_options_mutable());
+
+  /* Generate one valid descriptor and publish it over POST. */
+  tt_int_op(ed25519_keypair_generate(&signing_kp, 0), OP_EQ, 0);
+  desc = hs_helper_build_hs_desc_with_ip(&signing_kp);
+  tt_assert(desc);
+  tt_int_op(hs_desc_encode_descriptor(desc, &signing_kp, NULL, &desc_str),
+            OP_EQ, 0);
+  blinded_key = &desc->plaintext_data.blinded_pubkey;
+
+  /* 1. Outcome counters: 1 miss (404), 1 invalid POST (400), 1 valid POST
+   * (200), and 3 hits (200). With HSDirDescriptorBurst=2, HSDirGlobalBurst=2,
+   * and enforcement off, the 3rd hit is still served and increments both
+   * rate-limit counters. */
+  dos_opts->HSDirDescriptorRate = 1;
+  dos_opts->HSDirDescriptorBurst = 2;
+  dos_opts->HSDirGlobalRate = 1;
+  dos_opts->HSDirGlobalBurst = 2;
+  mcirc = or_circuit_new(0, NULL);
+  mcirc->p_chan = chan;
+  tt_size_op(helper_hs_request_on_circ(mcirc, false), OP_GT, 0); /* 404 */
+  tt_u64_op(dos_get_dir_stat(DOS_DIR_HSDIR_GET_NOT_FOUND), OP_EQ, 1);
+  pcirc = or_circuit_new(0, NULL);
+  pcirc->p_chan = chan;
+  tt_size_op(helper_hs_request_on_circ(pcirc, true), OP_GT, 0); /* 400 */
+  tt_u64_op(dos_get_dir_stat(DOS_DIR_HSDIR_POST_REJECTED), OP_EQ, 1);
+  tt_size_op(helper_hs_request_on_circ_impl(pcirc, desc_str, NULL),
+             OP_GT, 0); /* 200 */
+  tt_u64_op(dos_get_dir_stat(DOS_DIR_HSDIR_POST_OK), OP_EQ, 1);
+
+  for (int i = 0; i < 3; i++) {
+    fetched = helper_fetch_desc_from_hsdir(blinded_key);
+    tt_str_op(fetched, OP_EQ, desc_str);
+    tor_free(fetched);
+  }
+  tt_u64_op(dos_get_dir_stat(DOS_DIR_HSDIR_GET_FOUND), OP_EQ, 3);
+  tt_u64_op(dos_get_dir_stat(DOS_DIR_HSDIR_DESC_RATE_LIMITED), OP_EQ, 1);
+  tt_u64_op(dos_get_dir_stat(DOS_DIR_HSDIR_GLOBAL_RATE_LIMITED), OP_EQ, 1);
+  tt_u64_op(dos_get_dir_stat(DOS_DIR_NON_HS_REQUEST), OP_EQ, non_hs_before);
+
+  /* 2. Enable per-descriptor enforcement: the 4th hit is refused before
+   * queuing the ~40 KB descriptor, and re-uploading a newer revision of the
+   * same descriptor does not reset its exhausted token bucket. */
+  dos_opts->HSDirDescriptorLimitEnabled = 1;
+  fetched = helper_fetch_desc_from_hsdir(blinded_key);
+  tt_ptr_op(fetched, OP_EQ, NULL);
+  tt_u64_op(dos_get_dir_stat(DOS_DIR_HSDIR_DESC_RATE_LIMITED), OP_EQ, 2);
+
+  desc->plaintext_data.revision_counter++;
+  tor_free(desc_str);
+  tt_int_op(hs_desc_encode_descriptor(desc, &signing_kp, NULL, &desc_str),
+            OP_EQ, 0);
+  tt_int_op(hs_cache_store_as_dir(desc_str), OP_EQ, 0);
+  fetched = helper_fetch_desc_from_hsdir(blinded_key);
+  tt_ptr_op(fetched, OP_EQ, NULL);
+  tt_u64_op(dos_get_dir_stat(DOS_DIR_HSDIR_DESC_RATE_LIMITED), OP_EQ, 3);
+
+  /* 3. Per-circuit stream limiter counts rate and live-stream excess on
+   * BEGIN_DIR even when DoSStreamCreationEnabled is off (0), and enforces
+   * REFUSE_STREAM when enabled (1). */
+  dos_opts->DoSStreamCreationRate = 2;
+  dos_opts->DoSStreamCreationBurst = 1;
+  dos_opts->DoSStreamCreationMaxConcurrent = 1;
+  dos_init();
+  bcirc = or_circuit_new(0, NULL);
+  live_stream = edge_connection_new(CONN_TYPE_EXIT, AF_INET);
+  bcirc->n_streams = live_stream;
+  tt_int_op(dos_stream_new_begin_or_resolve_cell(bcirc, true), OP_EQ,
+            DOS_STREAM_DEFENSE_NONE);
+  tt_u64_op(dos_get_dir_stat(DOS_DIR_BEGINDIR_LIVE_LIMITED), OP_EQ, 1);
+  tt_u64_op(dos_get_dir_stat(DOS_DIR_BEGINDIR_RATE_LIMITED), OP_EQ, 0);
+
+  dos_opts->DoSStreamCreationEnabled = 1;
+  dos_init();
+  tt_int_op(dos_stream_new_begin_or_resolve_cell(bcirc, true), OP_EQ,
+            DOS_STREAM_DEFENSE_REFUSE_STREAM);
+  tt_int_op(dos_stream_new_begin_or_resolve_cell(bcirc, true), OP_EQ,
+            DOS_STREAM_DEFENSE_REFUSE_STREAM);
+  tt_u64_op(dos_get_dir_stat(DOS_DIR_BEGINDIR_RATE_LIMITED), OP_EQ, 2);
+  tt_u64_op(dos_get_dir_stat(DOS_DIR_BEGINDIR_LIVE_LIMITED), OP_EQ, 3);
+  tt_u64_op(dos_get_num_stream_rejected(), OP_EQ, 3);
+
+ done:
+  UNMOCK(circuit_mark_for_close_);
+  if (bcirc)
+    bcirc->n_streams = NULL;
+  connection_free_minimal(TO_CONN(live_stream));
+  SMARTLIST_FOREACH(circuit_get_global_list(), circuit_t *, c,
+                    TO_OR_CIRCUIT(c)->p_chan = NULL);
+  circuit_free_all();
+  hs_descriptor_free(desc);
+  tor_free(desc_str);
+  tor_free(fetched);
+  tor_free(chan);
+  hs_free_all();
+}
