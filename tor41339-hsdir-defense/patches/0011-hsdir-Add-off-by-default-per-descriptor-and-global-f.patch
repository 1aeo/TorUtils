+/** Check the per-descriptor and relay-wide fetch token buckets for a cached
+ * HSv3 descriptor GET hit for <b>blinded_key</b> on <b>conn</b>, and return
+ * true iff the descriptor should be served. When enforcement is enabled and a
+ * token bucket is exhausted, closes the circuit with
+ * END_CIRC_REASON_RESOURCELIMIT before queueing the ~40 KB response. */
+bool
+connection_dir_allow_hs_descriptor_fetch(
+                              dir_connection_t *conn,
+                              const ed25519_public_key_t *blinded_key)
+{
+  if (BUG(!connection_dir_is_anonymous(conn)))
+    return true;
+  if (!dos_allow_hsdir_descriptor_fetch(
+        hs_cache_get_dir_fetch_limiter(blinded_key))) {
+    static ratelim_t fetch_lim = RATELIM_INIT(600);
+    close_hsdir_circuit_for_resourcelimit(
+      TO_OR_CIRCUIT(TO_EDGE_CONN(TO_CONN(conn)->linked_conn)->on_circuit),
+      &fetch_lim, "rate-limited HS descriptor fetch");
+    return false;
+  }
+  return true;
+}
