+/* Update the per-descriptor <b>desc_limiter</b> and relay-wide HS fetch token
+ * buckets for a cached HSv3 descriptor GET hit, and return true iff the HSDir
+ * should serve the descriptor. */
+bool
+dos_allow_hsdir_descriptor_fetch(token_bucket_ctr_t *desc_limiter)
+{
+  if (BUG(desc_limiter == NULL))
+    return true;
+  const dos_options_t *opts = dos_get_options();
+  bool allow = true;
+
+  if (!dos_token_bucket_consume(
+        desc_limiter,
+        dos_uint_or_param(opts->HSDirDescriptorRate, dos_hsdir_desc_rate),
+        dos_uint_or_param(opts->HSDirDescriptorBurst, dos_hsdir_desc_burst))) {
+    dos_note_dir_stat(DOS_DIR_HSDIR_DESC_RATE_LIMITED);
+    if (dos_autobool_or_param(opts->HSDirDescriptorLimitEnabled,
+                              dos_hsdir_desc_limit_enabled))
+      allow = false;
+  }
+  if (!dos_token_bucket_consume(
+        &hsdir_global_fetch_limiter,
+        dos_uint_or_param(opts->HSDirGlobalRate, dos_hsdir_global_rate),
+        dos_uint_or_param(opts->HSDirGlobalBurst, dos_hsdir_global_burst))) {
+    dos_note_dir_stat(DOS_DIR_HSDIR_GLOBAL_RATE_LIMITED);
+    if (dos_autobool_or_param(opts->HSDirGlobalLimitEnabled,
+                              dos_hsdir_global_limit_enabled))
+      allow = false;
+  }
+  return allow;
+}
