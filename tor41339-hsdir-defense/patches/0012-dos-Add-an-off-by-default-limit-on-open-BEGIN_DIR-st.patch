+/** Add <b>n</b> streams to <b>circ</b>: directory streams if <b>linked</b>,
+ * and closing ones if <b>marked</b>. */
+static void
+add_streams(or_circuit_t *circ, int n, bool linked, bool marked)
+{
+  for (int i = 0; i < n; i++) {
+    edge_connection_t *stream = edge_connection_new(CONN_TYPE_EXIT, AF_INET);
+    stream->base_.linked = linked;
+    stream->base_.marked_for_close = marked;
+    stream->next_stream = circ->n_streams;
+    circ->n_streams = stream;
+  }
+}
+
+/** Free the streams that add_streams() added to <b>circ</b>. */
+static void
+free_streams(or_circuit_t *circ)
+{
+  while (circ->n_streams) {
+    edge_connection_t *stream = circ->n_streams;
+    circ->n_streams = stream->next_stream;
+    connection_free_minimal(TO_CONN(stream));
+  }
+}
+
+/** Test that BEGIN_DIR cells on a circuit with DoSBeginDirMaxStreams open
+ * directory streams are counted, and only refused by public relays when the
+ * limit is enabled. */
+static void
+test_dos_begindir_max_streams(void *arg)
+{
+  or_circuit_t *circ = or_circuit_new(0, NULL);
+  dos_options_t *dos_opts = get_dos_options(get_options_mutable());
+  (void) arg;
+
+  MOCK(networkstatus_get_latest_consensus,
+       mock_networkstatus_get_latest_consensus);
+  get_options_mutable()->ORPort_set = 1;
+
+  /* Exit streams and closing directory streams don't count. */
+  add_streams(circ, 1, false, false);
+  add_streams(circ, 1, true, true);
+  add_streams(circ, 63, true, false);
+  dos_opts->DoSBeginDirLimitEnabled = 1;
+  tt_assert(!dos_should_refuse_begindir(circ));
+  tt_u64_op(dos_get_dir_stat(DOS_DIR_BEGINDIR_OVER_MAX), OP_EQ, 0);
+  /* The default limit is 64. */
+  add_streams(circ, 1, true, false);
+  tt_assert(dos_should_refuse_begindir(circ));
+  tt_u64_op(dos_get_dir_stat(DOS_DIR_BEGINDIR_OVER_MAX), OP_EQ, 1);
+  free_streams(circ);
+
+  /* The consensus can set both, and the torrc overrides it. */
+  add_streams(circ, 2, true, false);
+  dummy_ns = tor_malloc_zero(sizeof(networkstatus_t));
+  dummy_ns->net_params = smartlist_new();
+  smartlist_add(dummy_ns->net_params, (char *) "DoSBeginDirLimitEnabled=1");
+  smartlist_add(dummy_ns->net_params, (char *) "DoSBeginDirMaxStreams=2");
+  dos_opts->DoSBeginDirLimitEnabled = -1;
+  tt_assert(dos_should_refuse_begindir(circ));
+  dos_opts->DoSBeginDirMaxStreams = 3;
+  tt_assert(!dos_should_refuse_begindir(circ));
+  dos_opts->DoSBeginDirMaxStreams = 0;
+  dos_opts->DoSBeginDirLimitEnabled = 0;
+  tt_assert(!dos_should_refuse_begindir(circ));
+  tt_u64_op(dos_get_dir_stat(DOS_DIR_BEGINDIR_OVER_MAX), OP_EQ, 3);
+
+  /* Bridges count, but never refuse. */
+  dos_opts->DoSBeginDirLimitEnabled = 1;
+  get_options_mutable()->BridgeRelay = 1;
+  tt_assert(!dos_should_refuse_begindir(circ));
+  tt_u64_op(dos_get_dir_stat(DOS_DIR_BEGINDIR_OVER_MAX), OP_EQ, 4);
+
+ done:
+  UNMOCK(networkstatus_get_latest_consensus);
+  if (dummy_ns)
+    smartlist_free(dummy_ns->net_params);
+  tor_free(dummy_ns);
+  free_streams(circ);
+  circuit_free_all();
+}
+
+static int n_connected = 0, n_end = 0, end_reason = 0;
+static int
+mock_relay_send_command_from_edge(streamid_t stream_id, circuit_t *circ,
+                                  uint8_t relay_command, const char *payload,
+                                  size_t payload_len,
+                                  crypt_path_t *cpath_layer,
+                                  const char *filename, int lineno)
+{
+  (void) stream_id;
+  (void) circ;
+  (void) cpath_layer;
+  (void) filename;
+  (void) lineno;
+  if (relay_command == RELAY_COMMAND_CONNECTED)
+    n_connected++;
+  if (relay_command == RELAY_COMMAND_END) {
+    n_end++;
+    end_reason = payload_len ? payload[0] : -1;
+  }
+  return 0;
+}
+
+static int
+mock_we_are_hibernating(void)
+{
+  return 0;
+}
+
+/** Test that connection_exit_begin_conn() refuses a BEGIN_DIR over the limit
+ * with an END cell, before opening any connection. */
+static void
+test_dos_begindir_refused(void *arg)
+{
+  or_circuit_t *circ = or_circuit_new(0, NULL);
+  dos_options_t *dos_opts = get_dos_options(get_options_mutable());
+  relay_msg_t msg;
+  (void) arg;
+
+  tor_init_connection_lists();
+  MOCK(relay_send_command_from_edge_, mock_relay_send_command_from_edge);
+  MOCK(we_are_hibernating, mock_we_are_hibernating);
+  get_options_mutable()->ORPort_set = 1;
+  get_options_mutable()->DirPort_set = 1;
+  get_options_mutable()->DirCache = 1;
+  dos_opts->DoSBeginDirMaxStreams = 2;
+  dos_opts->DoSBeginDirLimitEnabled = 1;
+  TO_CIRCUIT(circ)->purpose = CIRCUIT_PURPOSE_OR;
+  memset(&msg, 0, sizeof(msg));
+  msg.command = RELAY_COMMAND_BEGIN_DIR;
+  msg.body = (const uint8_t *) "";
+
+  for (msg.stream_id = 1; msg.stream_id <= 3; msg.stream_id++)
+    tt_int_op(connection_exit_begin_conn(&msg, TO_CIRCUIT(circ)), OP_EQ, 0);
+  tt_int_op(n_connected, OP_EQ, 2);
+  tt_int_op(n_end, OP_EQ, 1);
+  tt_int_op(end_reason, OP_EQ, END_STREAM_REASON_MISC);
+  /* Two linked pairs. */
+  tt_int_op(smartlist_len(get_connection_array()), OP_EQ, 4);
+  tt_u64_op(dos_get_dir_stat(DOS_DIR_BEGINDIR_OVER_MAX), OP_EQ, 1);
+
+ done:
+  UNMOCK(relay_send_command_from_edge_);
+  UNMOCK(we_are_hibernating);
+  SMARTLIST_FOREACH(get_connection_array(), connection_t *, c, {
+    if (c->type == CONN_TYPE_EXIT)
+      TO_EDGE_CONN(c)->on_circuit = NULL;
+  });
+  circ->n_streams = NULL;
+  while (smartlist_len(get_connection_array())) {
+    connection_t *c = smartlist_get(get_connection_array(), 0);
+    connection_remove(c);
+    connection_free_(c);
+  }
+  circuit_free_all();
+}
