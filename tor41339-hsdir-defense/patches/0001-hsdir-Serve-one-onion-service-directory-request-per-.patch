+/* HSDirOneRequestPerCircuit default: enforcement (closing a reused circuit)
+ * is OFF, so a relay that ships with no torrc or consensus opinion only
+ * counts reuse and never tears a circuit down on its own. */
+#define DOS_HSDIR_ONE_REQUEST_PER_CIRC_DEFAULT 0
+
+/* Return true iff an HSDir should close ("enforce"), rather than only count,
+ * a circuit that makes more than one onion service directory request. The
+ * HSDirOneRequestPerCircuit torrc option overrides the
+ * hsdir_one_request_per_circ consensus parameter, which defaults to off. */
+int
+dos_should_enforce_hsdir_one_request_per_circ(void)
+{
+  if (dos_get_options()->HSDirOneRequestPerCircuit != -1) {
+    return dos_get_options()->HSDirOneRequestPerCircuit;
+  }
+  return !!networkstatus_get_param(NULL, "hsdir_one_request_per_circ",
+                                   DOS_HSDIR_ONE_REQUEST_PER_CIRC_DEFAULT,
+                                   0, 1);
+}
+
+/* Note down that we've just seen an onion service directory request on a
+ * circuit that had already made one. This increments a counter later used for
+ * the heartbeat and the MetricsPort. */
+void
+dos_note_hsdir_circ_reused(void)
+{
+  num_hsdir_circ_reused++;
+}
