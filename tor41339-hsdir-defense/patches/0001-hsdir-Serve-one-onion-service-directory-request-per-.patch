+/* Make an onion service directory request on <b>circ</b>, a descriptor upload
+ * iff <b>post</b>, and return the length of the HSDir's response (0 if the
+ * request was refused before any response was written). */
+static size_t
+helper_hs_request_on_circ(or_circuit_t *circ, bool post)
+{
+  edge_connection_t *edge_conn = edge_connection_new(CONN_TYPE_EXIT, AF_INET);
+  dir_connection_t *conn = dir_connection_new(AF_INET);
+  size_t len;
+
+  edge_conn->on_circuit = TO_CIRCUIT(circ);
+  TO_CONN(conn)->linked = 1; /* Signal that it is encrypted. */
+  TO_CONN(conn)->linked_conn = TO_CONN(edge_conn);
+  if (post)
+    directory_handle_command_post(conn, "POST /tor/hs/3/publish HTTP/1.0\r\n"
+                                  "\r\n", "x", 1);
+  else
+    directory_handle_command_get(conn, GET("/tor/hs/3/x"), NULL, 0);
+  len = connection_get_outbuf_len(TO_CONN(conn));
+  connection_free_minimal(TO_CONN(edge_conn));
+  connection_free_minimal(TO_CONN(conn));
+  return len;
+}
+
+/* Check that the hsdir_circ_reused counter reads <b>n</b> both in the DoS
+ * heartbeat and on the MetricsPort. */
+static void
+expect_hsdir_reuse_count(uint64_t n)
+{
+  char *expect = NULL, *out = NULL;
+  buf_t *buf = buf_new();
+
+  tor_asprintf(&expect, "%"PRIu64" circuits with repeated HSDir requests", n);
+  setup_full_capture_of_logs(LOG_NOTICE);
+  dos_log_heartbeat();
+  expect_log_msg_containing(expect);
+  teardown_capture_of_logs();
+
+  metrics_store_get_output(METRICS_FORMAT_PROMETHEUS,
+                           smartlist_get(relay_metrics_get_stores(), 0), buf);
+  out = buf_extract(buf, NULL);
+  tor_free(expect);
+  tor_asprintf(&expect,
+               "tor_relay_dos_total{type=\"hsdir_circ_reused\"} %"PRIu64"\n",
+               n);
+  tt_assert(strstr(out, expect));
+
+ done:
+  teardown_capture_of_logs();
+  tor_free(expect);
+  tor_free(out);
+  buf_free(buf);
+}
+
+/* An HSDir serves only one onion service request (GET or POST) per circuit.
+ * Enforcement (closing the circuit) defaults off, so by default the second
+ * request is served and the circuit stays open; the reuse is counted either
+ * way, exactly once per circuit, and shows up in the heartbeat and on the
+ * MetricsPort. The HSDirOneRequestPerCircuit torrc option overrides the
+ * hsdir_one_request_per_circ consensus parameter, which overrides the
+ * count-only default. */
+static void
+test_hsdir_one_request_per_circ(void *arg)
+{
+  channel_t *chan = tor_malloc_zero(sizeof(channel_t));
+  dos_options_t *dos_opts;
+  or_circuit_t *circ;
+  (void) arg;
+
+  init_test();
+  MOCK(circuit_mark_for_close_, mock_circuit_mark_for_close);
+  get_options_mutable()->ORPort_set = 1; /* Accept descriptor uploads. */
+  get_options_mutable()->RefuseUnknownExits = 0; /* Any previous hop (0002). */
+  dos_opts = get_dos_options(get_options_mutable());
+
+  /* (a)+(c) Real compiled default (torrc auto, no consensus): observe only.
+   * A GET and a POST are each served a second and even a third time, the
+   * circuit stays open, and the reuse is counted exactly once per circuit. */
+  tt_int_op(dos_opts->HSDirOneRequestPerCircuit, OP_EQ, -1); /* auto default */
+  for (int i = 0; i < 2; i++) {
+    bool post = (i == 1);
+    circ = or_circuit_new(0, NULL);
+    circ->p_chan = chan;
+    tt_size_op(helper_hs_request_on_circ(circ, post), OP_GT, 0);
+    tt_int_op(TO_CIRCUIT(circ)->marked_for_close, OP_EQ, 0);
+    tt_size_op(helper_hs_request_on_circ(circ, post), OP_GT, 0); /* served */
+    tt_size_op(helper_hs_request_on_circ(circ, post), OP_GT, 0); /* served */
+    tt_int_op(TO_CIRCUIT(circ)->marked_for_close, OP_EQ, 0);
+  }
+  tt_u64_op(dos_get_num_hsdir_circ_reused(), OP_EQ, 2); /* once per circuit */
+  expect_hsdir_reuse_count(2);
+
+  /* (b) Torrc force-on overrides a consensus that says off: the second
+   * request closes the circuit (RESOURCELIMIT) and is not served. */
+  dos_opts->HSDirOneRequestPerCircuit = 1;
+  set_mock_consensus_param("hsdir_one_request_per_circ=0");
+  circ = or_circuit_new(0, NULL);
+  circ->p_chan = chan;
+  tt_size_op(helper_hs_request_on_circ(circ, false), OP_GT, 0);
+  tt_int_op(TO_CIRCUIT(circ)->marked_for_close, OP_EQ, 0);
+  tt_size_op(helper_hs_request_on_circ(circ, false), OP_EQ, 0); /* closed */
+  tt_int_op(TO_CIRCUIT(circ)->marked_for_close, OP_EQ, 1);
+  tt_int_op(TO_CIRCUIT(circ)->marked_for_close_reason, OP_EQ,
+            END_CIRC_REASON_RESOURCELIMIT);
+
+  /* The same force-on enforcement covers a second POST (descriptor upload):
+   * the second POST on a fresh circuit is not served and closes the circuit
+   * with RESOURCELIMIT. */
+  circ = or_circuit_new(0, NULL);
+  circ->p_chan = chan;
+  tt_size_op(helper_hs_request_on_circ(circ, true), OP_GT, 0);
+  tt_int_op(TO_CIRCUIT(circ)->marked_for_close, OP_EQ, 0);
+  tt_size_op(helper_hs_request_on_circ(circ, true), OP_EQ, 0); /* closed */
+  tt_int_op(TO_CIRCUIT(circ)->marked_for_close, OP_EQ, 1);
+  tt_int_op(TO_CIRCUIT(circ)->marked_for_close_reason, OP_EQ,
+            END_CIRC_REASON_RESOURCELIMIT);
+  clear_mock_consensus();
+
+  /* Torrc force-off overrides a consensus that says on: observe only. */
+  dos_opts->HSDirOneRequestPerCircuit = 0;
+  set_mock_consensus_param("hsdir_one_request_per_circ=1");
+  circ = or_circuit_new(0, NULL);
+  circ->p_chan = chan;
+  tt_size_op(helper_hs_request_on_circ(circ, false), OP_GT, 0);
+  tt_size_op(helper_hs_request_on_circ(circ, false), OP_GT, 0); /* served */
+  tt_int_op(TO_CIRCUIT(circ)->marked_for_close, OP_EQ, 0);
+  clear_mock_consensus();
+
+  /* (d) Torrc auto + a real consensus parameter of 1 (parsed through the real
+   * get_net_param path): enforce, the second request closes the circuit. */
+  dos_opts->HSDirOneRequestPerCircuit = -1;
+  set_mock_consensus_param("hsdir_one_request_per_circ=1");
+  circ = or_circuit_new(0, NULL);
+  circ->p_chan = chan;
+  tt_size_op(helper_hs_request_on_circ(circ, false), OP_GT, 0);
+  tt_int_op(TO_CIRCUIT(circ)->marked_for_close, OP_EQ, 0);
+  tt_size_op(helper_hs_request_on_circ(circ, false), OP_EQ, 0); /* closed */
+  tt_int_op(TO_CIRCUIT(circ)->marked_for_close, OP_EQ, 1);
+
+ done:
+  clear_mock_consensus();
+  UNMOCK(circuit_mark_for_close_);
+  SMARTLIST_FOREACH(circuit_get_global_list(), circuit_t *, c,
+                    TO_OR_CIRCUIT(c)->p_chan = NULL);
+  circuit_free_all();
+  tor_free(chan);
+}
