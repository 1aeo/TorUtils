diff --git a/src/feature/dircommon/directory.c b/src/feature/dircommon/directory.c
index e2c84197bc..770c94159d 100644
--- a/src/feature/dircommon/directory.c
+++ b/src/feature/dircommon/directory.c
@@ -17,6 +17,7 @@
 #include "feature/dircommon/directory.h"
 #include "feature/dircommon/fp_pair.h"
 #include "feature/hs/hs_cache.h"
+#include "feature/relay/relay_metrics.h"
 #include "feature/stats/geoip_stats.h"
 #include "lib/buf/buffers.h"
 #include "lib/compress/compress.h"
@@ -536,6 +537,10 @@ connection_dir_about_to_close(dir_connection_t *dir_conn)
 {
   connection_t *conn = TO_CONN(dir_conn);
 
+  if (DIR_CONN_IS_SERVER(conn) && conn->linked &&
+      conn->state == DIR_CONN_STATE_SERVER_COMMAND_WAIT)
+    relay_increment_dir_request(DIR_REQUEST_UNPARSED);
+
   if (conn->state < DIR_CONN_STATE_CLIENT_FINISHED) {
     /* It's a directory connection and connecting or fetching
      * failed: forget about this router, and maybe try again. */
@@ -587,6 +592,10 @@ connection_dir_finished_flushing(dir_connection_t *conn)
         if (conn->hs_ident) {
           hs_cache_mark_dowloaded_as_dir(conn->hs_ident);
         }
+        if (TO_CONN(conn)->linked)
+          relay_increment_dir_response(conn->hs_ident ?
+                                       DIR_RESPONSE_HS_DESCRIPTOR :
+                                       DIR_RESPONSE_OTHER);
         connection_mark_for_close(TO_CONN(conn));
       }
       return 0;
diff --git a/src/feature/relay/relay_metrics.c b/src/feature/relay/relay_metrics.c
index c333e22e40..c94a36616b 100644
--- a/src/feature/relay/relay_metrics.c
+++ b/src/feature/relay/relay_metrics.c
@@ -69,6 +69,8 @@ static void fill_intro1_cells(void);
 static void fill_rend1_cells(void);
 static void fill_hsdir_get_values(void);
 static void fill_hsdir_post_values(void);
+static void fill_dir_request_values(void);
+static void fill_dir_response_values(void);
 
 /** The base metrics that is a static array of metrics added to the metrics
  * store.
@@ -258,6 +260,20 @@ static const relay_metrics_entry_t base_metrics[] =
     .help = "Total number of onion service descriptor uploads we received",
     .fill_fn = fill_hsdir_post_values,
   },
+  {
+    .key = RELAY_METRICS_NUM_DIR_REQUESTS,
+    .type = METRICS_TYPE_COUNTER,
+    .name = METRICS_NAME(relay_dir_requests_total),
+    .help = "Total number of other tunneled directory requests we received",
+    .fill_fn = fill_dir_request_values,
+  },
+  {
+    .key = RELAY_METRICS_NUM_DIR_RESPONSES,
+    .type = METRICS_TYPE_COUNTER,
+    .name = METRICS_NAME(relay_dir_responses_total),
+    .help = "Total number of tunneled directory responses we handed off",
+    .fill_fn = fill_dir_response_values,
+  },
 };
 static const size_t num_base_metrics = ARRAY_LENGTH(base_metrics);
 
@@ -1321,6 +1337,46 @@ fill_hsdir_post_values(void)
                       HSDIR_POST_ACTION_COUNT);
 }
 
+static uint64_t dir_requests[DIR_REQUEST_TYPE_COUNT];
+static const char *const dir_request_names[] = {
+  [DIR_REQUEST_NON_HS] = "non_hs",
+  [DIR_REQUEST_UNPARSED] = "unparsed",
+};
+
+void
+relay_increment_dir_request(dir_request_type_t type)
+{
+  dir_requests[type]++;
+}
+
+static void
+fill_dir_request_values(void)
+{
+  fill_labeled_values(&base_metrics[RELAY_METRICS_NUM_DIR_REQUESTS], "type",
+                      dir_request_names, dir_requests,
+                      DIR_REQUEST_TYPE_COUNT);
+}
+
+static uint64_t dir_responses[DIR_RESPONSE_TYPE_COUNT];
+static const char *const dir_response_names[] = {
+  [DIR_RESPONSE_HS_DESCRIPTOR] = "hs_descriptor",
+  [DIR_RESPONSE_OTHER] = "other",
+};
+
+void
+relay_increment_dir_response(dir_response_type_t type)
+{
+  dir_responses[type]++;
+}
+
+static void
+fill_dir_response_values(void)
+{
+  fill_labeled_values(&base_metrics[RELAY_METRICS_NUM_DIR_RESPONSES],
+                      "type", dir_response_names, dir_responses,
+                      DIR_RESPONSE_TYPE_COUNT);
+}
