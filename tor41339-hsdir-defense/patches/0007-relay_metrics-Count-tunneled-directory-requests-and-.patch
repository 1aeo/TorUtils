diff --git a/src/test/test_hs_cache.c b/src/test/test_hs_cache.c
index 4cdd7f3189..f9e557a38d 100644
--- a/src/test/test_hs_cache.c
+++ b/src/test/test_hs_cache.c
@@ -961,6 +961,69 @@ test_downloaded_counter_non_hs(void *arg)
   connection_free_minimal(TO_CONN(conn));
 }
 
+#define DIR_REQUEST_METRIC(type) \
+  get_metric(METRICS_NAME(relay_dir_requests_total), "type", (type))
+#define DIR_RESPONSE_METRIC(type) \
+  get_metric(METRICS_NAME(relay_dir_responses_total), "type", (type))
+
+/* Tunneled directory requests are counted by type, and responses once they
+ * are handed to their stream; direct (DirPort) connections are not. */
+static void
+test_dir_request_response_metrics(void *arg)
+{
+  channel_t *chan = tor_malloc_zero(sizeof(channel_t));
+  dir_connection_t *conn = dir_connection_new(AF_INET);
+  ed25519_public_key_t pk;
+  int64_t non_hs0, unparsed0, hs0, other0;
+  (void) arg;
+
+  init_test();
+  MOCK(connection_write_to_buf_impl_, connection_write_to_buf_mock);
+  MOCK(connection_mark_for_close_internal_, hsdir_mock_mark_for_close);
+  get_options_mutable()->ORPort_set = 1; /* Accept directory posts. */
+  /* Other tests may have counted requests before we forked. */
+  non_hs0 = DIR_REQUEST_METRIC("non_hs");
+  unparsed0 = DIR_REQUEST_METRIC("unparsed");
+  hs0 = DIR_RESPONSE_METRIC("hs_descriptor");
+  other0 = DIR_RESPONSE_METRIC("other");
+
+  hsdir_request_on_new_circ(chan, GET("/tor/robots.txt"), NULL);
+  hsdir_request_on_new_circ(chan, "POST /tor/ HTTP/1.0\r\n\r\n", "x");
+  hsdir_request_on_new_circ(chan, "GET\r\n\r\n", NULL);
+  hsdir_request_on_new_circ(chan, "POST\r\n\r\n", "x");
+  tt_i64_op(DIR_REQUEST_METRIC("non_hs"), OP_EQ, non_hs0 + 2);
+  tt_i64_op(DIR_REQUEST_METRIC("unparsed"), OP_EQ, unparsed0 + 2);
+
+  /* Closed while waiting for a request: counted only if tunneled. */
+  TO_CONN(conn)->purpose = DIR_PURPOSE_SERVER;
+  TO_CONN(conn)->state = DIR_CONN_STATE_SERVER_COMMAND_WAIT;
+  connection_dir_about_to_close(conn);
+  tt_i64_op(DIR_REQUEST_METRIC("unparsed"), OP_EQ, unparsed0 + 2);
+  TO_CONN(conn)->linked = 1;
+  connection_dir_about_to_close(conn);
+  tt_i64_op(DIR_REQUEST_METRIC("unparsed"), OP_EQ, unparsed0 + 3);
+
+  /* A response is counted once it has been handed to its stream. */
+  TO_CONN(conn)->state = DIR_CONN_STATE_SERVER_WRITING;
+  tt_int_op(connection_dir_finished_flushing(conn), OP_EQ, 0);
+  tt_i64_op(DIR_RESPONSE_METRIC("other"), OP_EQ, other0 + 1);
+  memset(&pk, 0, sizeof(pk));
+  conn->hs_ident = hs_ident_server_dir_conn_new(&pk);
+  TO_CONN(conn)->marked_for_close = 0;
+  tt_int_op(connection_dir_finished_flushing(conn), OP_EQ, 0);
+  tt_i64_op(DIR_RESPONSE_METRIC("hs_descriptor"), OP_EQ, hs0 + 1);
+  tt_i64_op(DIR_RESPONSE_METRIC("other"), OP_EQ, other0 + 1);
+
+ done:
+  UNMOCK(connection_write_to_buf_impl_);
+  UNMOCK(connection_mark_for_close_internal_);
+  SMARTLIST_FOREACH(circuit_get_global_list(), circuit_t *, c,
+                    TO_OR_CIRCUIT(c)->p_chan = NULL);
+  circuit_free_all();
+  connection_free_minimal(TO_CONN(conn));
+  tor_free(chan);
+}
+
