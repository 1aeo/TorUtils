From 487eaacdc63b8fea71e490c8afa6b9fc7067280c Mon Sep 17 00:00:00 2001
From: Cursor Agent <cursoragent@cursor.com>
Date: Thu, 22 Oct 2026 06:55:43 +0000
Subject: [PATCH] test: Lock the HSDir per-circuit counter at 2

n_hsdir_requests is a 2-bit field. Without the saturation check, a
fourth request wraps it to 0 and a later request looks like the
circuit's first. The existing tests stopped at three requests, so that
mutant passed.

Part of #41339.
---
 changes/hsdir_counter_saturate_test |  4 ++++
 src/test/test_hs_cache.c            | 20 +++++++++++---------
 2 files changed, 15 insertions(+), 9 deletions(-)
 create mode 100644 changes/hsdir_counter_saturate_test

diff --git a/changes/hsdir_counter_saturate_test b/changes/hsdir_counter_saturate_test
new file mode 100644
index 0000000..f1d3702
--- /dev/null
+++ b/changes/hsdir_counter_saturate_test
@@ -0,0 +1,4 @@
+  o Testing:
+    - Check that the per-circuit HSDir request counter stays at 2 on a
+      fourth request, so it cannot wrap and look like a fresh circuit.
+      Part of ticket 41339.
diff --git a/src/test/test_hs_cache.c b/src/test/test_hs_cache.c
index 3623b1c..25cd706 100644
--- a/src/test/test_hs_cache.c
+++ b/src/test/test_hs_cache.c
@@ -1125,19 +1125,21 @@ test_hsdir_reuse_and_prev_hop_counters(void *arg)
   circ0 = dos_get_dir_stat(DOS_DIR_HSDIR_CIRC_REUSED);
   unknown0 = dos_get_dir_stat(DOS_DIR_HSDIR_UNKNOWN_PREV_HOP);
 
-  /* Three requests on one circuit, one on another: the zeroed previous hop
-   * identity is not a known relay. */
+  /* Four requests on one circuit, one on another: the zeroed previous hop
+   * identity is not a known relay. The per-circuit counter saturates at 2. */
   circ = or_circuit_new(0, NULL);
   circ->p_chan = chan;
-  for (int i = 0; i < 3; i++)
+  /* Four requests: the 2-bit counter saturates at 2 and must not wrap. */
+  for (int i = 0; i < 4; i++)
     hsdir_request_on_circ(circ, GET("/tor/hs/3/x"), NULL);
+  tt_int_op(circ->n_hsdir_requests, OP_EQ, 2);
   hsdir_request_on_new_circ(chan, "POST /tor/hs/3/publish HTTP/1.0\r\n\r\n",
                             "x");
-  tt_u64_op(dos_get_dir_stat(DOS_DIR_HSDIR_REQUEST), OP_EQ, req0 + 4);
-  tt_u64_op(dos_get_dir_stat(DOS_DIR_HSDIR_REQ_REUSED), OP_EQ, reused0 + 2);
+  tt_u64_op(dos_get_dir_stat(DOS_DIR_HSDIR_REQUEST), OP_EQ, req0 + 5);
+  tt_u64_op(dos_get_dir_stat(DOS_DIR_HSDIR_REQ_REUSED), OP_EQ, reused0 + 3);
   tt_u64_op(dos_get_dir_stat(DOS_DIR_HSDIR_CIRC_REUSED), OP_EQ, circ0 + 1);
   tt_u64_op(dos_get_dir_stat(DOS_DIR_HSDIR_UNKNOWN_PREV_HOP), OP_EQ,
-            unknown0 + 4);
+            unknown0 + 5);
   tt_i64_op(get_metric(METRICS_NAME(relay_dos_total), "type",
                        "hsdir_circ_reused"), OP_EQ, circ0 + 1);
 
@@ -1148,14 +1150,14 @@ test_hsdir_reuse_and_prev_hop_counters(void *arg)
   smartlist_add(mock_hsdir_ns->routerstatus_list, &known_rs);
   MOCK(networkstatus_get_latest_consensus, mock_hsdir_get_latest_consensus);
   hsdir_request_on_new_circ(chan, GET("/tor/hs/3/x"), NULL);
-  tt_u64_op(dos_get_dir_stat(DOS_DIR_HSDIR_REQUEST), OP_EQ, req0 + 5);
+  tt_u64_op(dos_get_dir_stat(DOS_DIR_HSDIR_REQUEST), OP_EQ, req0 + 6);
   tt_u64_op(dos_get_dir_stat(DOS_DIR_HSDIR_UNKNOWN_PREV_HOP), OP_EQ,
-            unknown0 + 4);
+            unknown0 + 5);
 
   /* Single-hop requests are refused, and not counted here. */
   chan->is_client = 1;
   hsdir_request_on_new_circ(chan, GET("/tor/hs/3/x"), NULL);
-  tt_u64_op(dos_get_dir_stat(DOS_DIR_HSDIR_REQUEST), OP_EQ, req0 + 5);
+  tt_u64_op(dos_get_dir_stat(DOS_DIR_HSDIR_REQUEST), OP_EQ, req0 + 6);
 
  done:
   UNMOCK(connection_write_to_buf_impl_);
-- 
2.43.0

