From 62884954f0dc687aed0dad5d3eeaa0aa8e2b58d7 Mon Sep 17 00:00:00 2001
From: 1aeo <github@1aeo.com>
Date: Thu, 22 Oct 2026 08:16:54 +0000
Subject: [PATCH 14/20] proto_http: Reject a declared body that can never fit

fetch_from_buf_http() rejects a buffered body once it reaches the
caller's limit, but a Content-Length at or above that limit returns
"not here yet" until those bytes arrive. A directory server connection
then stays in COMMAND_WAIT, holding its stream until the stall timeout.

Reject such a declaration as soon as the headers arrive, unless the
caller sets force_complete and wants the bytes it already has. This
applies to every caller that doesn't: the directory server and client,
the MetricsPort, the HTTP CONNECT tunnel and HTTPS proxy replies. Each
would have failed once the body reached the limit; they now fail
earlier, and the directory client logs "response too large" instead of
waiting.

Part of #41339.
---
 changes/ticket41339_hardening  |  5 +++++
 src/core/proto/proto_http.c    |  7 +++++++
 src/test/test_dir_handle_get.c |  6 +++++-
 src/test/test_proto_http.c     | 19 +++++++++++++++++++
 4 files changed, 36 insertions(+), 1 deletion(-)

diff --git a/changes/ticket41339_hardening b/changes/ticket41339_hardening
index 0c4000410b..653d59ef27 100644
--- a/changes/ticket41339_hardening
+++ b/changes/ticket41339_hardening
@@ -7,6 +7,11 @@
     - Directory servers now discard anything a client sends on a tunneled
       (BEGIN_DIR) stream after its request, instead of buffering up to 10 MB of
       it per stream while they send their answer. Part of ticket 41339.
+    - When parsing an HTTP request or response without accepting a partial
+      body, reject a declared Content-Length that is too large to accept as
+      soon as the headers arrive, instead of waiting for those bytes. This
+      applies to directory requests and responses, the MetricsPort, the HTTP
+      CONNECT tunnel and HTTPS proxy replies. Part of ticket 41339.
 
   o Minor features (onion service directory):
     - Reject an onion service descriptor whose signature has the wrong length
diff --git a/src/core/proto/proto_http.c b/src/core/proto/proto_http.c
index d5d1f60ca9..3d32e2e9ec 100644
--- a/src/core/proto/proto_http.c
+++ b/src/core/proto/proto_http.c
@@ -99,6 +99,13 @@ fetch_from_buf_http(buf_t *buf,
     log_debug(LD_HTTP,"Got a contentlen of %d.",(int)contentlen);
     if (bodylen < contentlen) {
       if (!force_complete) {
+        /* Fail now on a declared body that the check above would reject
+         * once it arrived. */
+        if (max_bodylen <= contentlen) {
+          log_info(LD_HTTP, "Declared Content-Length %d larger than %d. "
+                   "Failing.", (int)contentlen, (int)max_bodylen - 1);
+          return -1;
+        }
         log_debug(LD_HTTP,"body not all here yet.");
         return 0; /* not all there yet */
       }
diff --git a/src/test/test_dir_handle_get.c b/src/test/test_dir_handle_get.c
index 19264a3365..b73fb876de 100644
--- a/src/test/test_dir_handle_get.c
+++ b/src/test/test_dir_handle_get.c
@@ -2776,9 +2776,13 @@ test_dir_handle_get_hs_post_size_limit(void *data)
   (void) data;
 
   MOCK(connection_write_to_buf_impl_, connection_write_to_buf_mock);
-  /* A body just under the limit is read; one that reaches it is refused. */
+  /* A body just under the limit is read; one that reaches it is refused.
+   * A declared Content-Length that reaches the limit is refused before any
+   * body byte arrives; one just under it is kept until the body does. */
   tt_int_op(handle_hs_post(max_len - 1, max_len - 1), OP_EQ, 0);
   tt_int_op(handle_hs_post(max_len, max_len), OP_EQ, -1);
+  tt_int_op(handle_hs_post(max_len, 0), OP_EQ, -1);
+  tt_int_op(handle_hs_post(max_len - 1, 0), OP_EQ, 0);
 #ifdef HAVE_MODULE_DIRAUTH
   /* Authorities keep the 16 MB limit. */
   get_options_mutable()->AuthoritativeDir = 1;
diff --git a/src/test/test_proto_http.c b/src/test/test_proto_http.c
index 198e70eefb..4b202872b0 100644
--- a/src/test/test_proto_http.c
+++ b/src/test/test_proto_http.c
@@ -175,6 +175,11 @@ test_proto_http_invalid(void *arg)
         "Content-Length: Cheese\r\n\r\n"
         "foo"),
       "Content-Length is bogus; maybe someone is trying to crash us." },
+    /* Declared Content-Length already over the limit; body not here yet. */
+    { S("GET /index.html HTTP/1.0\r\n"
+        "Content-Length: 99999\r\n\r\n"
+        "short"),
+      "Declared Content-Length 99999 larger than 127" },
     };
   unsigned i;
   buf_t *buf = buf_new();
@@ -200,6 +205,20 @@ test_proto_http_invalid(void *arg)
     tor_free(b);
     mock_clean_saved_logs();
   }
+
+  /* A declared length under the limit, with the body not yet here, waits.
+   * force_complete still accepts the bytes it has when the declaration is
+   * over the limit. */
+  {
+    size_t bl = 0;
+    buf_add_string(buf, "GET / HTTP/1.0\r\nContent-Length: 10\r\n\r\nshort");
+    tt_int_op(0, OP_EQ, fetch_from_buf_http(buf, &h, 128, &b, &bl, 128, 0));
+    buf_clear(buf);
+    buf_add_string(buf,
+                   "GET / HTTP/1.0\r\nContent-Length: 99999\r\n\r\nshort");
+    tt_int_op(1, OP_EQ, fetch_from_buf_http(buf, &h, 128, &b, &bl, 128, 1));
+    tt_u64_op(bl, OP_EQ, 5);
+  }
  done:
   tor_free(h);
   tor_free(b);
