+
 /* Called when a CREATE cell is received from the given channel. */
 void
 dos_cc_new_create_cell(channel_t *chan)
@@ -1064,6 +1077,34 @@ dos_note_hsdir_circ_reused(void)
   num_hsdir_circ_reused++;
 }
 
+/* HSDirRefuseUnknownPrevHop default: enforcement is OFF, like
+ * HSDirOneRequestPerCircuit, so a relay with no opinion only counts. */
+#define DOS_HSDIR_REFUSE_UNKNOWN_PREV_HOP_DEFAULT 0
+
+/* Return true iff an HSDir should refuse ("enforce"), rather than only count,
+ * an onion service directory request whose previous hop is not a known relay.
+ * The HSDirRefuseUnknownPrevHop torrc option overrides the
+ * hsdir_refuse_unknown_prev_hop consensus parameter, which defaults to off.
+ * This is independent of RefuseUnknownExits and the exit path. */
+int
+dos_should_refuse_unknown_hsdir_prev_hop(void)
+{
+  if (dos_get_options()->HSDirRefuseUnknownPrevHop != -1) {
+    return dos_get_options()->HSDirRefuseUnknownPrevHop;
+  }
+  return !!networkstatus_get_param(NULL, "hsdir_refuse_unknown_prev_hop",
+                                 DOS_HSDIR_REFUSE_UNKNOWN_PREV_HOP_DEFAULT,
+                                 0, 1);
+}
+
+/* Note down that we've just seen an onion service directory request whose
+ * previous hop is not a known relay. */
+void
+dos_note_hsdir_unknown_prev_hop(void)
+{
+  num_hsdir_unknown_prev_hop++;
+}
+
 /* Log a heartbeat message with some statistics. */
 void
 dos_log_heartbeat(void)
@@ -1121,6 +1162,9 @@ dos_log_heartbeat(void)
   smartlist_add_asprintf(elems,
                          "%" PRIu64 " HSDir requests on reused circuits",
                          num_hsdir_circ_reused);
+  smartlist_add_asprintf(elems,
+                         "%" PRIu64 " HSDir requests with an unknown "
+                         "previous hop", num_hsdir_unknown_prev_hop);
 
   char *msg = smartlist_join_strings(elems, ", ", 0, NULL);
 
