+/** Return true iff the previous hop of the anonymous directory connection
+ * <b>conn</b> is a relay we recognize: one in our consensus or with a
+ * descriptor. Anyone can authenticate an OR connection with a self-generated
+ * relay identity, so an authenticated (non-client) previous hop is not by
+ * itself a known relay. */
+static bool
+connection_dir_prev_hop_is_known_relay(const dir_connection_t *conn)
+{
+  const circuit_t *circ;
+  const channel_t *p_chan;
+
+  /* This guarantees a linked edge connection on an open OR circuit. */
+  if (BUG(!connection_dir_is_anonymous(conn)))
+    return true;
+  circ = CONST_TO_EDGE_CONN(TO_CONN(conn)->linked_conn)->on_circuit;
+  p_chan = CONST_TO_OR_CIRCUIT(circ)->p_chan;
+  return connection_or_digest_is_known_relay(p_chan->identity_digest);
+}
+
+/** Note that the anonymous directory connection <b>conn</b> is making an onion
+ * service directory request, and return true iff an HSDir should serve it with
+ * respect to the known-previous-hop rule.
+ *
+ * HSDirs have refused onion service requests from client channels since
+ * 0.4.2.1-alpha (24964), so they can't be made over one-hop circuits. But a
+ * peer that authenticates with any self-generated relay identity is not a
+ * client channel, so it can still make one-hop HS requests. As exits do for
+ * RefuseUnknownExits (1751), require the previous hop to be a known relay.
+ * This rejects arbitrary unknown prev-hop identities; an attacker can still
+ * add one hop through any consensus relay, so it is not a rate limit.
+ *
+ * We count every unknown-prev-hop request, whether or not we enforce, so the
+ * effect can be measured first. We refuse (and the caller returns a 503) only
+ * when enforcement is enabled. Enforcement is off by default and is its own
+ * HSDirRefuseUnknownPrevHop torrc option and hsdir_refuse_unknown_prev_hop
+ * consensus parameter, independent of RefuseUnknownExits, so turning the HSDir
+ * rule off does not weaken exit protection (and vice versa).
+ *
+ * Stock C tor, Arti and Onionbalance always have a consensus relay as the
+ * previous hop; the only false positives are during the ~1e-6/request window
+ * when the relay has not yet seen the previous hop in a fresh consensus. */
+bool
+connection_dir_check_prev_hop(dir_connection_t *conn)
+{
+  if (connection_dir_prev_hop_is_known_relay(conn))
+    return true;
+  dos_note_hsdir_unknown_prev_hop();
+  return !dos_should_refuse_unknown_hsdir_prev_hop();
+}
+
