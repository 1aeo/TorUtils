From b2d9994dc759bba3cd78c56874844d0b090a5857 Mon Sep 17 00:00:00 2001
From: 1aeo <github@1aeo.com>
Date: Tue, 20 Oct 2026 21:24:31 -0700
Subject: [PATCH 08/11] relay_metrics: Add server directory connection state
 gauges

Export server-side directory connection occupancy gauges on the
MetricsPort (dir_server_wait_conns, dir_server_write_conns,
dir_server_edge_conns, and hsdir_writing_conns), since internal
BEGIN_DIR connections use s = -1 and are invisible to
tor_relay_connections.
---
 changes/ticket41339_metrics_dir_conns |  5 +++++
 src/feature/dircommon/directory.c     | 27 +++++++++++++++++++++++++++
 src/feature/dircommon/directory.h     |  4 ++++
 src/feature/relay/relay_metrics.c     |  8 ++++++++
 src/test/test_hs_cache.c              | 26 ++++++++++++++++++++++++++
 5 files changed, 70 insertions(+)
 create mode 100644 changes/ticket41339_metrics_dir_conns

diff --git a/changes/ticket41339_metrics_dir_conns b/changes/ticket41339_metrics_dir_conns
new file mode 100644
index 0000000..ff48d0b
--- /dev/null
+++ b/changes/ticket41339_metrics_dir_conns
@@ -0,0 +1,5 @@
+  o Minor features (DoS-resistance, onion service directory, metrics):
+    - Export server directory connection occupancy gauges on the MetricsPort
+      (dir_server_wait_conns, dir_server_write_conns, dir_server_edge_conns,
+      and hsdir_writing_conns), since internal BEGIN_DIR connections use s = -1
+      and are not counted in tor_relay_connections. Part of ticket 41339.
diff --git a/src/feature/dircommon/directory.c b/src/feature/dircommon/directory.c
index e4d6ebd..3e54b5b 100644
--- a/src/feature/dircommon/directory.c
+++ b/src/feature/dircommon/directory.c
@@ -7,6 +7,7 @@
 
 #include "app/config/config.h"
 #include "core/mainloop/connection.h"
+#include "core/mainloop/mainloop.h"
 #include "core/or/circuitlist.h"
 #include "core/or/connection_edge.h"
 #include "core/or/connection_or.h"
@@ -309,6 +310,32 @@ connection_dir_allow_hs_request(dir_connection_t *conn)
   return true;
 }
 
+/** Count active server-side directory connections waiting for an HTTP request
+ * (<b>wait_out</b>), writing a response (<b>write_out</b>), writing an onion
+ * service descriptor response (<b>hs_write_out</b>), and active linked
+ * BEGIN_DIR edge streams (<b>edge_out</b>). */
+void
+connection_dir_count_server_conns(uint64_t *wait_out, uint64_t *write_out,
+                                  uint64_t *hs_write_out, uint64_t *edge_out)
+{
+  *wait_out = *write_out = *hs_write_out = *edge_out = 0;
+  SMARTLIST_FOREACH_BEGIN(get_connection_array(), const connection_t *, conn) {
+    if (conn->marked_for_close)
+      continue;
+    if (conn->type == CONN_TYPE_EXIT && conn->linked) {
+      (*edge_out)++;
+    } else if (DIR_CONN_IS_SERVER(conn)) {
+      if (conn->state == DIR_CONN_STATE_SERVER_COMMAND_WAIT) {
+        (*wait_out)++;
+      } else if (conn->state == DIR_CONN_STATE_SERVER_WRITING) {
+        (*write_out)++;
+        if (CONST_TO_DIR_CONN(conn)->hs_ident != NULL)
+          (*hs_write_out)++;
+      }
+    }
+  } SMARTLIST_FOREACH_END(conn);
+}
+
 /** Did <b>conn</b> ever send us a version 0 sendme cell and we allowed
  * it? Used to decide whether to count consensus fetches from it in our
  * geoip stats.
diff --git a/src/feature/dircommon/directory.h b/src/feature/dircommon/directory.h
index fbbb6d9..3b5ec6f 100644
--- a/src/feature/dircommon/directory.h
+++ b/src/feature/dircommon/directory.h
@@ -96,6 +96,10 @@ char *http_get_header(const char *headers, const char *which);
 int connection_dir_is_encrypted(const dir_connection_t *conn);
 bool connection_dir_is_anonymous(const dir_connection_t *conn);
 bool connection_dir_allow_hs_request(dir_connection_t *conn);
+void connection_dir_count_server_conns(uint64_t *wait_out,
+                                       uint64_t *write_out,
+                                       uint64_t *hs_write_out,
+                                       uint64_t *edge_out);
 bool connection_dir_used_obsolete_sendme(const dir_connection_t *conn);
 int connection_dir_reached_eof(dir_connection_t *conn);
 int connection_dir_process_inbuf(dir_connection_t *conn);
diff --git a/src/feature/relay/relay_metrics.c b/src/feature/relay/relay_metrics.c
