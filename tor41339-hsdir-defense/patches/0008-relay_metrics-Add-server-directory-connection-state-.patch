+#include "feature/dircommon/directory.h"
 #include "feature/hs/hs_dos.h"
 #include "feature/nodelist/nodelist.h"
 #include "feature/nodelist/node_st.h"
@@ -404,6 +405,9 @@ static void
 fill_dos_values(void)
 {
   const relay_metrics_entry_t *rentry = &base_metrics[RELAY_METRICS_NUM_DOS];
+  uint64_t dir_wait = 0, dir_write = 0, hsdir_write = 0, dir_edge = 0;
+  connection_dir_count_server_conns(&dir_wait, &dir_write, &hsdir_write,
+                                    &dir_edge);
   const struct {
     const char *type;
     uint64_t val;
@@ -437,12 +441,16 @@ fill_dos_values(void)
       dos_get_dir_stat(DOS_DIR_HSDIR_POST_OK) },
     { "hsdir_post_rejected",
       dos_get_dir_stat(DOS_DIR_HSDIR_POST_REJECTED) },
+    { "hsdir_writing_conns",       hsdir_write },
     { "dir_resp_completed",
       dos_get_dir_stat(DOS_DIR_RESP_COMPLETED) },
     { "dir_non_hs_request",
       dos_get_dir_stat(DOS_DIR_NON_HS_REQUEST) },
     { "dir_req_unparsed",
       dos_get_dir_stat(DOS_DIR_REQ_UNPARSED) },
+    { "dir_server_edge_conns",     dir_edge },
+    { "dir_server_wait_conns",     dir_wait },
+    { "dir_server_write_conns",    dir_write },
     { "stream_rejected",           dos_get_num_stream_rejected() },
   };
 
diff --git a/src/test/test_hs_cache.c b/src/test/test_hs_cache.c
index 7763feb..16efec1 100644
--- a/src/test/test_hs_cache.c
+++ b/src/test/test_hs_cache.c
@@ -20,6 +20,7 @@
 #include "feature/hs/hs_ident.h"
 #include "feature/nodelist/networkstatus.h"
 #include "core/mainloop/connection.h"
+#include "core/mainloop/mainloop.h"
 #include "core/proto/proto_http.h"
 #include "core/or/circuitlist.h"
 #include "core/or/channel.h"
@@ -837,6 +838,8 @@ static void
 test_downloaded_counter_non_hs(void *arg)
 {
   dir_connection_t *conn = dir_connection_new(AF_INET);
+  edge_connection_t *edge = edge_connection_new(CONN_TYPE_EXIT, AF_INET);
+  uint64_t wait_c = 0, write_c = 0, hs_write_c = 0, edge_c = 0;
   const uint64_t unparsed_before = dos_get_dir_stat(DOS_DIR_REQ_UNPARSED);
   const uint64_t completed_before =
     dos_get_dir_stat(DOS_DIR_RESP_COMPLETED);
@@ -845,19 +848,42 @@ test_downloaded_counter_non_hs(void *arg)
   MOCK(connection_mark_for_close_internal_, hsdir_mock_mark_for_close);
   TO_CONN(conn)->purpose = DIR_PURPOSE_SERVER;
   TO_CONN(conn)->state = DIR_CONN_STATE_SERVER_COMMAND_WAIT;
+  TO_CONN(edge)->linked = 1;
+  smartlist_add(get_connection_array(), TO_CONN(conn));
+  smartlist_add(get_connection_array(), TO_CONN(edge));
+
+  connection_dir_count_server_conns(&wait_c, &write_c, &hs_write_c, &edge_c);
+  tt_u64_op(wait_c, OP_EQ, 1);
+  tt_u64_op(write_c, OP_EQ, 0);
+  tt_u64_op(hs_write_c, OP_EQ, 0);
+  tt_u64_op(edge_c, OP_EQ, 1);
+
   connection_dir_about_to_close(conn);
   tt_u64_op(dos_get_dir_stat(DOS_DIR_REQ_UNPARSED),
             OP_EQ, unparsed_before + 1);
 
   TO_CONN(conn)->state = DIR_CONN_STATE_SERVER_WRITING;
+  connection_dir_count_server_conns(&wait_c, &write_c, &hs_write_c, &edge_c);
+  tt_u64_op(wait_c, OP_EQ, 0);
+  tt_u64_op(write_c, OP_EQ, 1);
+  tt_u64_op(hs_write_c, OP_EQ, 0);
+  tt_u64_op(edge_c, OP_EQ, 1);
+
   tt_int_op(connection_dir_finished_flushing(conn), OP_EQ, 0);
   tt_assert(TO_CONN(conn)->marked_for_close);
   tt_u64_op(dos_get_dir_stat(DOS_DIR_RESP_COMPLETED),
             OP_EQ, completed_before + 1);
 
+  connection_dir_count_server_conns(&wait_c, &write_c, &hs_write_c, &edge_c);
+  tt_u64_op(wait_c, OP_EQ, 0);
+  tt_u64_op(write_c, OP_EQ, 0);
+  tt_u64_op(edge_c, OP_EQ, 1);
+
  done:
   UNMOCK(connection_mark_for_close_internal_);
+  smartlist_clear(get_connection_array());
   connection_free_minimal(TO_CONN(conn));
+  connection_free_minimal(TO_CONN(edge));
 }
 
