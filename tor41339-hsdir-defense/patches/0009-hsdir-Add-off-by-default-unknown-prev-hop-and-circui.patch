+static void
+mock_circuit_mark_for_close(circuit_t *circ, int reason, int line,
+                            const char *file)
+{
+  (void) line; (void) file;
+  circ->marked_for_close = 1;
+  circ->marked_for_close_reason = reason;
+}
+
+static networkstatus_t *mock_hsdir_ns;
+static networkstatus_t *
+mock_hsdir_get_latest_consensus(void)
+{
+  return mock_hsdir_ns;
+}
+
+/* Install a mock latest consensus whose only net_param is <b>param</b>, e.g.
+ * "hsdir_one_request_per_circ=1", so the real networkstatus_get_param() parses
+ * it through get_net_param_from_list() via dos_consensus_has_changed(). */
+static void
+set_mock_consensus_param(const char *param)
+{
+  mock_hsdir_ns = tor_malloc_zero(sizeof(networkstatus_t));
+  mock_hsdir_ns->net_params = smartlist_new();
+  mock_hsdir_ns->routerstatus_list = smartlist_new();
+  smartlist_add_strdup(mock_hsdir_ns->net_params, param);
+  MOCK(networkstatus_get_latest_consensus,
+       mock_hsdir_get_latest_consensus);
+  dos_consensus_has_changed(mock_hsdir_ns);
+}
+
+static void
+clear_mock_consensus(void)
+{
+  UNMOCK(networkstatus_get_latest_consensus);
+  if (mock_hsdir_ns) {
+    SMARTLIST_FOREACH(mock_hsdir_ns->net_params, char *, s, tor_free(s));
+    smartlist_free(mock_hsdir_ns->net_params);
+    smartlist_free(mock_hsdir_ns->routerstatus_list);
+    tor_free(mock_hsdir_ns);
+  }
+  dos_consensus_has_changed(NULL);
+}
+
+/* Make an onion service directory request on <b>circ</b>, a descriptor upload
+ * of <b>post_body</b> when non-NULL or a GET otherwise, optionally extracting
+ * the response into *<b>reply_out</b>, and return the length of the HSDir's
+ * response (0 if the request was refused before any response was written). */
+static size_t
+helper_hs_request_on_circ_impl(or_circuit_t *circ, const char *post_body,
+                               char **reply_out)
+{
+  edge_connection_t *edge_conn = edge_connection_new(CONN_TYPE_EXIT, AF_INET);
+  dir_connection_t *conn = dir_connection_new(AF_INET);
+  size_t len;
+
+  edge_conn->on_circuit = TO_CIRCUIT(circ);
+  TO_CONN(conn)->linked = 1; /* Signal that it is encrypted. */
+  TO_CONN(conn)->linked_conn = TO_CONN(edge_conn);
+  if (post_body)
+    directory_handle_command_post(conn, "POST /tor/hs/3/publish HTTP/1.0\r\n"
+                                  "\r\n", post_body, strlen(post_body));
+  else
+    directory_handle_command_get(conn, GET("/tor/hs/3/x"), NULL, 0);
+  len = connection_get_outbuf_len(TO_CONN(conn));
+  if (reply_out)
+    *reply_out = buf_extract(TO_CONN(conn)->outbuf, NULL);
+  connection_free_minimal(TO_CONN(edge_conn));
+  connection_free_minimal(TO_CONN(conn));
+  return len;
+}
+
+static size_t
+helper_hs_request_on_circ(or_circuit_t *circ, bool post)
+{
+  return helper_hs_request_on_circ_impl(circ, post ? "x" : NULL, NULL);
+}
+
+/* Check that the hsdir_circ_reused counter reads <b>n_circ</b> both in the DoS
+ * heartbeat and on the MetricsPort, and that hsdir_req_reused and
+ * hsdir_request_total read <b>n_req_reused</b> and <b>n_req_total</b> on the
+ * MetricsPort. */
+static void
+expect_hsdir_reuse_count(uint64_t n_circ, uint64_t n_req_reused,
+                         uint64_t n_req_total)
+{
+  char *expect = NULL, *out = NULL;
+  buf_t *buf = buf_new();
+  const struct {
+    const char *name;
+    uint64_t val;
+  } exp[] = {
+    { "hsdir_circ_reused", n_circ },
+    { "hsdir_req_reused", n_req_reused },
+    { "hsdir_request_total", n_req_total },
+  };
+
+  tor_asprintf(&expect,
+               "%"PRIu64" circuits with repeated HSDir requests", n_circ);
+  setup_full_capture_of_logs(LOG_NOTICE);
+  dos_log_heartbeat();
+  expect_log_msg_containing(expect);
+  teardown_capture_of_logs();
+
+  metrics_store_get_output(METRICS_FORMAT_PROMETHEUS,
+                           smartlist_get(relay_metrics_get_stores(), 0), buf);
+  out = buf_extract(buf, NULL);
+  for (size_t i = 0; i < ARRAY_LENGTH(exp); i++) {
+    tor_free(expect);
+    tor_asprintf(&expect, "tor_relay_dos_total{type=\"%s\"} %"PRIu64"\n",
+                 exp[i].name, exp[i].val);
+    tt_assert(strstr(out, expect));
+  }
+
+ done:
+  teardown_capture_of_logs();
+  tor_free(expect);
+  tor_free(out);
+  buf_free(buf);
+}
