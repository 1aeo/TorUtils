+close_hsdir_circuit_for_resourcelimit(or_circuit_t *circ,
+                                      ratelim_t *lim, const char *why)
+{
+  log_fn_ratelim(lim, LOG_PROTOCOL_WARN, LD_REND,
+                 "Closing circuit after %s from %s.", why,
+                 describe_hsdir_prev_hop(circ->p_chan));
+  circuit_mark_for_close(TO_CIRCUIT(circ), END_CIRC_REASON_RESOURCELIMIT);
+}
