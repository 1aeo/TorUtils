+/* An HSDir can refuse an onion service request whose previous hop is not a
+ * known relay. Enforcement is off by default (observe only) and is its own
+ * option, independent of RefuseUnknownExits. The pre-existing 0.4.2.1-alpha
+ * client-channel refusal still stands on top of it. */
+static void
+test_hsdir_refuse_unknown_prev_hop(void *arg)
+{
+  channel_t *chan = tor_malloc_zero(sizeof(channel_t)); /* zeroed digest */
+  routerstatus_t known_rs;
+  dos_options_t *dos_opts;
+  or_circuit_t *circ;
+  char *reply = NULL;
+  (void) arg;
+
+  init_test();
+  MOCK(circuit_mark_for_close_, mock_circuit_mark_for_close);
+  get_options_mutable()->ORPort_set = 1;
+  get_options_mutable()->RefuseUnknownExits = 0; /* Independent of HS rule. */
+  dos_opts = get_dos_options(get_options_mutable());
+  memset(&known_rs, 0, sizeof(known_rs)); /* Matches the zeroed prev hop. */
+
+  /* Default (observe): an unknown previous hop is served (404, not 503) but
+   * counted, even though RefuseUnknownExits is on-by-consensus for exits. */
+  tt_int_op(dos_opts->HSDirRefuseUnknownPrevHop, OP_EQ, -1);
+  circ = or_circuit_new(0, NULL);
+  circ->p_chan = chan;
+  reply = hsdir_get_reply_on_circ(circ);
+  tt_assert(!strstr(reply, " 503 "));
+  tor_free(reply);
+  tt_u64_op(dos_get_dir_stat(DOS_DIR_HSDIR_UNKNOWN_PREV_HOP), OP_EQ, 1);
+
+  /* Force enforcement on via torrc: an unknown previous hop now gets our own
+   * 503, independent of RefuseUnknownExits (still 0). A second request on the
+   * same circuit still increments the reuse counters while previous-hop
+   * enforcement is on, and closes the circuit when one-request-per-circuit
+   * enforcement is also on. */
+  dos_opts->HSDirRefuseUnknownPrevHop = 1;
+  uint64_t circ_reused_before = dos_get_dir_stat(DOS_DIR_HSDIR_CIRC_REUSED);
+  uint64_t req_reused_before = dos_get_dir_stat(DOS_DIR_HSDIR_REQ_REUSED);
+  circ = or_circuit_new(0, NULL);
+  circ->p_chan = chan;
+  reply = hsdir_get_reply_on_circ(circ);
+  tt_assert(strstr(reply, " 503 "));
+  tt_assert(strstr(reply, "previous hop is not a known relay"));
+  tor_free(reply);
+  reply = hsdir_get_reply_on_circ(circ);
+  tt_assert(strstr(reply, " 503 "));
+  tor_free(reply);
+  tt_u64_op(dos_get_dir_stat(DOS_DIR_HSDIR_CIRC_REUSED),
+            OP_EQ, circ_reused_before + 1);
+  tt_u64_op(dos_get_dir_stat(DOS_DIR_HSDIR_REQ_REUSED),
+            OP_EQ, req_reused_before + 1);
+  tt_int_op(TO_CIRCUIT(circ)->marked_for_close, OP_EQ, 0);
+
+  dos_opts->HSDirOneRequestPerCircuit = 1;
+  for (int i = 0; i < 2; i++) {
+    bool post = (i == 1);
+    circ = or_circuit_new(0, NULL);
+    circ->p_chan = chan;
+    tt_size_op(helper_hs_request_on_circ(circ, post), OP_GT, 0); /* 503 */
+    tt_int_op(TO_CIRCUIT(circ)->marked_for_close, OP_EQ, 0);
+    tt_size_op(helper_hs_request_on_circ(circ, post), OP_EQ, 0); /* closed */
+    tt_int_op(TO_CIRCUIT(circ)->marked_for_close, OP_EQ, 1);
+    tt_int_op(TO_CIRCUIT(circ)->marked_for_close_reason, OP_EQ,
+              END_CIRC_REASON_RESOURCELIMIT);
+  }
+  tt_u64_op(dos_get_dir_stat(DOS_DIR_HSDIR_CIRC_REUSED),
+            OP_EQ, circ_reused_before + 3);
+  tt_u64_op(dos_get_dir_stat(DOS_DIR_HSDIR_REQ_REUSED),
+            OP_EQ, req_reused_before + 3);
+  tt_u64_op(dos_get_dir_stat(DOS_DIR_HSDIR_UNKNOWN_PREV_HOP), OP_EQ, 7);
+  dos_opts->HSDirOneRequestPerCircuit = -1;
+
+  /* A known relay as previous hop is served even while enforcing. The mock
+   * consensus has a single routerstatus with the zeroed prev-hop identity, so
+   * the real router_get_consensus_status_by_id() bsearch finds it. */
+  mock_hsdir_ns = tor_malloc_zero(sizeof(networkstatus_t));
+  mock_hsdir_ns->routerstatus_list = smartlist_new();
+  smartlist_add(mock_hsdir_ns->routerstatus_list, &known_rs);
+  MOCK(networkstatus_get_latest_consensus, mock_hsdir_get_latest_consensus);
+  circ = or_circuit_new(0, NULL);
+  circ->p_chan = chan;
+  reply = hsdir_get_reply_on_circ(circ);
+  tt_assert(!strstr(reply, " 503 "));
+  tor_free(reply);
+  UNMOCK(networkstatus_get_latest_consensus);
+  smartlist_free(mock_hsdir_ns->routerstatus_list);
+  tor_free(mock_hsdir_ns);
+
+  /* The pre-existing rule still stands: a client channel as previous hop is
+   * refused regardless of this option or RefuseUnknownExits. */
+  dos_opts->HSDirRefuseUnknownPrevHop = 0;
+  chan->is_client = 1;
+  circ = or_circuit_new(0, NULL);
+  circ->p_chan = chan;
+  reply = hsdir_get_reply_on_circ(circ);
+  tt_assert(strstr(reply, " 503 "));
+  tt_u64_op(dos_get_dir_stat(DOS_DIR_HSDIR_SINGLE_HOP), OP_EQ, 1);
+  tor_free(reply);
+
+ done:
+  UNMOCK(networkstatus_get_latest_consensus);
+  UNMOCK(circuit_mark_for_close_);
+  tor_free(reply);
+  SMARTLIST_FOREACH(circuit_get_global_list(), circuit_t *, c,
+                    TO_OR_CIRCUIT(c)->p_chan = NULL);
+  circuit_free_all();
+  tor_free(chan);
+}
