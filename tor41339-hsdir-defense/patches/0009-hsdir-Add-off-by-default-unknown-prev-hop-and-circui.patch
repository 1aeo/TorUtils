+/* Return the effective value of an AUTOBOOL torrc option <b>opt</b> (-1 for
+ * "auto") that overrides the cached consensus parameter <b>param</b>. */
+static int
+dos_autobool_or_param(int opt, unsigned int param)
+{
+  /* Public relays only; see dos_should_refuse_single_hop_client() (24963). */
+  if (!public_server_mode(get_options())) return 0;
+  return (opt != -1) ? opt : (int)param;
+}
+
+/* Return true iff an HSDir should close ("enforce"), rather than only count,
+ * a circuit that makes more than one onion service directory request. The
+ * HSDirOneRequestPerCircuit torrc option overrides the
+ * hsdir_one_request_per_circ consensus parameter, which defaults to off. */
+int
+dos_should_enforce_hsdir_one_request_per_circ(void)
+{
+  return dos_autobool_or_param(dos_get_options()->HSDirOneRequestPerCircuit,
+                               dos_hsdir_one_request_per_circ);
+}
+
 /* Note down that we've just seen an anonymous onion service directory request
  * on a circuit that had previously made <b>prev_count</b> such requests.
  * Counts all anonymous HS requests in DOS_DIR_HSDIR_REQUEST_TOTAL, every
@@ -1059,6 +1091,18 @@ dos_note_hsdir_request(unsigned int prev_count)
