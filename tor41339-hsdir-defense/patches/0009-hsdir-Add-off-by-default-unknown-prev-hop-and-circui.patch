+/* Return the HSDir's whole reply to one descriptor fetch on <b>circ</b>. */
+static char *
+hsdir_get_reply_on_circ(or_circuit_t *circ)
+{
+  char *out = NULL;
+  helper_hs_request_on_circ_impl(circ, NULL, &out);
+  return out;
+}
