+/** Return a safe human-readable description of <b>p_chan</b> for rate-limited
+ * HSDir protocol warnings. */
+static const char *
+describe_hsdir_prev_hop(channel_t *p_chan)
+{
+  return p_chan && p_chan->describe_peer ?
+         safe_str(channel_describe_peer(p_chan)) : "(unknown)";
+}
+
+/** Log a rate-limited protocol warning with <b>why</b> and close <b>circ</b>
+ * with END_CIRC_REASON_RESOURCELIMIT. */
