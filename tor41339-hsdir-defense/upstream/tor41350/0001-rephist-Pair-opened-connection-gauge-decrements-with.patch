diff --git a/changes/ticket41350 b/changes/ticket41350
new file mode 100644
index 0000000..f13b04b
--- /dev/null
+++ b/changes/ticket41350
@@ -0,0 +1,11 @@
+  o Minor bugfixes (relay, metrics):
+    - Only decrement the MetricsPort opened-connection gauge
+      (tor_relay_connections{state="opened"}) for connections that were
+      counted as opened, and use the direction, type, and address family
+      recorded at open time. Previously, connections closed before
+      note_connection() (such as accepted OR connections whose initial TLS
+      handshake failed synchronously, unattached outbound directory or
+      resolving exit streams, and socketless linked directory/exit/AP pairs)
+      decremented the gauge without a prior increment, and Extended ORPort
+      connections retyped to OR on transition left EXT_OR elevated while
+      decrementing OR on close. Fixes bug 41350; bugfix on 0.4.7.1-alpha.
diff --git a/src/core/mainloop/connection.c b/src/core/mainloop/connection.c
index cd71bb8..9a953ce 100644
--- a/src/core/mainloop/connection.c
+++ b/src/core/mainloop/connection.c
@@ -648,13 +648,30 @@ listener_connection_new(int type, int socket_family)
 {
   listener_connection_t *listener_conn =
     tor_malloc_zero(sizeof(listener_connection_t));
-  connection_init(time(NULL), TO_CONN(listener_conn), type, socket_family);
+  connection_t *conn = TO_CONN(listener_conn);
+  connection_init(time(NULL), conn, type, socket_family);
   /* Listener connections aren't accounted for with note_connection() so do
    * this explicitly so to count them. */
+  conn->in_rephist_opened = 1;
+  conn->opened_from_listener = 0;
+  conn->opened_type = type;
+  conn->opened_socket_family = socket_family;
   rep_hist_note_conn_opened(false, type, socket_family);
   return listener_conn;
 }
 
+/** If <b>conn</b> was counted as opened in rephist, note that it is now
+ * closed using the direction, type, and address family that were counted. */
+static void
+connection_note_closed(connection_t *conn)
+{
+  if (!conn->in_rephist_opened)
+    return;
+  conn->in_rephist_opened = 0;
+  rep_hist_note_conn_closed(conn->opened_from_listener, conn->opened_type,
+                            conn->opened_socket_family);
+}
+
 /** Allocate, initialize, and return a new connection_t subtype of <b>type</b>
  * to make or receive connections of address family <b>socket_family</b>.  The
  * type should be one of the CONN_TYPE_* constants. */
@@ -787,6 +804,8 @@ connection_free_minimal(connection_t *conn)
   if (!conn)
     return;
 
+  connection_note_closed(conn);
+
   switch (conn->type) {
     case CONN_TYPE_OR:
     case CONN_TYPE_EXT_OR:
@@ -1176,9 +1195,8 @@ connection_mark_for_close_internal_, (connection_t *conn,
    * we get our whole 15 seconds */
   conn->timestamp_last_write_allowed = time(NULL);
 
-  /* Note the connection close. */
-  rep_hist_note_conn_closed(conn->from_listener, conn->type,
-                            conn->socket_family);
+  /* Note the connection close, if it was counted as opened. */
+  connection_note_closed(conn);
 }
 
 /** Find each connection that has hold_open_until_flushed set to
