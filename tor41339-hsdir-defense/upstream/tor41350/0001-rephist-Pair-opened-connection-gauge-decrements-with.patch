   /** CONNECT/SOCKS proxy client handshake state (for outgoing connections). */
   unsigned int proxy_state:4;
@@ -114,6 +121,8 @@ struct connection_t {
 
   int socket_family; /**< Address family of this connection's socket.  Usually
                       * AF_INET, but it can also be AF_UNIX, or AF_INET6 */
+  int opened_socket_family; /**< Address family passed to
+                             * rep_hist_note_conn_opened(). */
   /**
    * IP address on the internet of this connection's peer, usually.
    *
diff --git a/src/core/or/status.c b/src/core/or/status.c
index d44942e..04dc1a2 100644
--- a/src/core/or/status.c
+++ b/src/core/or/status.c
@@ -132,8 +132,9 @@ static unsigned n_outgoing_ipv6;
  * heartbeat message.
  **/
 void
-note_connection(bool inbound, const connection_t *conn)
+note_connection(bool inbound, connection_t *conn)
 {
+  tor_assert(conn);
   if (conn->socket_family == AF_INET) {
     if (inbound) {
       ++n_incoming_ipv4;
@@ -148,6 +149,12 @@ note_connection(bool inbound, const connection_t *conn)
     }
   }
 
+  if (BUG(conn->in_rephist_opened))
+    return;
+  conn->in_rephist_opened = 1;
+  conn->opened_from_listener = inbound ? 1 : 0;
+  conn->opened_type = conn->type;
+  conn->opened_socket_family = conn->socket_family;
   rep_hist_note_conn_opened(inbound, conn->type, conn->socket_family);
 }
 
