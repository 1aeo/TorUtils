+static int mock_tls_handshake_rv = 0;
+
+static void
+mock_conn_start_reading(connection_t *conn)
+{
+  (void)conn;
+}
+
+static int
+mock_tls_start_handshake(or_connection_t *conn, int receiving)
+{
+  (void)receiving;
+  TO_CONN(conn)->state = OR_CONN_STATE_CONNECTING;
+  return mock_tls_handshake_rv;
+}
+
+/** Test connection opened/closed rephist accounting across paired and
+ * unpaired lifecycle paths (tor#41350). */
+static void
+test_rephist_conn_opened(void *arg)
+{
+  (void)arg;
+  listener_connection_t *lis1 = NULL, *lis2 = NULL;
+  connection_t *or_open = NULL, *or_roundtrip = NULL, *or_fail = NULL;
+  connection_t *exit_open = NULL, *dir_open = NULL;
+  edge_connection_t *linked_exit = NULL;
+  dir_connection_t *linked_dir = NULL;
+  or_connection_t *ext_conn = NULL;
+
+  MOCK(connection_start_reading, mock_conn_start_reading);
+  MOCK(connection_tls_start_handshake, mock_tls_start_handshake);
+  tor_init_connection_lists();
+
+  /* 1. Listener connection: counted at creation, decremented on mark/free. */
+  lis1 = listener_connection_new(CONN_TYPE_OR_LISTENER, AF_INET);
+  TO_CONN(lis1)->state = LISTENER_STATE_READY;
+  tt_u64_op(rep_hist_get_conn_created(false, CONN_TYPE_OR_LISTENER, AF_INET),
+            OP_EQ, 1);
+  tt_u64_op(rep_hist_get_conn_opened(false, CONN_TYPE_OR_LISTENER, AF_INET),
+            OP_EQ, 1);
+  connection_mark_for_close(TO_CONN(lis1));
+  tt_u64_op(rep_hist_get_conn_opened(false, CONN_TYPE_OR_LISTENER, AF_INET),
+            OP_EQ, 0);
+
+  lis2 = listener_connection_new(CONN_TYPE_OR_LISTENER, AF_INET);
+  TO_CONN(lis2)->state = LISTENER_STATE_READY;
+  tt_u64_op(rep_hist_get_conn_opened(false, CONN_TYPE_OR_LISTENER, AF_INET),
+            OP_EQ, 1);
+  connection_free_minimal(TO_CONN(lis2));
+  lis2 = NULL;
+  tt_u64_op(rep_hist_get_conn_opened(false, CONN_TYPE_OR_LISTENER, AF_INET),
+            OP_EQ, 0);
+
+  /* 2. Normal accept/close round trip, keeping one OR conn open as canary. */
+  or_open = connection_new(CONN_TYPE_OR, AF_INET);
+  or_open->from_listener = 1;
+  or_open->state = OR_CONN_STATE_CONNECTING;
+  or_open->address = tor_strdup("127.0.0.1");
+  note_connection(true, or_open);
+
+  or_roundtrip = connection_new(CONN_TYPE_OR, AF_INET);
+  or_roundtrip->from_listener = 1;
+  or_roundtrip->state = OR_CONN_STATE_CONNECTING;
+  or_roundtrip->address = tor_strdup("127.0.0.1");
+  note_connection(true, or_roundtrip);
+  tt_u64_op(rep_hist_get_conn_created(true, CONN_TYPE_OR, AF_INET), OP_EQ, 2);
+  tt_u64_op(rep_hist_get_conn_opened(true, CONN_TYPE_OR, AF_INET), OP_EQ, 2);
+  connection_mark_for_close_internal_(or_roundtrip, __LINE__, __FILE__);
+  tt_u64_op(rep_hist_get_conn_opened(true, CONN_TYPE_OR, AF_INET), OP_EQ, 1);
+
+  /* 3. Accepted conn whose init fails before note_connection(). */
+  mock_tls_handshake_rv = -1;
+  or_fail = connection_new(CONN_TYPE_OR, AF_INET);
+  or_fail->from_listener = 1;
+  or_fail->address = tor_strdup("127.0.0.1");
+  tt_int_op(connection_init_accepted_conn(or_fail, lis1), OP_LT, 0);
+  tt_assert(or_fail->marked_for_close);
+  tt_u64_op(rep_hist_get_conn_opened(true, CONN_TYPE_OR, AF_INET), OP_EQ, 1);
+
+  /* 4. Linked pair's close must not pull down open Exit/Dir gauges. */
+  exit_open = connection_new(CONN_TYPE_EXIT, AF_INET);
+  exit_open->state = EXIT_CONN_STATE_CONNECTING;
+  exit_open->purpose = EXIT_PURPOSE_CONNECT;
+  note_connection(false, exit_open);
+  dir_open = connection_new(CONN_TYPE_DIR, AF_INET);
+  dir_open->state = DIR_CONN_STATE_CONNECTING;
+  dir_open->purpose = DIR_PURPOSE_FETCH_CONSENSUS;
+  note_connection(false, dir_open);
+  tt_u64_op(rep_hist_get_conn_opened(false, CONN_TYPE_EXIT, AF_INET),
+            OP_EQ, 1);
+  tt_u64_op(rep_hist_get_conn_opened(false, CONN_TYPE_DIR, AF_INET),
+            OP_EQ, 1);
+
+  linked_exit = edge_connection_new(CONN_TYPE_EXIT, AF_INET);
+  TO_CONN(linked_exit)->state = EXIT_CONN_STATE_OPEN;
+  TO_CONN(linked_exit)->purpose = EXIT_PURPOSE_CONNECT;
+  linked_dir = dir_connection_new(AF_INET);
+  TO_CONN(linked_dir)->state = DIR_CONN_STATE_SERVER_COMMAND_WAIT;
+  TO_CONN(linked_dir)->purpose = DIR_PURPOSE_SERVER;
+  connection_link_connections(TO_CONN(linked_exit), TO_CONN(linked_dir));
+  connection_mark_for_close(TO_CONN(linked_exit));
+  connection_mark_for_close(TO_CONN(linked_dir));
+  tt_u64_op(rep_hist_get_conn_opened(false, CONN_TYPE_EXIT, AF_INET),
+            OP_EQ, 1);
+  tt_u64_op(rep_hist_get_conn_opened(false, CONN_TYPE_DIR, AF_INET),
+            OP_EQ, 1);
+
+  /* 5. ExtOR retype to OR on transition must decrement EXT_OR, not OR. */
+  mock_tls_handshake_rv = 0;
+  ext_conn = or_connection_new(CONN_TYPE_EXT_OR, AF_INET);
+  TO_CONN(ext_conn)->from_listener = 1;
+  TO_CONN(ext_conn)->state = EXT_OR_CONN_STATE_FLUSHING;
+  TO_CONN(ext_conn)->address = tor_strdup("127.0.0.1");
+  note_connection(true, TO_CONN(ext_conn));
+  tt_u64_op(rep_hist_get_conn_opened(true, CONN_TYPE_EXT_OR, AF_INET),
+            OP_EQ, 1);
+  tt_int_op(connection_ext_or_finished_flushing(ext_conn), OP_EQ, 0);
+  tt_int_op(TO_CONN(ext_conn)->type, OP_EQ, CONN_TYPE_OR);
+  connection_mark_for_close_internal_(TO_CONN(ext_conn), __LINE__, __FILE__);
+  tt_u64_op(rep_hist_get_conn_opened(true, CONN_TYPE_EXT_OR, AF_INET),
+            OP_EQ, 0);
+  tt_u64_op(rep_hist_get_conn_opened(true, CONN_TYPE_OR, AF_INET),
+            OP_EQ, 1);
+
+ done:
+  UNMOCK(connection_start_reading);
+  UNMOCK(connection_tls_start_handshake);
+  connection_free_minimal(TO_CONN(lis1));
+  connection_free_minimal(TO_CONN(lis2));
+  connection_free_minimal(or_open);
+  connection_free_minimal(or_roundtrip);
+  connection_free_minimal(or_fail);
+  connection_free_minimal(exit_open);
+  connection_free_minimal(dir_open);
+  connection_free_minimal(TO_CONN(linked_exit));
+  connection_free_minimal(TO_CONN(linked_dir));
+  connection_free_minimal(TO_CONN(ext_conn));
+}
+
