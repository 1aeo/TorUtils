 src/feature/dircache/dircache.c   | 14 ++++-
 src/feature/hs/hs_cache.c         |  8 ++-
 src/feature/relay/relay_metrics.c | 45 +++++++++++++++
 src/feature/relay/relay_metrics.h | 23 ++++++++
 src/test/test_hs_cache.c          | 92 ++++++++++++++++++++++++++++++-
 src/test/test_stats.c             |  2 +-
 7 files changed, 185 insertions(+), 6 deletions(-)
 create mode 100644 changes/hsdir_post_metrics

diff --git a/changes/hsdir_post_metrics b/changes/hsdir_post_metrics
new file mode 100644
index 0000000000..4eeab13175
--- /dev/null
+++ b/changes/hsdir_post_metrics
@@ -0,0 +1,7 @@
+  o Minor features (relay, metrics, onion service directory):
+    - Add the MetricsPort counter tor_relay_hsdir_post_total of onion
+      service descriptor uploads received by outcome: "success",
+      "bad_url", "invalid", "not_newer" (a valid descriptor whose revision
+      counter is not greater than the cached one, as happens when several
+      instances publish for the same onion address) and "single_hop".
+      Part of ticket 41339.
diff --git a/src/feature/dircache/dircache.c b/src/feature/dircache/dircache.c
index aee047c105..7b369845ad 100644
--- a/src/feature/dircache/dircache.c
+++ b/src/feature/dircache/dircache.c
@@ -31,6 +31,7 @@
 #include "feature/nodelist/networkstatus.h"
 #include "feature/nodelist/routerlist.h"
 #include "feature/relay/relay_config.h"
+#include "feature/relay/relay_metrics.h"
 #include "feature/relay/routermode.h"
 #include "feature/stats/geoip_stats.h"
 #include "feature/stats/rephist.h"
@@ -1536,6 +1537,7 @@ handle_post_hs_descriptor(const char *url, const char *body)
 {
   int version;
   const char *end_pos;
+  hsdir_post_action_t action = HSDIR_POST_BAD_URL;
 
   tor_assert(url);
   tor_assert(body);
@@ -1553,7 +1555,14 @@ handle_post_hs_descriptor(const char *url, const char *body)
 
   switch (version) {
   case HS_VERSION_THREE:
-    if (hs_cache_store_as_dir(body) < 0) {
+    switch (hs_cache_store_as_dir(body)) {
+    case 0:
+      break;
+    case -2:
+      action = HSDIR_POST_NOT_NEWER;
+      goto err;
+    default:
+      action = HSDIR_POST_INVALID;
       goto err;
     }
     log_info(LD_REND, "Publish request for HS descriptor handled "
@@ -1564,9 +1573,11 @@ handle_post_hs_descriptor(const char *url, const char *body)
     goto err;
   }
 
+  relay_increment_hsdir_post_action(HSDIR_POST_SUCCESS);
   return 200;
  err:
   /* Bad request. */
+  relay_increment_hsdir_post_action(action);
   return 400;
 }
 
@@ -1607,6 +1618,7 @@ directory_handle_command_post,(dir_connection_t *conn, const char *headers,
    * post a descriptor onto an HSDir. */
   if (!strcmpstart(url, "/tor/hs/")) {
     if (!connection_dir_is_anonymous(conn)) {
+      relay_increment_hsdir_post_action(HSDIR_POST_SINGLE_HOP);
       write_short_http_response(conn, 503,
                                 "Rejecting single hop HS descriptor post");
       goto done;
diff --git a/src/feature/hs/hs_cache.c b/src/feature/hs/hs_cache.c
index 128051b241..8c1a39e157 100644
--- a/src/feature/hs/hs_cache.c
+++ b/src/feature/hs/hs_cache.c
@@ -376,11 +376,12 @@ cache_clean_v3_as_dir(time_t now, time_t global_cutoff)
 }
 
 /** Given an encoded descriptor, store it in the directory cache depending on
- * which version it is. Return a negative value on error. On success, 0 is
- * returned. */
+ * which version it is. On success, 0 is returned. Return -2 if the descriptor
+ * is valid but not newer than the one in our cache, else -1 on error. */
 int
 hs_cache_store_as_dir(const char *desc)
 {
+  int ret = -1;
   hs_cache_dir_descriptor_t *dir_desc = NULL;
 
   tor_assert(desc);
@@ -399,6 +400,7 @@ hs_cache_store_as_dir(const char *desc)
   case HS_VERSION_THREE:
   default:
     if (cache_store_v3_as_dir(dir_desc) < 0) {
+      ret = -2;
       goto err;
     }
     break;
@@ -407,7 +409,7 @@ hs_cache_store_as_dir(const char *desc)
 
  err:
   cache_dir_desc_free(dir_desc);
-  return -1;
+  return ret;
 }
 
 /** Using the query, lookup in our directory cache the entry. If found, 1 is
diff --git a/src/feature/relay/relay_metrics.c b/src/feature/relay/relay_metrics.c
index 492a5945b8..2fd14958ec 100644
--- a/src/feature/relay/relay_metrics.c
+++ b/src/feature/relay/relay_metrics.c
@@ -67,6 +67,7 @@ static void fill_est_intro_cells(void);
 static void fill_est_rend_cells(void);
 static void fill_intro1_cells(void);
 static void fill_rend1_cells(void);
+static void fill_hsdir_post_values(void);
 
 /** The base metrics that is a static array of metrics added to the metrics
  * store.
@@ -242,6 +243,13 @@ static const relay_metrics_entry_t base_metrics[] =
     .help = "Total number of DROP cell we received",
     .fill_fn = fill_relay_drop_cell,
   },
+  {
+    .key = RELAY_METRICS_NUM_HSDIR_POST,
+    .type = METRICS_TYPE_COUNTER,
+    .name = METRICS_NAME(relay_hsdir_post_total),
+    .help = "Total number of onion service descriptor uploads we received",
+    .fill_fn = fill_hsdir_post_values,
+  },
 };
 static const size_t num_base_metrics = ARRAY_LENGTH(base_metrics);
 
@@ -1231,6 +1239,43 @@ fill_rend1_cells(void)
   }
 }
 
+static uint64_t hsdir_post_actions[HSDIR_POST_ACTION_COUNT] = {0};
+
+void
+relay_increment_hsdir_post_action(hsdir_post_action_t action)
+{
+  hsdir_post_actions[action]++;
+}
+
+static void
+fill_hsdir_post_values(void)
+{
+  metrics_store_entry_t *sentry;
+  const relay_metrics_entry_t *rentry =
+      &base_metrics[RELAY_METRICS_NUM_HSDIR_POST];
+
+  static struct {
+    const char *name;
+    hsdir_post_action_t key;
+  } actions[] = {
+      {.name = "success", .key = HSDIR_POST_SUCCESS},
+      {.name = "bad_url", .key = HSDIR_POST_BAD_URL},
+      {.name = "invalid", .key = HSDIR_POST_INVALID},
+      {.name = "not_newer", .key = HSDIR_POST_NOT_NEWER},
+      {.name = "single_hop", .key = HSDIR_POST_SINGLE_HOP},
+  };
+  static const size_t num_actions = ARRAY_LENGTH(actions);
+
+  for (size_t i = 0; i < num_actions; ++i) {
+    sentry = metrics_store_add(the_store, rentry->type, rentry->name,
+                               rentry->help, 0, NULL);
+    metrics_store_entry_add_label(
+        sentry, metrics_format_label("action", actions[i].name));
+    metrics_store_entry_update(sentry,
+                               (long)hsdir_post_actions[actions[i].key]);
+  }
+}
+
 /** Fill the metrics store for the RELAY_METRICS_CIRC_DESTROY_CELL counter. */
 static void
 fill_relay_destroy_cell(void)
diff --git a/src/feature/relay/relay_metrics.h b/src/feature/relay/relay_metrics.h
index e7b5b660fa..7a51f027f3 100644
--- a/src/feature/relay/relay_metrics.h
+++ b/src/feature/relay/relay_metrics.h
@@ -63,6 +63,8 @@ typedef enum {
   RELAY_METRICS_CIRC_PROTO_VIOLATION,
   /** Number of drop cell seen. */
   RELAY_METRICS_CIRC_DROP_CELL,
+  /** Number of onion service descriptor uploads we received. */
+  RELAY_METRICS_NUM_HSDIR_POST,
 } relay_metrics_key_t;
 
 /** The metadata of a relay metric. */
@@ -136,4 +138,25 @@ typedef enum {
 
 void relay_increment_rend1_action(rend1_action_t);
 
+/** Outcome of an onion service descriptor upload (HTTP POST /tor/hs/). */
+typedef enum {
+  /** Stored: 200. */
+  HSDIR_POST_SUCCESS,
+  /** Unsupported version or command in the URL: 400. */
+  HSDIR_POST_BAD_URL,
+  /** Descriptor didn't parse or validate: 400. */
+  HSDIR_POST_INVALID,
+  /** Valid descriptor, but its revision counter is not greater than the one
+   * of the descriptor we have in our cache: 400. This happens without any
+   * fault when several instances publish for the same onion address. */
+  HSDIR_POST_NOT_NEWER,
+  /** Not received over an anonymous circuit, see
+   * connection_dir_is_anonymous(): 503. */
+  HSDIR_POST_SINGLE_HOP,
+
+  HSDIR_POST_ACTION_COUNT
+} hsdir_post_action_t;
+
+void relay_increment_hsdir_post_action(hsdir_post_action_t);
+
 #endif /* !defined(TOR_FEATURE_RELAY_RELAY_METRICS_H) */
