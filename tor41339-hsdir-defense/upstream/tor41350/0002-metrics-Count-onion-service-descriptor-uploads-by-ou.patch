+/* Return the value of tor_relay_hsdir_post_total{action="<b>action</b>"}. */
+static int64_t
+get_hsdir_post_metric(const char *action)
+{
+  const smartlist_t *stores = relay_metrics_get_stores();
+  const smartlist_t *entries =
+    metrics_store_get_all(smartlist_get(stores, 0),
+                          METRICS_NAME(relay_hsdir_post_total));
+  const metrics_store_entry_t *entry =
+    metrics_store_find_entry_with_label(entries,
+                                        metrics_format_label("action",
+                                                             action));
+  return entry ? metrics_store_entry_get_value(entry) : -1;
+}
+
+static int
+mock_public_server_mode(const or_options_t *options)
+{
+  (void) options;
+  return 1;
+}
+
+/* Test that HSDirs count descriptor uploads by outcome on the MetricsPort. */
+static void
+test_hsdir_post_metrics(void *arg)
+{
+  int retval;
+  ed25519_keypair_t signing_kp;
+  hs_descriptor_t *desc = NULL;
+  char *desc_str = NULL;
+  dir_connection_t *conn = NULL;
+  const char *post = "POST /tor/hs/3/publish HTTP/1.0\r\n\r\n";
+
+  (void) arg;
+
+  init_test();
+  MOCK(connection_write_to_buf_impl_, connection_write_to_buf_mock);
+  MOCK(public_server_mode, mock_public_server_mode);
+
+  retval = ed25519_keypair_generate(&signing_kp, 0);
+  tt_int_op(retval, OP_EQ, 0);
+  desc = hs_helper_build_hs_desc_with_ip(&signing_kp);
+  tt_assert(desc);
+  retval = hs_desc_encode_descriptor(desc, &signing_kp, NULL, &desc_str);
+  tt_int_op(retval, OP_EQ, 0);
+
+  tt_int_op(handle_post_hs_descriptor("/tor/hs/3/publish", desc_str),
+            OP_EQ, 200);
+  tt_i64_op(get_hsdir_post_metric("success"), OP_EQ, 1);
+
+  /* Uploading it again is rejected, but isn't an invalid descriptor. */
+  tt_int_op(handle_post_hs_descriptor("/tor/hs/3/publish", desc_str),
+            OP_EQ, 400);
+  tt_i64_op(get_hsdir_post_metric("not_newer"), OP_EQ, 1);
+  tt_i64_op(get_hsdir_post_metric("invalid"), OP_EQ, 0);
+
+  tt_int_op(handle_post_hs_descriptor("/tor/hs/3/publish",
+                                      "hs-descriptor 3\nJUNK"), OP_EQ, 400);
+  tt_i64_op(get_hsdir_post_metric("invalid"), OP_EQ, 1);
+
+  tt_int_op(handle_post_hs_descriptor("/tor/hs/x/publish", desc_str),
+            OP_EQ, 400);
+  tt_int_op(handle_post_hs_descriptor("/tor/hs/3/fetch", desc_str),
+            OP_EQ, 400);
+  tt_int_op(handle_post_hs_descriptor("/tor/hs/2/publish", desc_str),
+            OP_EQ, 400);
+  tt_i64_op(get_hsdir_post_metric("bad_url"), OP_EQ, 3);
+
+  /* A direct (not tunneled) upload is refused before being looked at. */
+  conn = dir_connection_new(AF_INET);
+  tt_int_op(directory_handle_command_post(conn, post, desc_str,
+                                          strlen(desc_str)), OP_EQ, 0);
+  tt_i64_op(get_hsdir_post_metric("single_hop"), OP_EQ, 1);
+  tt_i64_op(get_hsdir_post_metric("success"), OP_EQ, 1);
+  tt_i64_op(get_hsdir_post_metric("not_newer"), OP_EQ, 1);
+
+ done:
+  UNMOCK(connection_write_to_buf_impl_);
+  UNMOCK(public_server_mode);
+  connection_free_minimal(TO_CONN(conn));
+  hs_descriptor_free(desc);
+  tor_free(desc_str);
+}
+
 static networkstatus_t mock_ns;
 
