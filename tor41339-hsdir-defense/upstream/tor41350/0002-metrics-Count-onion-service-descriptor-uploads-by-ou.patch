@@ -772,6 +860,8 @@ struct testcase_t hs_cache[] = {
     NULL, NULL },
   { "client_cache_remove", test_client_cache_remove, TT_FORK,
     NULL, NULL },
+  { "hsdir_post_metrics", test_hsdir_post_metrics, TT_FORK,
+    NULL, NULL },
 
   END_OF_TESTCASES
 };
