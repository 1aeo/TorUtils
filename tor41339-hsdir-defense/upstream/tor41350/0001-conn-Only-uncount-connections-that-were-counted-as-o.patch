diff --git a/src/feature/relay/ext_orport.c b/src/feature/relay/ext_orport.c
index 76cd9bdea6..bbdac476f5 100644
--- a/src/feature/relay/ext_orport.c
+++ b/src/feature/relay/ext_orport.c
@@ -27,6 +27,7 @@
 #include "feature/relay/ext_orport.h"
 #include "core/mainloop/mainloop.h"
 #include "core/proto/proto_ext_or.h"
+#include "feature/stats/rephist.h"
 
 #include "core/or/or_connection_st.h"
 
@@ -88,6 +89,13 @@ connection_ext_or_transition(or_connection_t *conn)
 {
   tor_assert(conn->base_.type == CONN_TYPE_EXT_OR);
 
+  /* This is now an OR connection: move it to the OR connection stats. */
+  if (conn->base_.opened_in_rephist) {
+    rep_hist_note_conn_closed(conn->base_.from_listener, CONN_TYPE_EXT_OR,
+                              conn->base_.socket_family);
+    rep_hist_note_conn_opened(conn->base_.from_listener, CONN_TYPE_OR,
+                              conn->base_.socket_family);
+  }
   conn->base_.type = CONN_TYPE_OR;
   TO_CONN(conn)->state = 0; // set the state to a neutral value
   connection_or_event_status(conn, OR_CONN_EVENT_NEW, 0);
diff --git a/src/test/test_connection.c b/src/test/test_connection.c
index ed94fe8aaa..fae19de7a5 100644
--- a/src/test/test_connection.c
+++ b/src/test/test_connection.c
@@ -21,6 +21,8 @@
 #include "feature/nodelist/networkstatus.h"
 #include "feature/dircommon/directory.h"
 #include "core/or/connection_or.h"
+#include "core/or/status.h"
+#include "feature/stats/rephist.h"
 #include "lib/net/resolve.h"
 #include "lib/evloop/compat_libevent.h"
 
@@ -29,6 +31,7 @@
 
 #include "feature/dircommon/dir_connection_st.h"
 #include "core/or/entry_connection_st.h"
+#include "core/or/listener_connection_st.h"
 #include "feature/nodelist/node_st.h"
 #include "core/or/or_connection_st.h"
 #include "feature/nodelist/routerinfo_st.h"
@@ -976,6 +979,104 @@ test_conn_describe(void *arg)
   connection_free_minimal(conn);
 }
 
+static void
+mock_connection_start_reading(connection_t *conn)
+{
+  (void) conn;
+}
+
+static int
+mock_connection_tls_start_handshake_fail(or_connection_t *conn, int receiving)
+{
+  (void) receiving;
+  /* A state for which assert_connection_ok() doesn't require a TLS object. */
+  TO_CONN(conn)->state = OR_CONN_STATE_CONNECTING;
+  return -1;
+}
+
+/** Make sure that the opened connections counted in rephist are only
+ * decremented, once, for connections that were counted as opened. */
+static void
+test_conn_opened_counter(void *arg)
+{
+  listener_connection_t *listener = NULL;
+  connection_t *or_conn = NULL, *closed_or_conn = NULL, *failed_or_conn = NULL;
+  connection_t *exit_conn = NULL, *uncounted_exit_conn = NULL;
+  (void) arg;
+
+  MOCK(connection_start_reading, mock_connection_start_reading);
+  MOCK(connection_tls_start_handshake,
+       mock_connection_tls_start_handshake_fail);
+  tor_init_connection_lists();
+
+  listener = listener_connection_new(CONN_TYPE_OR_LISTENER, AF_INET);
+  TO_CONN(listener)->state = LISTENER_STATE_READY;
+  tt_u64_op(rep_hist_get_conn_opened(false, CONN_TYPE_OR_LISTENER, AF_INET),
+            OP_EQ, 1);
+
+  /* Two accepted OR connections, counted by note_connection(). */
+  or_conn = connection_new(CONN_TYPE_OR, AF_INET);
+  or_conn->from_listener = 1;
+  note_connection(true, or_conn);
+  closed_or_conn = connection_new(CONN_TYPE_OR, AF_INET);
+  closed_or_conn->from_listener = 1;
+  closed_or_conn->state = OR_CONN_STATE_CONNECTING;
+  closed_or_conn->address = tor_strdup("127.0.0.1");
+  note_connection(true, closed_or_conn);
+  tt_u64_op(rep_hist_get_conn_opened(true, CONN_TYPE_OR, AF_INET), OP_EQ, 2);
+
+  /* An accepted OR connection whose TLS handshake fails right away is closed
+   * before note_connection(): it must not decrement the counter. */
+  failed_or_conn = connection_new(CONN_TYPE_OR, AF_INET);
+  failed_or_conn->from_listener = 1;
+  failed_or_conn->address = tor_strdup("127.0.0.1");
+  tt_int_op(connection_init_accepted_conn(failed_or_conn, listener),
+            OP_LT, 0);
+  tt_assert(failed_or_conn->marked_for_close);
+  tt_u64_op(rep_hist_get_conn_opened(true, CONN_TYPE_OR, AF_INET), OP_EQ, 2);
+
+  /* A counted connection is decremented once when marked for close, not
+   * again when freed. */
+  connection_mark_for_close_internal(closed_or_conn);
+  tt_u64_op(rep_hist_get_conn_opened(true, CONN_TYPE_OR, AF_INET), OP_EQ, 1);
+  connection_free_minimal(closed_or_conn);
+  closed_or_conn = NULL;
+  tt_u64_op(rep_hist_get_conn_opened(true, CONN_TYPE_OR, AF_INET), OP_EQ, 1);
+
+  /* An outbound exit connection, counted when connecting... */
+  exit_conn = connection_new(CONN_TYPE_EXIT, AF_INET);
+  exit_conn->state = EXIT_CONN_STATE_CONNECTING;
+  exit_conn->purpose = EXIT_PURPOSE_CONNECT;
+  note_connection(false, exit_conn);
+  /* ...and one without a socket, like the one of a BEGIN_DIR stream or one
+   * that is still resolving, which is never counted: closing it is a no-op.
+   */
+  uncounted_exit_conn = connection_new(CONN_TYPE_EXIT, AF_INET);
+  uncounted_exit_conn->state = EXIT_CONN_STATE_OPEN;
+  uncounted_exit_conn->purpose = EXIT_PURPOSE_CONNECT;
+  connection_mark_for_close(uncounted_exit_conn);
+  tt_u64_op(rep_hist_get_conn_opened(false, CONN_TYPE_EXIT, AF_INET),
+            OP_EQ, 1);
+
+  connection_mark_for_close(TO_CONN(listener));
+  tt_u64_op(rep_hist_get_conn_opened(false, CONN_TYPE_OR_LISTENER, AF_INET),
+            OP_EQ, 0);
+
+  /* The created counters are untouched. */
+  tt_u64_op(rep_hist_get_conn_created(true, CONN_TYPE_OR, AF_INET), OP_EQ, 2);
+
+ done:
+  UNMOCK(connection_start_reading);
+  UNMOCK(connection_tls_start_handshake);
+  if (listener)
+    connection_free_minimal(TO_CONN(listener));
+  connection_free_minimal(or_conn);
+  connection_free_minimal(closed_or_conn);
+  connection_free_minimal(failed_or_conn);
+  connection_free_minimal(exit_conn);
+  connection_free_minimal(uncounted_exit_conn);
+}
+
 #ifndef COCCI
 #define CONNECTION_TESTCASE(name, fork, setup)                           \
   { #name, test_conn_##name, fork, &setup, NULL }
@@ -1010,5 +1111,7 @@ struct testcase_t connection_tests[] = {
   //CONNECTION_TESTCASE(func_suffix, TT_FORK, setup_func_pair),
   { "failed_orconn_tracker", test_failed_orconn_tracker, TT_FORK, NULL, NULL },
   { "describe", test_conn_describe, TT_FORK, NULL, NULL },
+  { "opened_counter", test_conn_opened_counter, TT_FORK,
+    &helper_pubsub_setup, NULL },
   END_OF_TESTCASES
 };
