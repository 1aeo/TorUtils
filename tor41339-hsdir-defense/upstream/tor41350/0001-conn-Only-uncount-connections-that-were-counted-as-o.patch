diff --git a/changes/bug41350 b/changes/bug41350
new file mode 100644
index 0000000000..3a29ca2ce5
--- /dev/null
+++ b/changes/bug41350
@@ -0,0 +1,9 @@
+  o Minor bugfixes (relay, metrics):
+    - Only decrement the MetricsPort tor_relay_connections{state="opened"}
+      gauge for connections that were counted as opened. Previously, every
+      connection closed without having been counted, such as an accepted
+      OR connection whose TLS handshake failed right away or the linked
+      connections of a BEGIN_DIR stream, pulled the gauge down towards 0.
+      Extended ORPort connections now move from the "Extended OR" to the
+      "OR" gauge, and are counted as created OR connections, when they
+      become OR connections. Fixes bug 41350; bugfix on 0.4.7.11.
diff --git a/src/core/mainloop/connection.c b/src/core/mainloop/connection.c
index cd71bb8c3a..547220b269 100644
--- a/src/core/mainloop/connection.c
+++ b/src/core/mainloop/connection.c
@@ -651,6 +651,7 @@ listener_connection_new(int type, int socket_family)
   connection_init(time(NULL), TO_CONN(listener_conn), type, socket_family);
   /* Listener connections aren't accounted for with note_connection() so do
    * this explicitly so to count them. */
+  TO_CONN(listener_conn)->opened_in_rephist = 1;
   rep_hist_note_conn_opened(false, type, socket_family);
   return listener_conn;
 }
@@ -1176,9 +1177,12 @@ connection_mark_for_close_internal_, (connection_t *conn,
    * we get our whole 15 seconds */
   conn->timestamp_last_write_allowed = time(NULL);
 
-  /* Note the connection close. */
-  rep_hist_note_conn_closed(conn->from_listener, conn->type,
-                            conn->socket_family);
+  /* Note the connection close, if it was counted as opened. */
+  if (conn->opened_in_rephist) {
+    conn->opened_in_rephist = 0;
+    rep_hist_note_conn_closed(conn->from_listener, conn->type,
+                              conn->socket_family);
+  }
 }
 
 /** Find each connection that has hold_open_until_flushed set to
diff --git a/src/core/or/connection_st.h b/src/core/or/connection_st.h
index 87ab6af8d9..8603c219fb 100644
--- a/src/core/or/connection_st.h
+++ b/src/core/or/connection_st.h
@@ -34,7 +34,8 @@ struct buf_t;
  * other end.
  *
  * Every connection has a type and a state.  Connections never change
- * their type, but can go through many state changes in their lifetime.
+ * their type (except Extended ORPort connections, which become OR
+ * connections), but can go through many state changes in their lifetime.
  *
  * Every connection has two associated input and output buffers.
  * Listeners don't use them.  For non-listener connections, incoming
@@ -91,6 +92,9 @@ struct connection_t {
    * received this connection. Else, it means we've initiated an outbound
    * connection. */
   unsigned int from_listener:1;
+  /** True iff this connection has been counted by rep_hist_note_conn_opened()
+   * and not yet by rep_hist_note_conn_closed(). */
+  unsigned int opened_in_rephist:1;
 
   /** CONNECT/SOCKS proxy client handshake state (for outgoing connections). */
   unsigned int proxy_state:4;
diff --git a/src/core/or/status.c b/src/core/or/status.c
index d44942e278..b724bdaab0 100644
--- a/src/core/or/status.c
+++ b/src/core/or/status.c
@@ -132,7 +132,7 @@ static unsigned n_outgoing_ipv6;
  * heartbeat message.
  **/
 void
-note_connection(bool inbound, const connection_t *conn)
+note_connection(bool inbound, connection_t *conn)
 {
   if (conn->socket_family == AF_INET) {
     if (inbound) {
@@ -148,6 +148,7 @@ note_connection(bool inbound, const connection_t *conn)
     }
   }
 
