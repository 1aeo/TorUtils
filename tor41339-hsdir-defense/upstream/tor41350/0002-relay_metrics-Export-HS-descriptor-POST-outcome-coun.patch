index 8c7baab..8b71723 100644
--- a/src/feature/stats/rephist.h
+++ b/src/feature/stats/rephist.h
@@ -86,6 +86,26 @@ void rep_hist_seen_new_rp_cell(bool is_v2);
 char *rep_hist_get_hs_v3_stats_string(void);
 void rep_hist_hsdir_stored_maybe_new_v3_onion(const uint8_t *blinded_key);
 
+/** Outcomes for an onion service descriptor POST request on an HSDir. */
+typedef enum hsdir_post_outcome_t {
+  /** Stored in the HSDir cache (HTTP 200). */
+  HSDIR_POST_OK = 0,
+  /** Rejected because the cached descriptor has a >= revision counter
+   * (HTTP 400; legitimate on re-upload, duplicate service instance, or
+   * Onionbalance failover). */
+  HSDIR_POST_REJECTED_REV_COUNTER = 1,
+  /** Rejected because the POST URL, version, or command path is invalid
+   * (HTTP 400). */
+  HSDIR_POST_REJECTED_BAD_URL = 2,
+  /** Rejected because the descriptor body failed size, format, certificate,
+   * or signature validation (HTTP 400). */
+  HSDIR_POST_REJECTED_INVALID_DESC = 3,
+  HSDIR_POST_OUTCOME_MAX_ = 4,
+} hsdir_post_outcome_t;
+
+void rep_hist_note_hsdir_post(hsdir_post_outcome_t outcome);
+uint64_t rep_hist_get_hsdir_post(hsdir_post_outcome_t outcome);
+
