--- a/src/feature/stats/rephist.c
+++ b/src/feature/stats/rephist.c
@@ -1805,6 +1805,26 @@ rep_hist_get_conn_rejected(unsigned int type, int af)
   }
 }
 
+/** Counters for onion service descriptor POST outcomes on an HSDir. */
+static uint64_t hsdir_post_outcomes[HSDIR_POST_OUTCOME_MAX_];
+
+/** Note an onion service descriptor POST outcome on an HSDir. */
+void
+rep_hist_note_hsdir_post(hsdir_post_outcome_t outcome)
+{
+  tor_assert(outcome < HSDIR_POST_OUTCOME_MAX_);
+  hsdir_post_outcomes[outcome]++;
+}
+
+/** Return the count of onion service descriptor POST requests with the given
+ * outcome. */
+uint64_t
+rep_hist_get_hsdir_post(hsdir_post_outcome_t outcome)
+{
+  tor_assert(outcome < HSDIR_POST_OUTCOME_MAX_);
+  return hsdir_post_outcomes[outcome];
+}
+
 /*** cell statistics ***/
 
