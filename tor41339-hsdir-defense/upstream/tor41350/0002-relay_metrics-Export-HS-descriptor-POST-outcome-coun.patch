+static void
+test_hsdir_post_outcomes(void *arg)
+{
+  int ret;
+  ed25519_keypair_t signing_kp;
+  hs_descriptor_t *desc1 = NULL, *desc2 = NULL;
+  char *desc1_str = NULL, *desc2_str = NULL;
+
+  (void)arg;
+
+  init_test();
+
+  ret = ed25519_keypair_generate(&signing_kp, 0);
+  tt_int_op(ret, OP_EQ, 0);
+  desc1 = hs_helper_build_hs_desc_with_rev_counter(&signing_kp, 10);
+  tt_assert(desc1);
+  ret = hs_desc_encode_descriptor(desc1, &signing_kp, NULL, &desc1_str);
+  tt_int_op(ret, OP_EQ, 0);
+
+  desc2 = hs_helper_build_hs_desc_with_rev_counter(&signing_kp, 11);
+  tt_assert(desc2);
+  ret = hs_desc_encode_descriptor(desc2, &signing_kp, NULL, &desc2_str);
+  tt_int_op(ret, OP_EQ, 0);
+
+  /* 1. Initial valid publish -> 200 (ok). */
+  tt_int_op(handle_post_hs_descriptor("/tor/hs/3/publish", desc1_str),
+            OP_EQ, 200);
+  tt_u64_op(rep_hist_get_hsdir_post(HSDIR_POST_OK), OP_EQ, 1);
+
+  /* 2. Re-upload with equal revision counter -> 400 (rev_counter). */
+  tt_int_op(handle_post_hs_descriptor("/tor/hs/3/publish", desc1_str),
+            OP_EQ, 400);
+  tt_u64_op(rep_hist_get_hsdir_post(HSDIR_POST_REJECTED_REV_COUNTER),
+            OP_EQ, 1);
+
+  /* 3. Upload with newer revision counter -> 200 (ok). */
+  tt_int_op(handle_post_hs_descriptor("/tor/hs/3/publish", desc2_str),
+            OP_EQ, 200);
+  tt_u64_op(rep_hist_get_hsdir_post(HSDIR_POST_OK), OP_EQ, 2);
+
+  /* 4. Upload with older revision counter -> 400 (rev_counter). */
+  tt_int_op(handle_post_hs_descriptor("/tor/hs/3/publish", desc1_str),
+            OP_EQ, 400);
+  tt_u64_op(rep_hist_get_hsdir_post(HSDIR_POST_REJECTED_REV_COUNTER),
+            OP_EQ, 2);
+
+  /* 5. Bad URL version / path -> 400 (bad_url). */
+  tt_int_op(handle_post_hs_descriptor("/tor/hs/bad/publish", desc2_str),
+            OP_EQ, 400);
+  tt_int_op(handle_post_hs_descriptor("/tor/hs/3/notpublish", desc2_str),
+            OP_EQ, 400);
+  tt_int_op(handle_post_hs_descriptor("/tor/hs/2/publish", desc2_str),
+            OP_EQ, 400);
+  tt_u64_op(rep_hist_get_hsdir_post(HSDIR_POST_REJECTED_BAD_URL),
+            OP_EQ, 3);
+
+  /* 6. Unparseable descriptor body -> 400 (invalid_desc). */
+  tt_int_op(handle_post_hs_descriptor("/tor/hs/3/publish",
+                                      "hs-descriptor 3\nJUNK"),
+            OP_EQ, 400);
+  tt_u64_op(rep_hist_get_hsdir_post(HSDIR_POST_REJECTED_INVALID_DESC),
+            OP_EQ, 1);
+
+ done:
+  hs_descriptor_free(desc1);
+  hs_descriptor_free(desc2);
+  tor_free(desc1_str);
+  tor_free(desc2_str);
+  hs_free_all();
+}
