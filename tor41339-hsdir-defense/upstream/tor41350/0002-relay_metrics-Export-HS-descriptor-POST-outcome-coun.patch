+/** Fill the metrics store for the RELAY_METRICS_NUM_HSDIR_POST counter. */
+static void
+fill_hsdir_post_values(void)
+{
+  const relay_metrics_entry_t *rentry =
+    &base_metrics[RELAY_METRICS_NUM_HSDIR_POST];
+  static const struct {
+    const char *status;
+    const char *reason;
+    hsdir_post_outcome_t outcome;
+  } items[] = {
+    { "200", "ok",           HSDIR_POST_OK },
+    { "400", "rev_counter",  HSDIR_POST_REJECTED_REV_COUNTER },
+    { "400", "bad_url",      HSDIR_POST_REJECTED_BAD_URL },
+    { "400", "invalid_desc", HSDIR_POST_REJECTED_INVALID_DESC },
+  };
+
+  for (size_t i = 0; i < ARRAY_LENGTH(items); i++) {
+    metrics_store_entry_t *sentry = metrics_store_add(
+        the_store, rentry->type, rentry->name, rentry->help, 0, NULL);
+    metrics_store_entry_add_label(
+        sentry, metrics_format_label("status", items[i].status));
+    metrics_store_entry_add_label(
+        sentry, metrics_format_label("reason", items[i].reason));
+    metrics_store_entry_update(sentry,
+                               rep_hist_get_hsdir_post(items[i].outcome));
+  }
+}
